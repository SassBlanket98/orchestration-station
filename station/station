"""Control center: the detail pane for the selected row. Pure renderers: row data in, fitted lines out. Imports model,
widgets and the ops* helpers only."""



PANE_TABS = ("Overview", "Prompt", "Tools", "Files", "Events", "Metrics")
PANE_TAB_ARROWS = ("left", "right")          # cycle tabs when the pane has focus (see cckeys)
_PANE_TAB_SHORT = {"Tools": "Tools", "Files": "Files"}   # [:4] drops the plural on these two only

_CX_LABEL_CAP = 14          # label column cap per tab (same idea as ccstrip._CX_LABEL_W)
_CX_SPARK_MAX = 60          # most sparkline cells
_CX_TOOL_W_MAX = 10         # tool column cap in the Tools table
_CX_TOOL_W_MIN = 6
_CX_EVENT_HEAD = 18         # `HH:MM:SS kind     ` before the event text

# tool name -> category (TOOL_CATS); the log already groups by category, calls need this
_CX_TOOL_CAT = {
    "read": "read", "cat": "read", "view": "read", "open": "read",
    "edit": "edit", "write": "edit", "apply_patch": "edit", "patch": "edit",
    "multiedit": "edit", "notebookedit": "edit",
    "bash": "shell", "shell": "shell", "exec": "shell", "terminal": "shell", "run": "shell",
    "grep": "search", "glob": "search", "search": "search", "find": "search",
}
_CX_FILE_TOOLS = ("edit", "write", "apply_patch", "patch", "read", "notebookedit", "multiedit")
_CX_PATH_RE = re.compile(r"[A-Za-z0-9_.~/\-]+")
_CX_EXT_RE = re.compile(r"\.[A-Za-z][A-Za-z0-9]{0,5}$")


def pane_tab_digit(key: str) -> str | None:
    """Map `1`..`len(PANE_TABS)` to a tab name; None when the key is not a pane tab digit."""
    if len(key) == 1 and key.isdigit():
        index = int(key) - 1
        if 0 <= index < len(PANE_TABS):
            return PANE_TABS[index]
    return None


def _cpn_tab_label(name: str, short: bool) -> str:
    if short:
        return _PANE_TAB_SHORT.get(name, name[:4])
    return name


@dataclass
class _cpn_Row:
    """The union of the lead and worker fields the tabs draw, so each tab branches once, in _cpn_row."""
    name: str = ""
    tag: str = ""
    harness: str = ""
    model: str = ""             # display label, e.g. "opus-5.5 · hi"
    state: str = ""
    goal: str = ""
    outcome: str = ""
    lead: bool = False
    brief: list[str] = field(default_factory=list)
    prompt: list[str] = field(default_factory=list)
    system_prompt: list[str] = field(default_factory=list)
    calls: list[CCCall] = field(default_factory=list)
    steps: list[Step] = field(default_factory=list)
    tool_counts: dict[str, int] = field(default_factory=dict)
    tokens_in: int | None = None
    tokens_out: int | None = None
    tokens_cache: int | None = None
    tokens_total: int | None = None
    ctx: int | None = None
    ctx_window: int | None = None
    ctx_limit: int | None = None
    cost: float | None = None
    elapsed: str = ""
    cpu: float | None = None
    rss: int | None = None
    pid: int | None = None
    errors: int = 0
    result: list[str] = field(default_factory=list)
    failure: str = ""
    flags: frozenset[str] = frozenset()
    pulses: list[tuple[float, int]] = field(default_factory=list)
    tool_pulses: list[tuple[float, int]] = field(default_factory=list)
    doing: list[tuple[float, str]] = field(default_factory=list)
    work: WorkState | None = None


def _cpn_worker_harness(worker: Worker) -> str:
    """The short harness label from the ops grid, falling back to the control center's `harness` field."""
    label = _og_worker_harness(worker)
    if label != "—":
        return label
    mapping = {"claude": "CC", "codex": "Codex", "opencode": "OCode", "cursor": "Cursr", "openclaw": "OClaw"}
    return mapping.get((worker.harness or "").lower(), worker.harness)


def _cpn_row(stage: Stage, worker: Worker | None, now: float) -> _cpn_Row:
    """Flatten the selected row (worker or the lead session) into the fields the tabs use."""
    if worker is None:
        cells = _og_stage_cells(stage, now)
        name = stage.display_name or stage.session_name or stage.label or stage.session_id[:8]
        return _cpn_Row(
            name=name, tag=stage.level_tag or ("LEAD" if not stage.parent else "SPAWN"),
            harness=_og_stage_harness(stage), model=cells.model, state=stage.state or stage.lead_state,
            goal=stage.goal, outcome=stage.outcome, lead=True,
            brief=list(stage.brief_text), prompt=list(stage.prompt), system_prompt=list(stage.system_prompt),
            calls=list(stage.calls), tokens_total=stage.lead_tokens, ctx=stage.lead_ctx,
            ctx_window=stage.lead_ctx_window, ctx_limit=cells.ctx_limit, cost=stage.lead_cost, elapsed=cells.elapsed,
            pulses=[], tool_pulses=list(stage.lead_tool_pulses), doing=list(stage.doing), work=stage.work,
        )
    log = worker.log
    cells = _og_worker_cells(worker, now)
    tokens_total = _og_tokens(log.tokens_in, log.tokens_out)
    return _cpn_Row(
        name=worker.name, tag=worker.level_tag or "WORKER", harness=_cpn_worker_harness(worker),
        model=cells.model, state=worker.state, goal=worker.goal, lead=False,
        brief=list(worker.brief_text), prompt=list(worker.prompt), system_prompt=list(worker.system_prompt),
        calls=list(worker.calls), steps=list(log.steps), tool_counts=dict(log.tool_counts),
        tokens_in=log.tokens_in, tokens_out=log.tokens_out, tokens_cache=log.tokens_cache,
        tokens_total=tokens_total, ctx=log.ctx_tokens, ctx_window=log.ctx_window, ctx_limit=cells.ctx_limit, cost=log.cost,
        elapsed=cells.elapsed, cpu=worker.cpu, rss=worker.rss, pid=worker.pid, errors=log.errors,
        result=list(worker.result_text) or list(worker.summary), failure=worker.failure, flags=worker.flags,
        pulses=list(log.pulses), tool_pulses=list(log.tool_pulses), work=stage.work,
    )


# --- small shared pieces -------------------------------------------------------------------------
def _cpn_unknown() -> str:
    return _wd_c("—", _wd_C_FAINT)


def _cpn_head(text: str) -> str:
    return _wd_c(text, _wd_C_DIM, bold=True)


def _cpn_nodata(cols: int, indent: bool = False, text: str = "no data") -> str:
    return _wd_fit(_wd_c(("  " if indent else "") + text, _wd_C_FAINT), cols)


def _cpn_empty(text: str, cols: int) -> list[str]:
    """One dim sentence centred in the pane, wrapped onto more centred lines only when the pane is narrower than it."""
    out: list[str] = []
    for line in _wd_wrap(text, max(1, cols)):
        pad = max(0, (cols - _wd_width(line)) // 2)
        out.append(_wd_fit(" " * pad + _wd_c(line, _wd_C_FAINT), cols))
    return out


def _cpn_label_width(labels: list[str], cols: int) -> int:
    """Shared label column width for one tab's label/value rows."""
    if cols < 4:
        return max(1, cols - 2)
    longest = max((len(label) for label in labels), default=0)
    return max(1, min(min(longest, _CX_LABEL_CAP), cols - 2))


def _cpn_labeled_plain(label: str, text: str, label_w: int, cols: int,
                       color: tuple[int, int, int] = _wd_C_TEXT, max_lines: int = 0) -> list[str]:
    """Plain-text value lines: MUTED label column, wrapped values start under the value column."""
    value_col = label_w + 1
    room = max(1, cols - value_col)
    plain = _wd_clean(text).strip()
    if not plain:
        return [_wd_fit(_wd_c(label.ljust(label_w), _wd_C_MUTED) + " " + _cpn_unknown(), cols)]
    wrapped = _wd_wrap(plain, room)
    cap = max_lines if max_lines > 0 else len(wrapped)
    out: list[str] = []
    for i, line in enumerate(wrapped[:cap]):
        more = i == cap - 1 and len(wrapped) > cap
        prefix = _wd_c(label.ljust(label_w), _wd_C_MUTED) + " " if i == 0 else " " * value_col
        out.append(_wd_fit(prefix + _wd_c(line + (" …" if more else ""), color), cols))
    return out


def _cpn_labeled_styled(label: str, body: str, label_w: int, cols: int) -> str:
    """One line whose value is already coloured (gauges, token breakdowns, tool counts)."""
    return _wd_fit(_wd_c(label.ljust(label_w), _wd_C_MUTED) + " " + body, cols)


def _cpn_labeled_block(cols: int, rows: list[tuple[str, str, tuple[int, int, int], int]],
                       styled: list[tuple[str, str]] | None = None) -> list[str]:
    """Several label/value rows sharing one label width; `rows` are plain (label, text, colour, max_lines)."""
    labels = [label for label, _text, _color, _cap in rows] + [label for label, _body in (styled or [])]
    label_w = _cpn_label_width(labels, cols)
    out: list[str] = []
    for label, text, color, cap in rows:
        out += _cpn_labeled_plain(label, text, label_w, cols, color, cap)
    for label, body in styled or []:
        out.append(_cpn_labeled_styled(label, body, label_w, cols))
    return out


def _cpn_model_text(model: str) -> str:
    """`model@effort`: the shared cells join the two with ` · `; a label that already carries `@` keeps its own."""
    head, _, tail = model.partition(" · ")
    if not tail:
        return head
    return head if "@" in head else f"{head}@{tail}"


def _cpn_identity(row: _cpn_Row, cols: int) -> str:
    tag = row.tag if row.tag in OT_TAGS else ("LEAD" if row.lead else "WORKER")
    name = _wd_trunc(_wd_clean(row.name) or "—", max(6, cols // 3))
    harn = (_wd_c(row.harness, _og_harn_color(row.harness)) if row.harness else _cpn_unknown())
    model = _wd_c(_cpn_model_text(row.model), _wd_C_MUTED) if row.model else _cpn_unknown()
    return _wd_fit(_ot_tag(tag, cols < 80) + " " + _wd_c(name, _wd_C_TEXT, bold=True)
                   + "  " + harn + "  " + model, cols)


def _cpn_now(row: _cpn_Row) -> str:
    """The newest step or call as one line, "" when the row has neither."""
    cands: list[tuple[float, str]] = []
    if row.calls:
        call = row.calls[-1]
        cands.append((call.ts, f"{call.tool} {call.arg}".strip()))
    if row.steps:
        step = row.steps[-1]
        cands.append((step.ts, f"{step.tool or step.kind} {step.text}".strip()))
    if row.doing:
        stamp, text = row.doing[-1]
        cands.append((stamp, _wd_clean(text)))
    return max(cands, key=lambda item: item[0])[1] if cands else ""


def _cpn_tokens_text(row: _cpn_Row) -> str:
    if row.tokens_in is not None or row.tokens_out is not None or row.tokens_cache is not None:
        parts = []
        for label, value in (("in", row.tokens_in), ("out", row.tokens_out), ("cache", row.tokens_cache)):
            parts.append(f"{label} " + (_wd_fmt_tok(value) if value is not None else "—"))
        return " · ".join(parts)
    if row.tokens_total is not None:
        return _wd_fmt_tok(row.tokens_total)
    return ""


def _cpn_tokens_body(row: _cpn_Row) -> str:
    text = _cpn_tokens_text(row)
    return _wd_c(text, _wd_C_TEXT) if text else _cpn_unknown()


def _cpn_ctx_body(row: _cpn_Row, cols: int) -> str:
    limit = row.ctx_limit or row.ctx_window
    pct = _og_pct(row.ctx, limit)
    if row.ctx is None and limit is None:
        return _cpn_unknown()
    if limit:
        used = _wd_fmt_tok(row.ctx) if row.ctx is not None else "—"
        body = _wd_c(f"{used} of {_wd_fmt_tok(limit)}", _wd_ctx_color(pct))
        if pct is not None:
            width = min(14, max(4, cols - 34))
            body += " " + _wd_gauge_bar(min(pct, 100) / 100, width, _wd_ctx_color(pct))
        return body
    return _wd_c(f"{_wd_fmt_tok(row.ctx)} (window unknown)", _wd_C_TEXT)


def _cpn_cats(row: _cpn_Row) -> dict[str, int]:
    counts = {cat: 0 for cat in TOOL_CATS}
    if row.tool_counts:
        for name, value in row.tool_counts.items():
            counts[name if name in counts else "other"] += int(value or 0)
    elif row.calls:
        for call in row.calls:
            counts[_cpn_cat(call.tool)] += 1
    return counts


def _cpn_cat(tool: str) -> str:
    name = (tool or "").lower()
    if name in _CX_TOOL_CAT:
        return _CX_TOOL_CAT[name]
    for key, cat in _CX_TOOL_CAT.items():
        if key in name:
            return cat
    return "other"


def _cpn_tool_body(row: _cpn_Row) -> str:
    counts = _cpn_cats(row)
    total = sum(counts.values())
    if not total:
        return _cpn_unknown()
    parts = [_wd_c(f"{total} calls", _wd_C_TEXT)]
    for cat in TOOL_CATS:
        if counts.get(cat):
            parts.append(_wd_c(f"{cat} {counts[cat]}", _wd_C_SUB))
    if row.errors:
        parts.append(_wd_c(f"{row.errors} failed", _wd_C_RED))
    return _wd_c("  ·  ", _wd_C_FAINT).join(parts)


def _cpn_result_rows(row: _cpn_Row) -> list[tuple[str, str, tuple[int, int, int], int]]:
    rows: list[tuple[str, str, tuple[int, int, int], int]] = []
    if row.failure:
        rows.append(("FAILED", row.failure, _wd_C_RED, 4))
    if row.result and row.state not in LIVE_STATES:
        rows.append(("RESULT", " ".join(row.result), _wd_C_TEXT, 6))
    if row.lead and row.outcome:
        rows.append(("OUTCOME", _wd_clean(row.outcome), _wd_C_TEXT, 0))
    if row.flags:
        rows.append(("FLAGS", ", ".join(sorted(_wd_clean(flag) for flag in row.flags)), _wd_C_AMBER, 0))
    return rows


def _cpn_overview(row: _cpn_Row, cols: int) -> list[str]:
    out = [_cpn_identity(row, cols)]
    plain: list[tuple[str, str, tuple[int, int, int], int]] = [
        ("GOAL", row.goal, _wd_C_TEXT, 3),
        ("NOW", _cpn_now(row), _wd_C_TEXT, 2),
    ]
    if row.cpu is not None:
        plain.append(("CPU", f"{row.cpu:.0f}%", _wd_C_TEXT, 0))
    if row.rss is not None:
        plain.append(("RSS", _wd_fmt_mem(row.rss), _wd_C_TEXT, 0))
    if row.pid:
        plain.append(("PID", str(row.pid), _wd_C_TEXT, 0))
    plain.append(("COST", _wd_fmt_money(row.cost) if row.cost is not None else "", _wd_C_TEXT, 0))
    elapsed = row.elapsed if row.elapsed and row.elapsed != "—" else ""
    plain.append(("ELAPSED", elapsed, _wd_C_TEXT, 0))
    plain += _cpn_result_rows(row)
    styled = [("TOKENS", _cpn_tokens_body(row)), ("CTX", _cpn_ctx_body(row, cols)),
              ("TOOLS", _cpn_tool_body(row))]
    out += _cpn_labeled_block(cols, plain, styled)
    return out


def _cpn_prompt(row: _cpn_Row, cols: int) -> list[str]:
    if not any(_wd_clean(line).strip() for lines in (row.brief, row.prompt, row.system_prompt) for line in lines):
        return _cpn_empty("no prompt captured: this harness does not expose it", cols)
    out: list[str] = []
    for label, lines in (("BRIEF", row.brief), ("FIRST PROMPT", row.prompt), ("SYSTEM PROMPT", row.system_prompt)):
        out.append(_cpn_head(label))
        text = " ".join(_wd_clean(line) for line in lines).strip()
        if text:
            out += [_wd_fit(_wd_c(line, _wd_C_SUB), cols) for line in _wd_wrap(text, cols)]
        else:
            out.append(_cpn_nodata(cols, indent=True, text="none recorded"))
    return out


def _cpn_tool_calls(row: _cpn_Row) -> list[CCCall]:
    """The row's calls (newest last); a log with only tool steps is adapted to the same shape."""
    if row.calls:
        return list(row.calls)
    return [CCCall(ts=step.ts, tool=step.tool or step.kind, arg=step.text, outcome=step.outcome, dur=step.dur)
            for step in row.steps if step.kind == "tool"]


def _cpn_tool_widths(cols: int) -> tuple[int, int]:
    tool_w = min(_CX_TOOL_W_MAX, max(_CX_TOOL_W_MIN, cols // 5))
    return tool_w, max(4, cols - (22 + tool_w))   # time, spaces, tool, result, duration


def _cpn_tool_head(cols: int) -> str:
    tool_w, arg_w = _cpn_tool_widths(cols)
    return _wd_fit(_wd_c(f"{'TIME':<8} {'TOOL':<{tool_w}} {'ARG':<{arg_w}} {'RES':<4} {'DUR':>6}", _wd_C_DIM), cols)


def _cpn_tool_row(call: CCCall, cols: int) -> str:
    tool_w, arg_w = _cpn_tool_widths(cols)
    clock = _os_clock(call.ts)
    tool = _wd_trunc(_wd_clean(call.tool) or "—", tool_w)
    arg = _wd_trunc(_wd_clean(call.arg), arg_w)
    failed = call.outcome == "failed"
    result = "FAIL" if failed else "ok" if call.outcome == "ok" else "…"
    dur = _os_dur(call.dur)
    if failed:   # the whole failed row is red, so the FAIL columns read at a glance
        plain = f"{clock} {tool:<{tool_w}} {arg:<{arg_w}} {result:<4} {dur:>6}"
        return _wd_fit(_wd_c(plain, _wd_C_RED), cols)
    res_color = _wd_C_GREEN if call.outcome == "ok" else _wd_C_FAINT
    line = (_wd_c(clock, _wd_C_FAINT) + " " + _wd_c(_wd_pad(tool, tool_w), _wd_C_BLUE) + " "
            + _wd_c(_wd_pad(arg, arg_w), _wd_C_SUB) + " " + _wd_c(_wd_pad(result, 4), res_color) + " "
            + _wd_c(dur.rjust(6), _wd_C_MUTED))
    return _wd_fit(line, cols)


def _cpn_tools(row: _cpn_Row, cols: int) -> list[str]:
    calls = _cpn_tool_calls(row)
    if not calls:
        return _cpn_empty("no tool calls recorded yet", cols)
    out = [_cpn_tool_head(cols)]
    for call in calls:
        out.append(_cpn_tool_row(call, cols))
        if call.err:
            out.append(_wd_fit(_wd_c("  ↳ " + _wd_trunc(_wd_clean(call.err), max(1, cols - 4)), _wd_C_RED), cols))
    return out


def _cpn_path(text: str) -> str:
    """The first path-looking token in a call's argument (a token with `/`, else one with a file extension)."""
    fallback = ""
    for token in _CX_PATH_RE.findall(text or ""):
        if len(token) < 3 or token.startswith(("//", "www.")) or token in ("...",):
            continue
        if "/" in token:
            return token
        if not fallback and _CX_EXT_RE.search(token):
            fallback = token
    return fallback


def _cpn_files(row: _cpn_Row, cols: int) -> list[str]:
    counts: dict[str, list] = {}
    for call in _cpn_tool_calls(row):
        if not any(key in (call.tool or "").lower() for key in _CX_FILE_TOOLS):
            continue
        path = _cpn_path(call.arg)
        if not path:
            continue
        rec = counts.setdefault(path, [0, 0.0])
        rec[0] += 1
        rec[1] = max(rec[1], call.ts)
    ordered = sorted(counts.items(), key=lambda item: (-item[1][1], item[0]))
    if not ordered and row.work is None:
        return _cpn_empty("no file reads or edits recorded yet", cols)
    out = [_cpn_head(f"FILES {len(ordered)}" if ordered else "FILES")]
    if not ordered:
        out.append(_cpn_nodata(cols, indent=True, text="no file reads or edits yet"))
    for path, (hits, stamp) in ordered:
        tail = f"×{hits}  {_os_clock(stamp)}"
        room = max(6, cols - _wd_width(tail) - 2)
        out.append(_wd_fit(_wd_c(_wd_trunc(path, room), _wd_C_TEXT) + "  " + _wd_c(tail, _wd_C_FAINT), cols))
    out += _cpn_git(row.work, cols)
    return out


def _cpn_git(work: WorkState | None, cols: int) -> list[str]:
    out = [_cpn_head("GIT")]
    if work is None:
        out.append(_cpn_nodata(cols, indent=True))
        return out
    bits: list[str] = []
    if work.dirty:
        bits.append(_wd_c("uncommitted", _wd_C_AMBER))
    elif work.dirty is False:
        bits.append(_wd_c("clean", _wd_C_GREEN))
    if work.ahead:
        bits.append(_wd_c(f"{work.ahead} unpushed", _wd_C_AMBER))
    if work.unmerged:
        bits.append(_wd_c("unmerged", _wd_C_BLUE))
    elif work.unmerged is False and work.branch and work.dirty is False:
        bits.append(_wd_c("merged", _wd_C_GREEN))
    state = _wd_c("  ·  ", _wd_C_FAINT).join(bits) if bits else _cpn_unknown()
    plain: list[tuple[str, str, tuple[int, int, int], int]] = [
        ("branch", _wd_clean(work.branch) or "—", _wd_C_TEXT, 0),
    ]
    styled = [("state", state)]
    if work.checked:
        plain.append(("checked", _os_clock(work.checked), _wd_C_TEXT, 0))
    out += _cpn_labeled_block(cols, plain, styled)
    return out


def _cpn_event_line(ts: float, kind: str, text: str, cols: int, failed: bool = False) -> str:
    clock = _os_clock(ts)
    kind_text = _wd_trunc(_wd_clean(kind) or "—", 8)
    body = _wd_trunc(_wd_clean(text), max(1, cols - _CX_EVENT_HEAD - 1))
    if failed:
        return _wd_fit(_wd_c(f"{clock} {kind_text:<8} {body}", _wd_C_RED), cols)
    kind_color = _wd_C_RED if kind_text in ("err", "error") else _wd_C_MUTED if kind_text in ("msg", "text") else _wd_C_BLUE
    return _wd_fit(_wd_c(clock, _wd_C_FAINT) + " " + _wd_c(_wd_pad(kind_text, 8), kind_color) + " "
                   + _wd_c(body, _wd_C_SUB), cols)


def _cpn_events(row: _cpn_Row, cols: int) -> list[str]:
    if row.steps:   # steps carry the text/error events the raw calls do not
        out: list[str] = []
        for step in row.steps:
            kind = "err" if step.kind == "error" else "tool" if step.kind == "tool" else "msg"
            text = f"{step.tool} {step.text}".strip() if step.kind == "tool" else step.text
            out.append(_cpn_event_line(step.ts, kind, text, cols, step.outcome == "failed"))
        return out
    calls = _cpn_tool_calls(row)
    if calls:
        return [_cpn_event_line(call.ts, "tool", f"{call.tool} {call.arg}".strip(), cols,
                               call.outcome == "failed") for call in calls]
    if row.doing:
        return [_cpn_event_line(stamp, "msg", text, cols) for stamp, text in row.doing]
    return _cpn_empty("no events logged yet for this row", cols)


def _cpn_meter_body(label: str, pulses: list[tuple[float, int]], now: float, cols: int) -> str:
    cells = min(_CX_SPARK_MAX, max(0, cols - 20))
    if not pulses or cells <= 0:
        return _wd_c("no data", _wd_C_FAINT)
    bins = _os_bins(pulses, now, cells, OS_SPAN_S)
    return _os_spark(bins, cells) + _wd_c("  30m", _wd_C_FAINT)


def _cpn_metrics(row: _cpn_Row, cols: int, now: float) -> list[str]:
    if not (row.pulses or row.tool_pulses or _cpn_tokens_text(row) or row.ctx is not None
            or row.ctx_window is not None or row.ctx_limit is not None):
        return _cpn_empty("no metrics yet: no token, context or event counts recorded", cols)
    labels = ["TOOLS/MIN", "EVENTS/MIN", "CTX", "TOKENS"]
    label_w = _cpn_label_width(labels, cols)
    return [
        _cpn_labeled_styled("TOOLS/MIN", _cpn_meter_body("TOOLS/MIN", row.tool_pulses, now, cols), label_w, cols),
        _cpn_labeled_styled("EVENTS/MIN", _cpn_meter_body("EVENTS/MIN", row.pulses, now, cols), label_w, cols),
        _cpn_labeled_styled("CTX", _cpn_ctx_body(row, cols), label_w, cols),
        _cpn_labeled_styled("TOKENS", _cpn_tokens_body(row), label_w, cols),
    ]


def _cpn_fill(stage: Stage, worker: Worker | None, cols: int, room: int) -> list[str]:
    """Overview's dim "Recent activity" block: a blank line, a head and the row's last 6 events, newest last.
    Empty unless the whole block fits in `room` lines."""
    events = row_events(stage, worker)[-6:]
    if not events or len(events) + 2 > room:
        return []
    out = [_wd_fit("", cols), _cpn_head("Recent activity")]
    for event in events:
        out.append(_cpn_event_line(event.ts, event.kind, event.text, cols, event.kind == "err"))
    return out


def _cpn_content(stage: Stage, worker: Worker | None, tab: str, cols: int, now: float,
                 height: int = 0) -> list[str]:
    row = _cpn_row(stage, worker, now)
    tab = tab if tab in PANE_TABS else PANE_TABS[0]
    if tab == "Prompt":
        return _cpn_prompt(row, cols)
    if tab == "Tools":
        return _cpn_tools(row, cols)
    if tab == "Files":
        return _cpn_files(row, cols)
    if tab == "Events":
        return _cpn_events(row, cols)
    if tab == "Metrics":
        return _cpn_metrics(row, cols, now)
    out = _cpn_overview(row, cols)
    return out + _cpn_fill(stage, worker, cols, height - len(out))


def pane_tab_bar(tab: str, width: int) -> tuple[str, list[tuple[int, int, str]]]:
    """The tab bar line, exactly `width` cells, and the click spans [(col0, col1, tab name)] (0-based, inclusive)
    relative to the line's start."""
    width = max(0, width)
    active = tab if tab in PANE_TABS else ""
    best_line = ""
    best_spans: list[tuple[int, int, str]] = []
    for short, marker in ((False, True), (False, False), (True, False)):
        parts: list[str] = []
        spans: list[tuple[int, int, str]] = []
        col = 0
        for name in PANE_TABS:
            label = _cpn_tab_label(name, short)
            text = ("▸" if marker and name == active else "") + label
            if parts:
                col += 2
            spans.append((col, col + len(label) - 1, name))
            parts.append(_wd_c(text, _wd_C_TEXT, bold=True) if name == active else _wd_c(text, _wd_C_DIM))
            col += len(text)
        best_line, best_spans = "  ".join(parts), spans
        if col <= width:
            break
    spans = [span for span in best_spans if span[1] < width]
    return _wd_fit(best_line, width), spans


def pane_lines(stage: Stage, worker: Worker | None, tab: str, width: int, height: int, scroll: int = 0,
               now: float = 0.0) -> list[str]:
    """Exactly `height` lines of `width` cells for `tab` of the selected row (worker None = the lead/session row).
    Scrolls down by `scroll` lines, clamped. A row with no data for a tab shows one dim "no data" line, never an error."""
    if height <= 0:
        return []
    if width <= 0:
        return [""] * height
    content = _cpn_content(stage, worker, tab, width, now, height)
    top = min(max(scroll, 0), max(0, len(content) - height))
    window = content[top:top + height]
    window += [""] * (height - len(window))
    return [_wd_fit(line, width) for line in window]


def pane_max_scroll(stage: Stage, worker: Worker | None, tab: str, width: int, height: int) -> int:
    """The largest useful `scroll` for pane_lines with the same arguments."""
    if height <= 0:
        return 0
    if width <= 0:
        return 0
    return max(0, len(_cpn_content(stage, worker, tab, width, 0.0, height)) - height)



# ──────────────────── ccstrip ────────────────────
"""Control center: the bottom strip (Usage, Events, Logs, Metrics). Pure renderers; imports model, events, widgets and ops* only."""


STRIP_TABS = ("Usage", "Events", "Logs", "Metrics")

_CX_MIN_BINS = 30        # the chart reads 1-minute bins over the last 30 minutes
_CX_LABEL_W = 14         # event row label column
_CX_KIND_W = 6           # event kind column (tool, msg, state, err)
_CX_EVENT_HEAD_W = 8 + 2 + _CX_LABEL_W + 2 + _CX_KIND_W + 2   # "HH:MM:SS  label  kind  "
_CX_BAR_W = 8            # quota window bar
_CX_QUOTA_NAME_W = 12


def _cst_pct_color(pct: float) -> _wd_Rgb:
    """Quota percentage colour: green, amber from 75 %, red from 90 %."""
    if pct >= 90.0:
        return _wd_C_RED
    if pct >= 75.0:
        return _wd_C_AMBER
    return _wd_C_GREEN


def _cst_stage_labels(gs: GlobalSnapshot) -> dict[str, str]:
    """Stage path -> the label an event with an empty worker part is shown under."""
    return {st.path: st.label or st.path.rsplit("/", 1)[-1] for st in (gs.stages or [])}


def _cst_event_label(key: str, labels: dict[str, str]) -> str:
    """The row label an event key carries: the worker name, else the stage's label."""
    path, _sep, wname = (key or "").rpartition("|")
    if wname:
        return wname
    return labels.get(path) or path.rsplit("/", 1)[-1]


def _cst_note(text: str, width: int, count: int) -> list[str]:
    """One dim sentence centred on the middle row of `count` rows; the other rows blank. Exactly `width` cells each."""
    rows = [_wd_fit("", width)] * max(0, count)
    if count > 0:
        rows[count // 2] = _wd_fit(_wd_center(_wd_c(_wd_trunc(text, width), _wd_C_DIM), width), width)
    return rows


def _cst_event_line(ev: CCEvent, sel_key: str, labels: dict[str, str], width: int) -> str:
    """`HH:MM:SS  <label>  <kind>  <text>`: the selected row bright, an err event red, the rest dim; exactly `width` cells."""
    err = ev.kind == "err"
    selected = bool(sel_key) and ev.key == sel_key
    name = _wd_pad(_wd_trunc(_cst_event_label(ev.key, labels), _CX_LABEL_W), _CX_LABEL_W)
    label = (_wd_c(name, _wd_C_TEXT, bold=True) if selected      # the selected row reads brighter
             else _wd_c(name, _wd_C_SUB))
    kind = _wd_c(_wd_pad(_wd_trunc(ev.kind, _CX_KIND_W), _CX_KIND_W), _wd_C_RED if err else _wd_C_DIM)
    tone = _wd_C_RED if err else (_wd_C_TEXT if selected else _wd_C_DIM)
    text = _wd_c(_wd_trunc(_wd_clean(ev.text), max(0, width - _CX_EVENT_HEAD_W)), tone)
    head = _wd_c(_wd_pad(_os_clock(ev.ts), 8), _wd_C_FAINT) + "  " + label + "  " + kind + "  "
    return _wd_fit(head + text, width)


def _cst_events(gs: GlobalSnapshot, stage: Stage | None, worker: Worker | None, width: int, count: int,
               scroll: int) -> list[str]:
    """The fleet tail, oldest at the top and newest at the bottom, `scroll` events back from the newest.
    Exactly `count` rows: blank rows sit above the tail; no events is one centred dim note."""
    events = list(fleet_events(gs) or [])
    if not events:
        return _cst_note("no events yet", width, count)
    labels = _cst_stage_labels(gs)
    sel = row_key(stage, worker) if stage is not None else ""
    end = max(0, len(events) - max(0, int(scroll or 0)))
    chunk = events[max(0, end - count):end] if count > 0 else []
    lines = [_cst_event_line(ev, sel, labels, width) for ev in chunk]
    return [_wd_fit("", width)] * max(0, count - len(lines)) + lines


def _cst_log_path(stage: Stage | None, worker: Worker | None) -> str:
    """The file a row's log tail comes from: the worker's log, else the lead's transcript."""
    if worker is not None:
        return worker.log.path
    if stage is not None:
        return stage.transcript_path
    return ""


def _cst_logs(stage: Stage | None, worker: Worker | None, width: int, count: int, scroll: int) -> list[str]:
    """The row's log tail, newest last at the bottom; `scroll` moves back. No row selected, or no file, is one
    centred dim sentence saying what is missing."""
    if count <= 0:
        return []
    if stage is None and worker is None:
        return _cst_note("select a worker to see its log", width, count)
    path = _cst_log_path(stage, worker)
    tail: list[str] = []
    if path:
        try:
            tail = list(log_tail(path) or [])
        except OSError:      # an unreadable file is data we do not have, not a failure
            tail = []
    if not tail:
        return _cst_note("no log file for this session", width, count)
    start = max(0, len(tail) - count - max(0, int(scroll or 0)))
    return [_wd_fit(_wd_clean(line), width) for line in tail[start:start + count]]


def _cst_fleet_pulses(gs: GlobalSnapshot) -> list[tuple[float, int]]:
    """Every worker's and stage lead's tool pulses, for the fleet chart."""
    pulses: list[tuple[float, int]] = []
    for st in gs.stages or []:
        pulses.extend(st.lead_tool_pulses or [])
        for wk in (st.snap.workers if st.snap is not None else []) or []:
            pulses.extend(wk.log.tool_pulses or [])
    return pulses


def _cst_tools_chart(pulses: list[tuple[float, int]], width: int, now: float) -> str:
    """`N tools/min <spark across the width>`: the fleet tools/min over the last 30 minutes, N the axis max.
    A flat zero series is a dim baseline with `idle` at the right."""
    bins = _os_bins(pulses, now, _CX_MIN_BINS, OS_SPAN_S)
    peak = max(bins, default=0)
    idle = peak <= 0
    label = _wd_c(f"{peak} tools/min ", _wd_C_MUTED)
    tail = _wd_c("idle", _wd_C_DIM) if idle else ""
    tw = _wd_width(tail)
    cells = width - _wd_width(label) - (tw + 2 if tail else 0)
    if cells < 4:            # too narrow for the idle word: spend the width on the chart
        tail, tw = "", 0
        cells = width - _wd_width(label)
    cells = max(0, cells)
    if idle:
        chart = _wd_c("▁" * cells, _wd_C_DIM)
    else:
        chart = _os_spark(_os_bins(pulses, now, cells, OS_SPAN_S), cells) if cells else ""
    out = label + chart
    if tail:
        out += " " * max(0, width - _wd_width(out) - tw) + tail
    return _wd_fit(out, width)


def _cst_window_cell(win: QuotaWindow) -> str:
    """`5h ███▁▁▁▁▁ 42%`: one window's used with a small bar."""
    pct = float(win.used or 0.0)
    bar = _wd_bar(pct / 100.0, _CX_BAR_W, lambda x: _cst_pct_color(x * 100.0))
    return (_wd_c(_wd_trunc(win.name or "", 6), _wd_C_MUTED) + " " + bar + " "
            + _wd_c(f"{min(max(pct, 0.0), 999):.0f}%".rjust(4), _cst_pct_color(pct)))


def _cst_quota_line(acct: QuotaAccount, width: int) -> str:
    """One account: its name, then every window's used with a small bar."""
    name = _wd_c(_wd_pad(_wd_trunc(_wd_clean(acct.name), _CX_QUOTA_NAME_W), _CX_QUOTA_NAME_W), _wd_C_TEXT, bold=True)
    wins = acct.windows or []
    if not wins:
        return _wd_fit("  " + name + _wd_c("  no windows", _wd_C_DIM), width)
    return _wd_fit("  " + "   ".join([name] + [_cst_window_cell(w) for w in wins]), width)


def _cst_usage(gs: GlobalSnapshot, width: int) -> list[str]:
    """One compact quota line per account: name, each window's bar and percent."""
    if not gs.quota_ok:
        return [_wd_fit(_wd_c("quota unavailable", _wd_C_DIM), width)]
    accounts = gs.quota or []
    if not accounts:
        return [_wd_fit(_wd_c("no accounts", _wd_C_DIM), width)]
    return [_cst_quota_line(acct, width) for acct in accounts]


def _cst_metrics(gs: GlobalSnapshot, width: int, now: float) -> list[str]:
    """The fleet tools/min chart over the last 30 minutes."""
    return [_cst_tools_chart(_cst_fleet_pulses(gs), width, now)]


def strip_tab_bar(tab: str, width: int) -> tuple[str, list[tuple[int, int, str]]]:
    """The strip's tab bar line, exactly `width` cells: each tab padded by one space, the active one bold accent with a
    `▸` marker, the rest dim. Returns the line and the click spans [(col0, col1, tab name)], marker included."""
    styled: list[str] = []
    spans: list[tuple[int, int, str]] = []
    col = 0
    for name in STRIP_TABS:
        active = name == tab
        piece = ("▸" if active else "") + name
        pw = _wd_width(piece)
        if col + 1 < width:      # the piece starts after the one-space pad
            spans.append((col + 1, min(col + pw, width - 1), name))
        styled.append(" " + (_wd_c(piece, _wd_C_BLUE, bold=True) if active else _wd_c(piece, _wd_C_DIM)) + " ")
        col += pw + 2       # two pads make the two spaces between the tabs
    return _wd_fit("".join(styled), width), spans


def strip_lines(gs: GlobalSnapshot, tab: str, stage: Stage | None, worker: Worker | None, width: int, height: int,
                scroll: int = 0, now: float = 0.0) -> list[str]:
    """Exactly `height` lines of `width` cells. Usage: quota headroom per account. Events: the fleet tail, newest at the
    bottom, a row tinted when it is the selected row. Logs: the selected row's raw log tail. Metrics: fleet tools/min
    chart. `scroll` moves back in time. An empty tab is one centred dim sentence."""
    if height <= 0:
        return []
    gs = gs if gs is not None else GlobalSnapshot()
    bar = strip_tab_bar(tab, width)[0]
    body_h = height - 1
    if body_h <= 0:
        return [bar]
    t = now if now > 0 else gs.now
    if tab == "Usage":
        body = _cst_usage(gs, width)
    elif tab == "Logs":
        body = _cst_logs(stage, worker, width, body_h, scroll)
    elif tab == "Metrics":
        body = _cst_metrics(gs, width, t)
    elif tab == "Events":
        body = _cst_events(gs, stage, worker, width, body_h, scroll)
    else:
        body = _cst_events(gs, stage, worker, width, body_h, scroll)
    # Every body helper fits its lines itself; the rest of the body is blank.
    return [bar] + body[:body_h] + [_wd_fit("", width)] * max(0, body_h - len(body))



# ──────────────────── ccrow ────────────────────
"""Control-center worker command and compact activity lines."""



def command_lines(worker: Worker, width: int, expanded: bool, cont: str = "", text_w: int | None = None,
                  max_rows: int = 1) -> list[str]:
    """The worker's current command under its row, at exactly `width` cells per line.

    `cont` is the tree guide of the worker's own row, so the line sits under that worker; the text starts under the
    worker's name and wraps inside `text_w` cells (the name column, which ends before LEVEL) instead of running to
    the screen edge. Collapsed it keeps `max_rows` lines and ends with `…`; expanded it keeps every line."""
    width = max(1, width)
    text_w = width if text_w is None else max(1, min(width, text_w))
    step = worker.log.steps[-1] if worker.log.steps else None
    command = (step.tool + " " + step.text if step and step.tool else step.text if step else "")
    command = _wd_clean(command or worker.goal or worker.title).strip()
    if not command:
        return []
    pad = "  " if cont or width >= 3 else ""
    body_width = max(1, text_w - _wd_width(cont) - _wd_width(pad) - 2)
    wrapped = _wd_wrap(command, body_width)
    if not expanded and len(wrapped) > max_rows:
        wrapped = wrapped[:max_rows]
        wrapped[-1] = _wd_clip(wrapped[-1].rstrip() + " …", body_width)
    color = _wd_C_SUB if expanded else _wd_C_MUTED
    return [_wd_pad(_wd_c(cont, _wd_C_BORDER) + pad + _wd_c(("› " if i == 0 else "  ") + part, color), width)
            for i, part in enumerate(wrapped)]



# ──────────────────── cchint ────────────────────
"""Control center: the one-line hint row at the bottom of the frame. Pure; imports model and widgets only."""


HINT = (
    "w station · d details · Tab focus · ←→ pane tabs · 1-6 pane tab · "
    "[ ] strip tab · E strip · v classic · ? keys"
)
_CX_ACTION_HINT = "s stop · n spawn · r resume · K kill"

_CX_SEP = " · "
_CX_SPAWN = "spawn: pick a model"
_CXH_CONFIRM_MAX = 99         # matches ccactions._CX_CONFIRM_MAX
_CX_STOP_KILL = " · K kill"   # appended only on the real stop question line, when it was not clipped


def pane_tab_cycle_keys() -> tuple[str, ...]:
    """Pane tab cycle keys; must match cckeys when the pane has focus."""
    return PANE_TAB_ARROWS


def _cx_hint(width: int, allow_actions: bool = False) -> str:
    """HINT, shortened from the right on whole ` · ` item boundaries; the first item alone is truncated with `…`."""
    hint = HINT.replace(" · [ ]", f" · {_CX_ACTION_HINT} · [ ]") if allow_actions else HINT
    if _wd_width(hint) <= width:
        return hint
    items = hint.split(_CX_SEP)
    for n in range(len(items) - 1, 0, -1):
        candidate = _CX_SEP.join(items[:n])
        if _wd_width(candidate) <= width:
            return candidate
    return _wd_trunc(items[0], width)


def _cx_line(text: str, width: int, fg: tuple[int, int, int], bold: bool = False) -> str:
    """One bright line: control characters become spaces, then the text is cut to `width` with `…` and padded."""
    return _wd_fit(_wd_c(_wd_trunc(text, width), fg, bold=bold), width)


def hint_line(ui: UIState, width: int) -> str:
    """The bottom row, exactly `width` visible cells: the confirm question `ui.cc_confirm[2]` (bright amber) when a
    confirm is open, else `ui.note` (bright) when set, else HINT in dim, shortened from the right (with a `…`) to fit."""
    if width <= 0:
        return ""
    if ui.cc_confirm is not None:
        action, _row_key, question = ui.cc_confirm
        text = question
        if (action == "stop" and "any other key cancels" in question
                and len(question) + len(_CX_STOP_KILL) <= _CXH_CONFIRM_MAX
                and _wd_width(question + _CX_STOP_KILL) <= width):
            text = question + _CX_STOP_KILL
        return _cx_line(text, width, _wd_C_AMBER, bold=True)
    if ui.note:
        return _cx_line(ui.note, width, _wd_C_TEXT)
    if ui.cc_spawn:
        return _cx_line(_CX_SPAWN, width, _wd_C_TEXT)
    return _wd_fit(_wd_c(_cx_hint(width, ui.actions_on()), _wd_C_DIM), width)



# ──────────────────── cclayout ────────────────────
"""Control center: the master-detail frame. Composes the hierarchy table (drawn by render.py's tree, passed in as
`table`), the detail pane and the bottom strip. Imports model, ccpane, ccstrip and widgets only; render.py calls it."""



MIN_COLS = 120       # under this the classic full-screen pages are used
MIN_ROWS = 24
TABLE_MIN = 64       # the table keeps at least this many columns
WIDE_COLS = 190      # ultra-wide: cap the master table and give surplus to the detail pane
TABLE_MAX = 128      # readable master width at WIDE_COLS and above (pane open only)


def cc_applies(cols: int, rows: int) -> bool:
    """True when the master-detail frame fits the terminal."""
    return cols >= MIN_COLS and rows >= MIN_ROWS


def cc_frame(gs: GlobalSnapshot, ui: UIState, cols: int, rows: int, t: float, sel: tuple[str, str, str] | None,
             table: Callable[[int, int], list[str]]) -> list[str]:
    """The whole frame as `rows` lines of `cols` cells, or [] to make render.py draw the classic tree instead.
    `sel` is the selected tree row (stage path, kind, worker name) or None; `table(width, height)` draws the tree at that
    size and sets its click hits (so the table must start at screen row 1, column 1). Adds hits for pane tabs
    ("cctab", name) and strip tabs ("ccstrip", name) with 1-based screen coordinates."""
    if not cc_applies(cols, rows):
        return []
    try:
        strip_open = bool(ui.cc_strip_open and rows >= 30)
        strip_h = (8 if rows >= 40 else 6) if strip_open else 0
        table_h = rows - strip_h - 1

        pane_open = ui.cc_pane_open
        left_w = cols
        pane_w = 0
        if pane_open:
            left_w = max(TABLE_MIN, round(cols * 0.58))
            if cols >= WIDE_COLS:
                left_w = min(left_w, TABLE_MAX)
            if cols - left_w - 1 < 40:
                left_w = cols - 41
            pane_w = cols - left_w - 1

        # The tree's final row is its key footer. Clip or pad to the shared pane height.
        left = table(left_w, table_h)
        left = left[:table_h]
        left.extend([_wd_fit("", left_w)] * max(0, table_h - len(left)))

        path, kind, name = sel if sel is not None else ("", "", "")
        stage = next((item for item in gs.stages if item.path == path), None) if sel is not None else None
        if stage is None and name.startswith("p:"):   # a project heading: show its live (else newest) session
            root = name[2:]
            kin = [item for item in gs.stages if (item.cwd or item.dir or item.path).startswith(root)]
            stage = next((item for item in kin if item.lead_state == "live" or item.live), kin[0] if kin else None)
        worker = None
        if stage is not None and kind == "worker":
            worker = next((item for item in stage.snap.workers if item.name == name), None)

        close_label = _wd_c("✕  d", _wd_C_DIM)
        # the tabs get the width left of the close label, so their click spans never run under it
        pane_bar, pane_spans = pane_tab_bar(ui.cc_tab, max(0, pane_w - _wd_width(close_label) - 1)) if pane_open else ("", [])
        if pane_open:
            pane_bar = _wd_lr(pane_bar, close_label, pane_w)
        if pane_open:
            pane_h = table_h - 1
            if stage is None:
                body = [_wd_fit("", pane_w) for _ in range(max(0, pane_h))]
                if pane_h:
                    message = _wd_c("select a session or worker", _wd_C_DIM)
                    body[pane_h // 2] = _wd_fit(_wd_center(message, pane_w), pane_w)
            else:
                ui.cc_pane_scroll = min(max(0, ui.cc_pane_scroll),
                                        pane_max_scroll(stage, worker, ui.cc_tab, pane_w, pane_h))
                body = pane_lines(stage, worker, ui.cc_tab, pane_w, pane_h, ui.cc_pane_scroll, t)
        ui.cc_strip_scroll = max(0, ui.cc_strip_scroll)

        frame = []
        for row in range(table_h):
            if pane_open:
                accent = ui.cc_focus == "pane"
                divider = _wd_c("│", _wd_C_BLUE if accent else _wd_C_DIM)
                frame.append(_wd_fit(left[row], left_w) + divider + _wd_fit(
                    pane_bar if row == 0 else body[row - 1] if row - 1 < len(body) else "", pane_w))
            else:
                frame.append(_wd_fit(left[row], cols))

        if table_h:
            if not pane_open:
                label = _wd_c("▸ details  d", _wd_C_DIM)
                label_width = _wd_width(label)
                frame[0] = _wd_lr(frame[0], label, cols)
                ui.hits.append((0, 0, cols - label_width, cols - 1, "ccpane", ""))
            else:
                label_width = _wd_width(close_label)
                ui.hits.append((0, 0, left_w + 1 + pane_w - label_width, left_w + pane_w,
                                "ccpane", ""))

        # Tree hits are set by table(); keep them and append tabs in zero-based frame coordinates.
        if pane_open:
            ui.hits.extend((0, 0, left_w + 1 + c0, left_w + 1 + c1, "cctab", name)
                           for c0, c1, name in pane_spans)
        if strip_open:
            rule_color = _wd_C_BLUE if ui.cc_focus == "strip" else _wd_C_DIM
            frame.append(_wd_fit(_wd_c("─" * cols, rule_color), cols))
            _strip_bar, strip_spans = strip_tab_bar(ui.cc_strip, cols)
            strip_body_h = strip_h - 1
            strip = strip_lines(gs, ui.cc_strip, stage, worker, cols, strip_body_h,
                                ui.cc_strip_scroll, t)
            strip_row = len(frame)
            frame.extend(strip[:strip_body_h])
            frame.extend([_wd_fit("", cols)] * max(0, strip_body_h - len(strip)))
            ui.hits.extend((strip_row, strip_row, c0, c1, "ccstrip", tab)
                           for c0, c1, tab in strip_spans)
        frame.append(_wd_fit(hint_line(ui, cols), cols))
        return frame if len(frame) == rows else []
    except Exception:  # noqa: BLE001 - the frame must fall back on every rendering error.
        return []



# ──────────────────── ccspawn ────────────────────
"""Control center: the spawn flow (model picker, then one line of task text, then the confirm). Imports model and
ccactions only. cckeys calls it; it never touches processes itself (ccactions.spawn does, behind the confirm)."""



try:
    import ccactions
except ModuleNotFoundError:
    class _CXActions:
        spawn = staticmethod(spawn)
        spawn_choices = staticmethod(spawn_choices)

    ccactions = _CXActions()

_now = time.time
_CX_CHOICES: list[Choice] = []
_CX_CHOICES_AT: float | None = None
_CX_CHOICES_DEMO = False


def choices() -> list[Choice]:
    """The picker list from `ccactions.spawn_choices()`, cached for 30 s (loaded by spawn_open)."""
    global _CX_CHOICES, _CX_CHOICES_AT, _CX_CHOICES_DEMO
    now = _now()
    if _CX_CHOICES_AT is None or now - _CX_CHOICES_AT > 30 or _CX_CHOICES_DEMO != cx_is_demo():
        _CX_CHOICES = ccactions.spawn_choices()
        _CX_CHOICES_AT = now
        _CX_CHOICES_DEMO = cx_is_demo()
    return _CX_CHOICES


def project_dir_of(gs: GlobalSnapshot, row_key: str) -> str:
    """The directory a spawn from the row `row_key` ("<stage path>|<worker>") starts in: stage.cwd, else stage.dir,
    else stage.path, the first that is an existing directory; "" when none or the stage is gone."""
    stage_path = row_key.rsplit("|", 1)[0]
    stage = next((item for item in gs.stages if item.path == stage_path), None)
    if stage is None:
        return ""
    for path in (stage.cwd, stage.dir, stage.path):
        if path and (cx_is_demo() or os.path.isdir(path)):
            return path
    return ""


def _cx_stage(gs: GlobalSnapshot, sel: tuple[str, str, str] | None) -> Stage | None:
    if sel is None:
        return None
    return next((stage for stage in gs.stages if stage.path == sel[0]), None)


def _cx_stage_key(gs: GlobalSnapshot, row_key: str) -> Stage | None:
    """The stage named by a stored spawn row key, or None when it has gone."""
    stage_path = (row_key or "").rsplit("|", 1)[0]
    return next((stage for stage in gs.stages if stage.path == stage_path), None)


def _prompt(ui: UIState) -> None:
    picks = choices()
    if not picks:
        ui.note = "spawn: picker unavailable"
        return
    index = min(max(ui.cc_spawn_i, 0), len(picks) - 1)
    ui.cc_spawn_i = index
    choice = picks[index]
    if not choice.id:
        ui.note = f"spawn: {choice.label}"
        return
    reason = f" ({choice.reason})" if not choice.ok else ""
    ui.note = f"spawn: ↑↓ pick a model, Enter select, Esc cancel · {choice.label}{reason}"


def spawn_open(ui: UIState, gs: GlobalSnapshot, sel: tuple[str, str, str] | None) -> None:
    """`n`: open the picker (ui.cc_spawn True, cc_spawn_i 0, cc_spawn_model "", cc_input "") and write its prompt to ui.note.
    Refuses with a ui.note and stays closed when nothing is selected or the row has no project directory."""
    if sel is None:
        ui.cc_spawn = False
        ui.cc_spawn_row = ""
        ui.note = "spawn: select a session first"
        return
    stage = _cx_stage(gs, sel)
    if stage is None or not project_dir_of(gs, f"{stage.path}|"):
        ui.cc_spawn = False
        ui.cc_spawn_row = ""
        ui.note = "spawn: no project directory for this row"
        return
    ui.cc_spawn, ui.cc_spawn_i = True, 0
    ui.cc_spawn_row = f"{stage.path}|"
    ui.cc_spawn_model, ui.cc_input = "", ""
    picks = choices()
    if not picks:
        ui.note = "spawn: picker unavailable"
        ui.cc_spawn = False
        ui.cc_spawn_row = ""
        return
    if not picks[0].id:
        ui.note = f"spawn: {picks[0].label}"
        ui.cc_spawn = False
        ui.cc_spawn_row = ""
        return
    _prompt(ui)


def spawn_key(ui: UIState, key: str, gs: GlobalSnapshot, sel: tuple[str, str, str] | None) -> str | None:
    """A key while ui.cc_spawn is open (picker or text input); None when ui.cc_spawn is False. Returns "" when handled.
    Enter on the typed text sets ui.cc_confirm = ("spawn", "<stage path>|", question) and closes the picker."""
    if not ui.cc_spawn:
        return None
    normalized = key.lower()
    if normalized in ("esc", "escape"):
        spawn_cancel(ui)
        ui.note = "spawn cancelled"
        return ""
    if not ui.cc_spawn_model:
        picks = choices()
        if not picks:
            ui.note = "spawn: picker unavailable"
            return ""
        if normalized in ("up", "k"):
            ui.cc_spawn_i = max(0, ui.cc_spawn_i - 1)
            _prompt(ui)
        elif normalized in ("down", "j"):
            ui.cc_spawn_i = min(len(picks) - 1, ui.cc_spawn_i + 1)
            _prompt(ui)
        elif normalized in ("enter", "\n", "\r"):
            choice = picks[min(max(ui.cc_spawn_i, 0), len(picks) - 1)]
            if not choice.ok:
                ui.note = choice.reason
            elif choice.id:
                ui.cc_spawn_model, ui.cc_input = choice.id, ""
                ui.note = f"task for {choice.id}: {ui.cc_input}▌"
        return ""

    if normalized in ("enter", "\n", "\r"):
        if ui.cc_input:
            row_key = ui.cc_spawn_row
            stage = _cx_stage_key(gs, row_key)
            project_dir = project_dir_of(gs, row_key)
            if stage is None or not project_dir:
                ui.note = "spawn: no project directory for this row"
                return ""
            ui.cc_confirm = (
                "spawn", row_key,
                f"Spawn {ui.cc_spawn_model} in {project_dir}: {ui.cc_input[:40]}?  (y/n)",
            )
            ui.cc_spawn = False
            ui.note = ""
            return ""
    elif normalized == "space":
        if len(ui.cc_input) < 300:
            ui.cc_input += " "
    elif normalized in ("backspace", "\b", "\x7f"):
        ui.cc_input = ui.cc_input[:-1]
    elif len(key) == 1 and key.isprintable() and len(ui.cc_input) < 300:
        ui.cc_input += key
    ui.note = f"task for {ui.cc_spawn_model}: {ui.cc_input}▌"
    return ""


def spawn_run(ui: UIState, gs: GlobalSnapshot, row_key: str) -> str:
    """The confirmed `y`: call ccactions.spawn(ui.cc_spawn_model, project_dir_of(gs, row_key), ui.cc_input), clear
    cc_spawn_model and cc_input, return the one-line result."""
    model, text = ui.cc_spawn_model, ui.cc_input
    ui.cc_spawn_model, ui.cc_input = "", ""
    ui.cc_spawn_row = ""
    project_dir = project_dir_of(gs, row_key)
    if not project_dir:
        return "spawn: row is gone"
    return ccactions.spawn(model, project_dir, text)


def spawn_cancel(ui: UIState) -> None:
    """Close the picker/input and clear cc_spawn, cc_spawn_model, cc_input."""
    ui.cc_spawn, ui.cc_spawn_model, ui.cc_input = False, "", ""
    ui.cc_spawn_row = ""



# ──────────────────── cckeys ────────────────────
"""Control center: keys and mouse. Imports model, ccactions, ccspawn, ccpane, ccstrip only; app.py calls it before its own keys."""



_CXK_FOCUS = ("table", "pane", "strip")      # tab cycles these in order
_CXK_PAGE = 10                               # pgup/pgdn step in the pane and the strip
_CXK_ACTIONS = {"s": "stop", "K": "kill", "r": "resume"}
_CXK_ROWS = ("stage", "worker")              # tree kinds an action may stand on; a heading has no stage
_CXK_CLASSIC = "classic view: press v again for the control center"
_CXK_ARM_S = 0.35
_CXK_ARMED: dict[str, object] = {"value": None, "t": 0.0}
_CXK_TARGET: tuple[int | None, int | None, str, str] | None = None
_CXK_PENDING: tuple[int | None, int | None, str, str] | None = None   # identity of the Target the question was built from


def _cxk_stage(gs: GlobalSnapshot, path: str) -> Stage | None:
    """The stage whose row path is `path`, or None."""
    return next((st for st in gs.stages or [] if st.path == path), None)


def _cxk_worker(stage: Stage, name: str) -> Worker | None:
    """The worker called `name` in the stage's snapshot, or None."""
    workers = (stage.snap.workers if stage.snap is not None else []) or []
    return next((wk for wk in workers if wk.name == name), None)


def _cxk_row(gs: GlobalSnapshot, sel: tuple[str, str, str] | None) -> tuple[Stage | None, Worker | None, str]:
    """(stage, worker, why) for the selected tree row; why says what cannot be acted on when stage is None."""
    if not sel or not sel[0] or sel[1] not in _CXK_ROWS:
        return None, None, "no row selected"
    stage = _cxk_stage(gs, sel[0])
    if stage is None:
        return None, None, "row is gone"
    if sel[1] != "worker":
        return stage, None, ""
    worker = _cxk_worker(stage, sel[2])
    if worker is None:
        return None, None, "row is gone"
    return stage, worker, ""


def _cxk_key_target(gs: GlobalSnapshot, row_key: str) -> tuple[Stage | None, Worker | None, str]:
    """(stage, worker, why) for a stored confirm row key ("<stage path>|<worker>")."""
    path, _sep, name = (row_key or "").rpartition("|")
    stage = _cxk_stage(gs, path)
    if stage is None:
        return None, None, "row is gone"
    if not name:
        return stage, None, ""
    worker = _cxk_worker(stage, name)
    if worker is None:
        return None, None, "row is gone"
    return stage, worker, ""


def _cxk_row_key(stage: Stage, worker: Worker | None) -> str:
    """The row key a confirm stores: the stage path, then the worker name ("" for a lead row)."""
    return f"{stage.path}|{worker.name if worker is not None else ''}"


def _cxk_identity(gs: GlobalSnapshot, row_key: str) -> tuple[int | None, int | None, str, str] | None:
    """The current process identity and label for an action confirm row."""
    stage, worker, _why = _cxk_key_target(gs, row_key)
    if stage is None:
        return None
    target = target_of(stage, worker)
    return target.pid, target.start, target.session_id, target.label


def _cxk_sync_confirm(ui: UIState, gs: GlobalSnapshot) -> None:
    """Record a newly armed confirm at the end of the current key handling."""
    global _CXK_TARGET, _CXK_PENDING
    value = ui.cc_confirm
    if value == _CXK_ARMED["value"]:
        if value is None:
            _CXK_TARGET = None
        return
    _CXK_ARMED["value"] = value
    _CXK_ARMED["t"] = time.monotonic()
    _CXK_TARGET = None
    if value is not None and value[0] != "spawn":
        # The identity the question and `can` were built from, not a fresh read: a pid recycled in between must differ.
        _CXK_TARGET = _CXK_PENDING if _CXK_PENDING is not None else _cxk_identity(gs, value[1])
    _CXK_PENDING = None


def _cxk_step(key: str) -> int | None:
    """The scroll delta a key stands for (positive = down/on, negative = up/back); None when it is not a scroll key."""
    if key in ("up", "k"):
        return -1
    if key in ("down", "j"):
        return 1
    if key == "pgup":
        return -_CXK_PAGE
    if key == "pgdn":
        return _CXK_PAGE
    return None


def _cxk_confirm(ui: UIState, key: str, gs: GlobalSnapshot) -> str | None:
    """A key while ui.cc_confirm waits: y acts on a fresh target, anything else cancels; ctrl-c is left to the app."""
    global _CXK_PENDING
    if ui.cc_confirm is None:
        return None
    if key == "ctrl-c":
        return None
    action, row_key, _question = ui.cc_confirm
    if key == "y" and not ui.cc_active:   # the classic view does not show the question: never act on a hidden prompt
        ui.cc_confirm = None
        ui.note = "cancelled (question not visible)"
        if action == "spawn":
            spawn_cancel(ui)
        return ""
    if key == "y" and time.monotonic() - float(_CXK_ARMED["t"]) < _CXK_ARM_S:
        return ""
    if action == "stop" and key == "K":
        if time.monotonic() - float(_CXK_ARMED["t"]) < _CXK_ARM_S:
            return ""
        stage, worker, why = _cxk_key_target(gs, row_key)
        if stage is None:
            ui.cc_confirm = None
            ui.note = why
            return ""
        target = target_of(stage, worker)
        identity = (target.pid, target.start, target.session_id, target.label)
        if identity != _CXK_TARGET:
            ui.cc_confirm = None
            ui.note = "row changed, cancelled"
            return ""
        ok, why = can("kill", target)
        if not ok:
            ui.cc_confirm = None
            ui.note = f"kill: {why}"
            return ""
        _CXK_PENDING = identity
        ui.cc_confirm = ("kill", row_key, confirm_text("kill", target))
        ui.note = ""
        return ""
    ui.cc_confirm = None
    if key != "y":
        ui.note = "cancelled"
        if action == "spawn":
            spawn_cancel(ui)
        return ""
    stage, worker, why = _cxk_key_target(gs, row_key)
    if stage is None:            # the row left the snapshot between the question and the answer
        ui.note = why
        return ""
    if action == "spawn":
        ui.note = spawn_run(ui, gs, row_key)
        return ""
    target = target_of(stage, worker)
    identity = (target.pid, target.start, target.session_id, target.label)
    if identity != _CXK_TARGET:
        ui.note = "row changed, cancelled"
        return ""
    ui.note = run(action, target)
    return ""


def _cxk_dispatch(ui: UIState, key: str, gs: GlobalSnapshot, rows: int, sel: tuple[str, str, str] | None) -> str | None:
    """A key in the control center. Returns None when the key is not the control center's (app.py then handles it
    as before), else "" (handled, nothing for the main loop to do). Owns, while ui.cc is on and no page is open:
    Tab (focus table/pane/strip), left/right (pane tab, pane focused), [ ] (strip tab), E (strip), v (classic view), s stop, K kill, n spawn,
    r resume, y/n/esc on ui.cc_confirm, the spawn picker's up/down/enter/esc, pgup/pgdn/wheel scroll of the focused part.
    Every action goes through ccactions.can / confirm_text / run and shows its result in ui.note. `sel` is the selected tree row."""
    global _CXK_PENDING
    if not ui.actions_on():
        if ui.cc_spawn:
            spawn_cancel(ui)
            ui.cc_confirm = None
            return ""
        if ui.cc_confirm and ui.cc_confirm[0] in _CXK_ACTIONS.values():
            ui.cc_confirm = None
            return ""
        if ui.cc_active and key in ("n", "s", "K", "r"):
            return ""
    handled = _cxk_confirm(ui, key, gs)
    if handled is not None:
        return handled
    if ui.cc_spawn:              # the picker and its text line take every key while they are open
        return spawn_key(ui, key, gs, sel)
    if not ui.cc_active:         # the last frame was the classic tree: none of these keys are ours
        return None
    if key == "d":
        ui.cc_pane_open = not ui.cc_pane_open
        if not ui.cc_pane_open and ui.cc_focus == "pane":
            ui.cc_focus = "table"
        return ""
    if key == "tab":
        focus = ui.cc_focus if ui.cc_focus in _CXK_FOCUS else "table"
        order = _CXK_FOCUS if ui.cc_pane_open else ("table", "strip")
        if focus == "pane" and not ui.cc_pane_open:
            focus = "table"
        ui.cc_focus = order[(order.index(focus) + 1) % len(order)]
        return ""
    if key == "esc" and ui.cc_pane_open:
        ui.cc_pane_open = False
        if ui.cc_focus in ("pane", "strip"):
            ui.cc_focus = "table"
        return ""
    if key == "esc" and ui.cc_focus == "strip":
        ui.cc_focus = "table"
        return ""
    if ui.cc_focus == "pane" and ui.cc_pane_open:
        if key == "home":
            ui.cc_pane_scroll = 0
            return ""
        if key in PANE_TAB_ARROWS:     # the pane's tabs; in the table ← and → fold and unfold the row
            index = PANE_TABS.index(ui.cc_tab) if ui.cc_tab in PANE_TABS else 0
            ui.cc_tab = PANE_TABS[(index + (1 if key == "right" else -1)) % len(PANE_TABS)]
            ui.cc_pane_scroll = 0
            return ""
        tab = pane_tab_digit(key)
        if tab is not None:
            ui.cc_tab = tab
            ui.cc_pane_scroll = 0
            return ""
        step = _cxk_step(key)
        if step is not None:
            ui.cc_pane_scroll = max(0, ui.cc_pane_scroll + step)   # the layout clamps the maximum
            return ""
    elif ui.cc_focus == "strip":
        if key == "home":
            ui.cc_strip_scroll = 0
            return ""
        step = _cxk_step(key)
        if step is not None:
            ui.cc_strip_scroll = max(0, ui.cc_strip_scroll - step)  # up moves back from the newest
            return ""
    if key in ("[", "]"):
        if not ui.cc_strip_open:
            ui.note = "the strip is hidden: E shows it"
            return ""
        index = STRIP_TABS.index(ui.cc_strip) if ui.cc_strip in STRIP_TABS else 0
        ui.cc_strip = STRIP_TABS[(index + (1 if key == "]" else -1)) % len(STRIP_TABS)]
        ui.cc_strip_scroll = 0
        return ""
    if key == "E":       # `e` is expand-all in the list, so the strip has its own key
        ui.cc_strip_open = not ui.cc_strip_open
        return ""
    if key == "v":
        ui.cc = False
        ui.note = _CXK_CLASSIC
        return ""
    if key == "n":
        spawn_open(ui, gs, sel)
        return ""
    action = _CXK_ACTIONS.get(key)
    if action is not None:
        stage, worker, why = _cxk_row(gs, sel)
        if stage is None:
            ui.note = why
            return ""
        target = target_of(stage, worker)
        ok, why = can(action, target)
        if not ok:
            ui.note = why
            return ""
        ui.cc_confirm = (action, _cxk_row_key(stage, worker), confirm_text(action, target))
        _CXK_PENDING = (target.pid, target.start, target.session_id, target.label)
        return ""
    return None                  # up/down/enter/space in the table stay with the tree


def cc_key(ui: UIState, key: str, gs: GlobalSnapshot, rows: int,
           sel: tuple[str, str, str] | None) -> str | None:
    """Handle one key and update confirm arm state after the key path has run."""
    _cxk_sync_confirm(ui, gs)
    try:
        return _cxk_dispatch(ui, key, gs, rows, sel)
    finally:
        _cxk_sync_confirm(ui, gs)


def cc_pointer(ui: UIState, action: str, target: str) -> list[str]:
    """A click on a control center hit ("cctab", "ccstrip") as the keys it stands for, run through the normal key path."""
    if action == "ccpane":
        ui.cc_pane_open = not ui.cc_pane_open
        if not ui.cc_pane_open and ui.cc_focus == "pane":
            ui.cc_focus = "table"
    elif action == "ccrow":
        if target in ui.expanded:
            ui.expanded.discard(target)
            ui.pinned.discard(target)
        else:
            ui.expanded.add(target)
            ui.pinned.add(target)
    elif action == "cctab" and target in PANE_TABS:
        ui.cc_tab, ui.cc_pane_scroll, ui.cc_focus = target, 0, "pane"
        ui.cc_pane_open = True
    elif action == "ccstrip" and target in STRIP_TABS:
        ui.cc_strip, ui.cc_strip_scroll, ui.cc_focus = target, 0, "strip"
    return []



# ──────────────────── tutorial ────────────────────
"""Interactive tutorial (`station --tutorial`): a step card drawn over the real control center on demo data.
Imports model, widgets, ccpane and ccstrip only. app.py offers every key to `tut_key` first, then calls `tut_after_key`;
render.py calls `tut_overlay`. Nothing moves on by itself: a step's goal ticks it done, and only the next key moves on.
A step that asks for a menu is done only once you have been in that menu (`UIState.tut_seen` remembers where you went)."""



_tu_NEXT, _tu_BACK = (".", ">"), (",", "<")
_tu_RESTART, _tu_SKIP, _tu_QUIT = "R", "S", "Q"
_tu_CARD_W = 80
_tu_Rows = Callable[[], list[tuple[str, str, str]]]   # the tree rows now: (stage path, kind, name)


def _tu_snapshot(ui: UIState) -> tuple:
    """The state steps compare against, taken when the step starts."""
    return (ui.gsel, frozenset(ui.gopen_keys), frozenset(ui.gshut_keys), frozenset(ui.gfolded), frozenset(ui.gopen))


def _tu_pick(rows: _tu_Rows, ui: UIState, kind: str, path_has: str = "") -> None:
    """Put the cursor on the first row of this kind (whose stage path holds `path_has`); stays put when there is none."""
    for i, (path, k, _name) in enumerate(rows()):
        if k == kind and path_has in path:
            ui.gsel = i
            return


def _tu_clean(ui: UIState, rows: _tu_Rows) -> None:
    """Every step starts from the same screen: the control center, nothing open, nothing typed, default folds."""
    ui.cc = True
    ui.gpage, ui.view, ui.scroll, ui.detail_text = "", "overview", 0, []
    ui.gturn, ui.gworker, ui.gsess, ui.sel = "", "", False, 0
    ui.help, ui.gedit, ui.gquery, ui.gfilter = False, False, "", "all"
    ui.cc_pane_open, ui.cc_focus, ui.cc_tab = False, "table", "Overview"
    ui.cc_strip_open, ui.cc_strip, ui.cc_strip_scroll, ui.cc_pane_scroll = True, "Usage", 0, 0
    ui.cc_confirm, ui.cc_spawn, ui.cc_spawn_model, ui.cc_input, ui.cc_spawn_row = None, False, "", "", ""
    ui.close_ask, ui.note = None, ""
    ui.gopen_keys, ui.gshut_keys, ui.gfolded, ui.gopen = set(), set(), set(), set()
    ui.ghide_idle = ui.ghide_closed = False
    ui.gsel = 0


def _tu_setup(*extra: Callable[[UIState, _tu_Rows], None]) -> Callable[[UIState, _tu_Rows], None]:
    def run(ui: UIState, rows: _tu_Rows) -> None:
        _tu_clean(ui, rows)
        for fn in extra:
            fn(ui, rows)
    return run


def _tu_on_stage(ui: UIState, rows: _tu_Rows) -> None:
    _tu_pick(rows, ui, "stage", "demo-project")


def _tu_on_worker(ui: UIState, rows: _tu_Rows) -> None:
    _tu_pick(rows, ui, "worker")


def _tu_on_closed(ui: UIState, rows: _tu_Rows) -> None:
    ui.gopen.add(("", "more", "finished:/demo/old-spike"))   # finished sessions sit behind a one-line fold; open the one the step needs
    _tu_pick(rows, ui, "stage", "old-spike")


def _tu_in_station(ui: UIState, rows: _tu_Rows) -> None:
    """Start inside the station view of the demo project, its live workers open (what w does from the list)."""
    for path, kind, _name in rows():
        if kind == "stage" and "demo-project" in path:
            ui.gpage, ui.gstage, ui.view, ui.tab, ui.follow = "stage", path, "overview", "live", True
            ui.expanded = {name for p, k, name in rows() if p == path and k == "worker"}
            return


def _tu_pane_open(ui: UIState, rows: _tu_Rows) -> None:
    ui.cc_pane_open = True
    ui.tut_seen.add(ui.cc_tab)


def _tu_strip_seen(ui: UIState, rows: _tu_Rows) -> None:
    ui.tut_seen.add(ui.cc_strip)


# -- goals ---------------------------------------------------------------------------------------------------------
def _tu_moved(ui: UIState) -> bool:
    return ui.gsel != ui.tut_base[0]


def _tu_folded(ui: UIState) -> bool:
    return (frozenset(ui.gopen_keys), frozenset(ui.gshut_keys), frozenset(ui.gfolded), frozenset(ui.gopen)) != ui.tut_base[1:5]


def _tu_visit(page: str) -> Callable[[UIState, str], None]:
    """Track: note when the page was open."""
    def track(ui: UIState, key: str) -> None:
        if ui.gpage == page:
            ui.tut_seen.add("in")
    return track


def _tu_back_from_page(ui: UIState) -> bool:
    return "in" in ui.tut_seen and ui.gpage == ""


def _tu_track_station(ui: UIState, key: str) -> None:
    if ui.gpage == "stage" and ui.view in ("lead", "cost", "files"):
        ui.tut_seen.add(ui.view)


def _tu_track_tabs(ui: UIState, key: str) -> None:
    if ui.cc_pane_open:
        ui.tut_seen.add(ui.cc_tab)


def _tu_track_strip(ui: UIState, key: str) -> None:
    if ui.cc_strip_open:
        ui.tut_seen.add(ui.cc_strip)


def _tu_checklist(names: tuple[str, ...]) -> Callable[[UIState], str]:
    def line(ui: UIState) -> str:
        return "   ".join(("✔ " if n in ui.tut_seen else "· ") + n for n in names)
    return line


def _tu_track_quota(ui: UIState, key: str) -> None:
    if ui.view == "quota":
        ui.tut_seen.add("in")


def _tu_track_keys(*wanted: str) -> Callable[[UIState, str], None]:
    def track(ui: UIState, key: str) -> None:
        if key in wanted:
            ui.tut_seen.add(key)
    return track


def _tu_track_note(**prefixes: str) -> Callable[[UIState, str], None]:
    """Track: ui.note starting with one of the prefixes (what the action reported) marks that name seen."""
    def track(ui: UIState, key: str) -> None:
        for name, prefix in prefixes.items():
            if ui.note.startswith(prefix):
                ui.tut_seen.add(name)
    return track


def _tu_track_end(ui: UIState, key: str) -> None:
    if key == "x":
        ui.tut_seen.add("x")
    elif "x" in ui.tut_seen and key in ("y", "n", "esc"):
        ui.tut_seen.add("answered")


def _tu_all(*names: str) -> Callable[[UIState], bool]:
    return lambda ui: all(n in ui.tut_seen for n in names)


