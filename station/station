    else:
        env = os.environ.get("STATUS_ROOTS", "")
        roots = [x for x in env.split(os.pathsep) if x] if env else list(_AP_DEFAULT_ROOTS)
    return [os.path.realpath(os.path.expanduser(x)) for x in roots]


