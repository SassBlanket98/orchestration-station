"""Ops console: the openclaw session page (R3): vitals strip, turn table, a turn's tool calls. Imports model, widgets and
the ops* helpers only; render.py draws the key line under it."""



OV_KEYS = (("↑↓", "turn"), ("Enter", "tools"), ("Esc", "back"))

# Turn table columns after the arrow: (title, width, leading gap, align); width 0 is the flexible column.
_OV_NARROW = (("", 1, 0, "l"), ("TIME", 5, 1, "l"), ("ASK", 0, 2, "l"), ("TOK", 8, 1, "r"),
              ("COST", 9, 2, "r"), ("LAT", 7, 2, "r"), ("TOOLS", 0, 2, "l"))
_OV_WIDE = (("", 1, 0, "l"), ("TIME", 5, 1, "l"), ("ASK", 0, 2, "l"), ("MODEL", 14, 1, "l"),
            ("IN", 7, 1, "r"), ("OUT", 7, 1, "r"), ("COST", 8, 1, "r"), ("LAT", 7, 1, "r"),
            ("TOOLS", 0, 2, "l"))


def _ov_opens(stage: Stage) -> bool:
    """Whether Enter/o on this session row opens the openclaw page (an OpenClaw session)."""
    return stage.lead_kind == "openclaw" or stage.tag == "OClaw"


def _ov_time(stamp: float) -> str:
    return time.strftime("%H:%M", time.localtime(stamp)) if stamp > 0 else "—"


def _ov_amount(value: int | None, suffix: str = "") -> str:
    return "—" if value is None else f"{_wd_fmt_tok(value)}{suffix}"


def _ov_cost(value: float | None) -> str:
    return "— local" if value is None else f"${value:.2f}"


def _ov_duration(value: float | None) -> str:
    if value is None:
        return "—"
    if value >= 60:
        return f"{int(value // 60)}m{int(value % 60):02d}s"
    return f"{value:.1f}s"


def _ov_vitals(v: Vitals | None, cols: int) -> list[str]:
    missing = _wd_c("—", _wd_C_FAINT)
    if v is None:
        fields = [f"MODEL {missing}", f"CTX {missing}", f"COMPACT {missing}",
                  f"COST {missing}", f"RUNTIME {missing}", f"STATUS {missing}"]
        return [_wd_fit("   " + "   ".join(fields), cols)]
    model = v.model or "—"
    provider = v.provider or "—"
    fields = [_wd_c("MODEL ", _wd_C_MUTED) + _wd_c(model, _wd_C_CYAN if v.model else _wd_C_FAINT) +
              " " + _wd_c(provider, _wd_C_SUB if v.provider else _wd_C_FAINT)]
    if v.ctx_used is None or v.ctx_budget is None or v.ctx_budget <= 0:
        fields.append(_wd_c("CTX ", _wd_C_MUTED) + missing)
    else:
        pct = min(100, round(v.ctx_used * 100 / v.ctx_budget))
        fill = min(10, max(0, round(pct / 10)))
        bar = "▰" * fill + "▱" * (10 - fill)
        fields.append(_wd_c("CTX ", _wd_C_MUTED) + _wd_c(bar, _wd_C_TEAL) + " " +
                      _wd_c(f"{v.ctx_used / 1000:.1f}k/{v.ctx_budget / 1000:.0f}k {pct}%", _wd_C_SUB))
    fields.append(_wd_c("COMPACT ", _wd_C_MUTED) + _wd_c(str(v.compactions), _wd_C_SUB))
    fields.append(_wd_c("COST ", _wd_C_MUTED) + _wd_c(_ov_cost(v.cost), _wd_C_GREEN if v.cost is not None else _wd_C_FAINT))
    fields.append(_wd_c("RUNTIME ", _wd_C_MUTED) + _wd_c(_ov_duration(v.runtime), _wd_C_SUB))
    status = v.status or "—"
    status_color = (_wd_C_GREEN if status == "running" else _wd_C_RED if status in ("failed", "timeout", "killed")
                    else _wd_C_SUB if v.status else _wd_C_FAINT)
    fields.append(_wd_c("STATUS ", _wd_C_MUTED) + _wd_c(("● " if v.status else "") + status, status_color))
    line = "   "
    lines: list[str] = []
    for item in fields:
        candidate = line + ("   " if line.strip() else "") + item
        if _wd_width(candidate) > cols:
            lines.append(_wd_fit(line, cols))
            line = "   " + item
        else:
            line = candidate
    if line.strip():
        lines.append(_wd_fit(line, cols))
    return lines or [_wd_fit("", cols)]


def _ov_rule(cols: int) -> str:
    return _wd_fit(_wd_c("─" * cols, _wd_C_BORDER), cols)


def _ov_columns(cols: int, wide: bool) -> list[tuple[str, int, int, str]]:
    """Resolved table columns (title, width, leading gap, align), summing to `cols` while there is room."""
    spec = _OV_WIDE if wide else _OV_NARROW
    fixed = sum(lead + width for _, width, lead, _ in spec)
    spare = max(0, cols - fixed)
    if wide:
        ask = min(40, max(16, spare - 15))
    else:
        ask = min(44, max(8, spare - 14))
    ask = min(ask, max(0, spare - 1))
    tools = max(0, spare - ask)
    return [(title, width or (ask if title == "ASK" else tools), lead, align)
            for title, width, lead, align in spec]


def _ov_cell(value: str, width: int, color: tuple[int, int, int] | None = None, right: bool = False) -> str:
    """One cell of exactly `width` cells, right aligned when asked."""
    text = _wd_clip(_wd_c(value, color) if color else value, width)
    pad = " " * max(0, width - _wd_width(text))
    return pad + text if right else text + pad


def _ov_header(cols: int, wide: bool) -> str:
    parts: list[str] = []
    for title, width, lead, align in _ov_columns(cols, wide):
        text = _wd_trunc(title, width)
        parts.append(" " * lead + (text.rjust(width) if align == "r" else text.ljust(width)))
    return _wd_fit(_wd_c("".join(parts), _wd_C_MUTED, bold=True), cols)


def _ov_turn_line(turn: Turn, selected: bool, expanded: bool, cols: int, wide: bool) -> str:
    ask = turn.ask.splitlines()[0] if turn.ask else "—"
    when = _ov_time(turn.start)
    toks = None if turn.tokens_in is None and turn.tokens_out is None else (turn.tokens_in or 0) + (turn.tokens_out or 0)
    cost = "—" if turn.cost is None else f"${turn.cost:.2f}"
    lat = "—" if turn.latency is None else f"{turn.latency:.1f}s"
    tools = " ".join(f"{name}×{count}" for name, count in turn.tools.items()) or "—"
    retry = _wd_c(f" ↻{turn.attempts - 1}", _wd_C_AMBER) if turn.attempts > 1 else ""
    error = _wd_c(" ✖", _wd_C_RED) if turn.outcome in ("error", "aborted") else ""
    markers = retry + error
    mark = _wd_c("▾" if expanded else "▸", _wd_C_CYAN if expanded else _wd_C_BLUE)
    lat_color = _wd_C_AMBER if turn.latency is not None and turn.latency > 30 else _wd_C_SUB if turn.latency is not None else _wd_C_FAINT
    cells: dict[str, tuple[str, tuple[int, int, int] | None]] = {
        "": (mark, None),
        "TIME": (when, _wd_C_MUTED if turn.start else _wd_C_FAINT),
        "ASK": (ask, _wd_C_SUB if turn.ask else _wd_C_FAINT),
        "MODEL": (turn.model or "—", _wd_C_VIOLET if turn.model else _wd_C_FAINT),
        "IN": (_ov_amount(turn.tokens_in), _wd_C_SUB if turn.tokens_in is not None else _wd_C_FAINT),
        "OUT": (_ov_amount(turn.tokens_out), _wd_C_SUB if turn.tokens_out is not None else _wd_C_FAINT),
        "TOK": (_ov_amount(toks), _wd_C_SUB if toks is not None else _wd_C_FAINT),
        "COST": (cost, _wd_C_GREEN if turn.cost is not None else _wd_C_FAINT),
        "LAT": (lat, lat_color),
        "TOOLS": (markers + (" " if markers and turn.tools else "") + tools,
                  _wd_C_SUB if turn.tools else _wd_C_FAINT),
    }
    parts: list[str] = []
    for title, width, lead, align in _ov_columns(cols, wide):
        value, color = cells[title]
        parts.append(" " * lead + _ov_cell(value, width, color, right=align == "r"))
    line = "".join(parts)
    line = _wd_fit(_wd_clip(line, cols), cols)
    return _wd_bg_line(line, _wd_C_SELBG, cols) if selected else line


def _ov_call_line(call: TurnTool, cols: int) -> str:
    mark = "✔" if call.ok is True else "✖" if call.ok is False else "—"
    color = _wd_C_GREEN if call.ok is True else _wd_C_RED if call.ok is False else _wd_C_FAINT
    prefix = (f"         │ {_ov_time(call.ts)}:{time.strftime('%S', time.localtime(call.ts))}  "
              f"{call.name}  ")
    suffix = f"  {_ov_duration(call.dur):>6}  "
    args = call.args or "—"
    args_width = max(0, cols - _wd_width(prefix) - _wd_width(mark) - _wd_width(suffix))
    line = _wd_c(prefix, _wd_C_SUB) + _wd_c(mark, color) + _wd_c(suffix, _wd_C_SUB) + _wd_c(_wd_trunc(args, args_width), _wd_C_SUB)
    return _wd_fit(_wd_clip(line, cols, ell=False), cols)


def _ov_turns(stage: Stage) -> list[Turn]:
    """The stage's turns, newest first, whatever order the collector left them in."""
    return sorted(stage.turns, key=lambda turn: turn.start, reverse=True)


def _ov_turn_content(stage: Stage, ui: UIState, cols: int, now: float) -> list[str]:
    turns = _ov_turns(stage)
    lines: list[str] = []
    if not turns:
        return [_wd_fit("   no turn data", cols)]
    today = time.strftime("%Y-%m-%d", time.localtime(now))
    todays = sum(1 for turn in stage.turns if turn.start > 0 and time.strftime("%Y-%m-%d", time.localtime(turn.start)) == today)
    retries = sum(max(0, turn.attempts - 1) for turn in stage.turns)
    errors = sum(turn.outcome in ("error", "aborted") for turn in stage.turns)
    latency = [round(turn.latency or 0) for turn in turns[:12][::-1]]
    spark = _os_spark(latency, min(12, max(1, cols - 72)))
    summary = f"TURNS {todays} today · {retries} {'retry' if retries == 1 else 'retries'} · {errors} errors"
    lines.append(_wd_fit(_wd_c("   " + summary, _wd_C_TEXT, bold=True) +
                         _wd_c("  latency ", _wd_C_MUTED) + _wd_c(spark, _wd_C_BLUE), cols))
    wide = cols >= 110
    lines.append(_ov_header(cols, wide))
    selected = min(max(ui.sel, 0), len(turns) - 1)
    expanded = next((i for i, turn in enumerate(turns) if turn.run_id == ui.gturn), -1)
    for i, turn in enumerate(turns):
        lines.append(_ov_turn_line(turn, i == selected, i == expanded, cols, wide))
        if i == expanded:
            for call in turn.calls:
                lines.append(_ov_call_line(call, cols))
            if turn.attempts > 1 or turn.outcome in ("error", "aborted"):
                why = f"attempt 1 model error: {turn.error or 'retry'}  →  attempt {turn.attempts} {turn.outcome}"
                lines.append(_wd_fit(_wd_c("         └ " + _wd_trunc(why, max(0, cols - 11)), _wd_C_AMBER), cols))
    return lines


def _ov_page(stage: Stage, ui: UIState, cols: int, rows: int, t: float) -> list[str]:
    """Exactly `rows` lines (the key line is drawn by the caller)."""
    if rows <= 0:
        return []
    cols = max(1, cols)
    name = stage.display_name or stage.session_name or "—"
    clock = time.strftime("%H:%M:%S", time.localtime(t)) if t else "—"
    state = {"active": "live", "idle": "idle", "closed": "closed"}.get(stage.state, stage.state or "—")
    agent = _co_agent_label()
    crumb = _wd_c(f"◆ {agent} › ", _wd_C_CYAN, bold=True) + _wd_c(name, _wd_C_TEXT)
    right = _wd_c(f"{agent} · {state} · {clock}", _wd_C_MUTED)
    gap = max(1, cols - _wd_width(crumb) - _wd_width(right))
    lines = [_wd_fit(crumb + " " * gap + right, cols), _ov_rule(cols)]
    lines.extend(_ov_vitals(stage.vitals, cols))
    lines.append(_ov_rule(cols))
    fixed = lines
    content = _ov_turn_content(stage, ui, cols, t)
    available = max(0, rows - len(fixed))
    # Keep the selected turn and its open calls in view, reserving a marker for omitted older rows.
    if len(content) > available:
        start = 0
        turn_positions = [i for i, line in enumerate(content)
                          if _wd_SGR_RE.sub("", line).startswith(("▸", "▾"))]
        selected = min(max(ui.sel, 0), max(0, len(turn_positions) - 1))
        if turn_positions and turn_positions[selected] >= available:
            start = max(0, turn_positions[selected] - available + 1)
        body = content[start:start + available]
        if start and available:
            earlier = sum(position < start for position in turn_positions)
            body[0] = _wd_fit(_wd_c(f"   … {earlier} older turns", _wd_C_FAINT), cols)
    else:
        body = content
    result = (fixed + body)[:rows]
    result.extend([_wd_fit("", cols)] * (rows - len(result)))
    return result


def _ov_key(ui: UIState, stage: Stage, key: str, rows: int) -> bool:
    """Handle a key on the openclaw page; True when used. Esc/←/Backspace are handled by the caller."""
    turns = _ov_turns(stage)
    last = max(0, len(turns) - 1)
    ui.sel = min(max(ui.sel, 0), last)
    movements = {"up": -1, "k": -1, "down": 1, "j": 1,
                 "pageup": -max(1, rows // 2), "pgup": -max(1, rows // 2),
                 "pagedown": max(1, rows // 2), "pgdn": max(1, rows // 2)}
    normalized = key
    if key in ("↑", "↓"):
        normalized = "up" if key == "↑" else "down"
    if normalized in movements:
        ui.sel = min(last, max(0, ui.sel + movements[normalized]))
        return True
    if normalized in ("home", "g"):
        ui.sel = 0
        return True
    if normalized in ("end", "G"):
        ui.sel = last
        return True
    if normalized in ("enter", "\r", "\n") and turns:
        run_id = turns[ui.sel].run_id
        ui.gturn = "" if ui.gturn == run_id else run_id
        return True
    return False



# ──────────────────── workerview ────────────────────
"""Ops console: the worker page (R4): identity, metrics, TOOLS/MIN, goal, step table with why lines. Imports model,
widgets and the ops* helpers only; render.py draws the key line under it."""


WV_KEYS = (("↑↓", "step"), ("b", "brief"), ("r", "report"), ("f", "files"), ("Esc", "back"))

_WV_SPARK_MAX = 60                  # most sparkline cells
_WV_MID = "   "                     # between fields on a line
_WV_STATE_COL = {RUNNING: _wd_C_BLUE, QUIET: _wd_C_AMBER, STALLED: _wd_C_RED, DONE: _wd_C_GREEN, FAILED: _wd_C_RED}
_WV_WHY_CONT = " " * (_OS_STEP_HEAD_W - len(_OS_WHY_LABEL))   # puts `why` under the step's tool column


def _wv_unknown() -> str:
    return _wd_c("—", _wd_C_FAINT)


def _wv_val(text: str, color: tuple[int, int, int] = _wd_C_SUB) -> str:
    """A value, or a FAINT `—` when it is unknown."""
    return _wd_c(text, color) if text not in ("", "—") else _wv_unknown()


def _wv_field(label: str, value: str) -> str:
    return _wd_c(label + " ", _wd_C_DIM) + value


def _wv_wrap(fields: list[str], cols: int) -> list[str]:
    """Fields with gaps between them; a field that does not fit starts the next line, whole."""
    lines: list[str] = []
    line = ""
    for part in fields:
        if line and _wd_width(line) + _wd_width(_WV_MID) + _wd_width(part) > cols:
            lines.append(line)
            line = ""
        line = (line + _wd_c(_WV_MID, _wd_C_FAINT) if line else "") + part
    lines.append(line)
    return [_wd_fit(text, cols) for text in lines]


def _wv_mark(wk: Worker, t: float) -> str:
    if wk.state in LIVE_STATES:
        return _wd_c(_wd_spinner(t), _wd_family_color(wk.family))
    if wk.state == DONE:
        return _wd_c("✔", _wd_C_GREEN)
    if wk.state == FAILED:
        return _wd_c("✖", _wd_C_RED)
    return _wd_c("◌", _wd_C_FAINT)


def _wv_crumb(stage: Stage, wk: Worker, t: float, cols: int) -> str:
    """project › session › mark name (left); level tag · state · clock (right)."""
    sep = _wd_c(" › ", _wd_C_FAINT)
    project = _wd_clean(stage.label)
    session = _wd_clean(stage.session_name)
    left = (_wd_c(_wd_trunc(project, cols // 3), _wd_C_MUTED) if project else _wv_unknown()) + sep
    left += (_wd_c(_wd_trunc(session, cols // 3), _wd_C_MUTED) if session else _wv_unknown()) + sep
    left += _wv_mark(wk, t) + " " + _wd_c(_wd_clean(wk.name), _wd_C_TEXT, bold=True)
    state = wk.state or "—"
    right = (_wd_c(wk.level_tag or "WORKER", _wd_C_DIM) + _wd_c(" · ", _wd_C_FAINT)
             + _wd_c(state, _WV_STATE_COL.get(wk.state, _wd_C_MUTED)) + _wd_c(" · ", _wd_C_FAINT)
             + _wd_c(_wd_fmt_clock(t, seconds=True), _wd_C_DIM))
    return _wd_lr(left, right, cols)


def _wv_identity(wk: Worker, model: str, cols: int) -> list[str]:
    fields = [
        _wv_field("MODEL", _wv_val(model, _wd_C_TEXT)),
        _wv_field("ROUTE", _wv_val(_wd_clean(wk.account))),
        _wv_field("MODE", _wv_unknown()),           # the worker record has no mode
        _wv_field("PID", _wv_val(str(wk.pid) if wk.pid else "")),
        _wv_field("JOB", _wv_val(_wd_clean(wk.job))),
    ]
    return _wv_wrap(fields, cols)


def _wv_metrics(wk: Worker, cells: object, cols: int) -> list[str]:
    cost_note = getattr(cells, "cost_note", "")
    if getattr(cells, "cost", None) is not None:
        cost = _wd_c(_wd_fmt_money(cells.cost), _wd_C_SUB)
    else:
        cost = _wd_c("— " + ("local" if cost_note == "local" else "sub"), _wd_C_FAINT)
    tools = getattr(cells, "tools", None)
    tokens = getattr(cells, "tokens", None)
    ctx = getattr(cells, "ctx_pct", None)
    flags = ", ".join(sorted(_wd_clean(flag) for flag in wk.flags))
    fields = [
        _wv_field("ELAPSED", _wv_val(cells.elapsed, _wd_C_TEXT)),
        _wv_field("TOOLS", _wv_val("" if tools is None else str(tools), _wd_C_TEXT)),
        _wv_field("TOKENS", _wv_val("" if tokens is None else _wd_fmt_tok(tokens), _wd_C_TEXT)),
        _wv_field("CTX", _wv_val(_og_ctx_text(cells), _wd_ctx_color(ctx))),
        _wv_field("COST", cost),
        _wv_field("FLAGS", _wd_c(flags, _wd_C_AMBER) if flags else _wd_c("none", _wd_C_FAINT)),
    ]
    return _wv_wrap(fields, cols)


def _wv_spark(wk: Worker, t: float, cols: int) -> str:
    cells = min(_WV_SPARK_MAX, max(0, cols - 20))
    bins = _os_bins(wk.log.tool_pulses, t, cells, OS_SPAN_S)
    return _wd_fit(_wd_c("TOOLS/MIN ", _wd_C_DIM) + _os_spark(bins, cells) + _wd_c("  30m", _wd_C_FAINT), cols)


def _wv_why(reason: str, cols: int) -> str:
    if reason:
        return _os_why_line(_WV_WHY_CONT, reason, cols)
    return _wd_fit(_wd_c(_WV_WHY_CONT, _wd_C_BORDER) + _wd_c(_OS_WHY_LABEL, _wd_C_RED) + _wv_unknown(), cols)


def _wv_text(label: str, text: str, cols: int, lines: int) -> list[str]:
    """A labelled paragraph (the brief or the result), wrapped under the label and cut to `lines` lines."""
    text = _wd_clean(text)
    lead = len(label) + 1
    wrapped = _wd_wrap(text, max(10, cols - lead)) if text else []
    if not wrapped:
        return [_wd_fit(_wd_c(label + " ", _wd_C_DIM) + _wv_unknown(), cols)]
    out = []
    for i, line in enumerate(wrapped[:lines]):
        more = i == lines - 1 and len(wrapped) > lines
        out.append(_wd_fit((_wd_c(label + " ", _wd_C_DIM) if i == 0 else " " * lead)
                           + _wd_c(line + (" …" if more else ""), _wd_C_SUB), cols))
    return out


def _wv_entries(wk: Worker, t: float, cols: int) -> list[str]:
    """Every step line in order (newest last), each failed step followed by its why line."""
    steps = wk.log.steps
    if not steps:
        return [_wd_fit(_wd_c("  no steps recorded", _wd_C_FAINT), cols)]
    live = wk.state in LIVE_STATES
    reason = _os_why(wk)
    out: list[str] = []
    for i, step in enumerate(steps):
        out.append(_os_step_line(step, cols, t, live and i == len(steps) - 1))
        if step.outcome == "failed":
            out.append(_wv_why(reason, cols))
    return out


def _wv_entry_count(wk: Worker) -> int:
    return max(1, len(wk.log.steps) + sum(step.outcome == "failed" for step in wk.log.steps))


def _wv_page(stage: Stage, wk: Worker, ui: UIState, cols: int, rows: int, t: float) -> list[str]:
    """Exactly `rows` lines (the key line is drawn by the caller)."""
    if rows <= 0 or cols <= 0:
        return [""] * max(0, rows)
    cells = _og_worker_cells(wk, t)
    rule = _wd_c("─" * cols, _wd_C_BORDER)
    goal = _wd_clean(wk.goal)
    head = [_wv_crumb(stage, wk, t, cols), rule]
    head += _wv_identity(wk, cells.model, cols)
    head += _wv_metrics(wk, cells, cols)
    head.append(_wv_spark(wk, t, cols))
    head.append(rule)
    head.append(_wd_fit(_wd_c("GOAL ", _wd_C_DIM) + (_wd_c(_wd_trunc(goal, cols - 5), _wd_C_TEXT) if goal
                                                     else _wv_unknown()), cols))
    each = 4 if rows >= 28 else (2 if rows >= 20 else 0)   # how many lines the brief and the result get
    if each:
        head += _wv_text("BRIEF", " ".join(wk.brief_text), cols, each)
        result = " ".join(wk.result_text or wk.summary)
        head += _wv_text("RESULT", result, cols, each) if result or wk.state not in LIVE_STATES else []
    head.append("")
    head.append(_wd_fit(_wd_c("  " + "TIME".ljust(8) + "  " + "TOOL".ljust(6) + " " + "   "
                              + "DUR".rjust(7) + "  STEP", _wd_C_DIM), cols))
    entries = _wv_entries(wk, t, cols)
    room = max(0, rows - len(head))
    off = min(max(ui.scroll, 0), max(0, len(entries) - room))   # 0 = newest visible
    ui.scroll = off
    end = len(entries) - off
    window = entries[max(0, end - room):end] if room else []
    lines = (head + window)[:rows]
    lines += [""] * (rows - len(lines))
    return [_wd_fit(line, cols) for line in lines]


def _wv_key(ui: UIState, stage: Stage, wk: Worker, key: str, rows: int) -> str:
    """Handle a key on the worker page. Returns "" (used or ignored), or "brief" / "report" / "files" for the app to
    open that page with this worker selected. Esc/←/Backspace are handled by the caller."""
    if key == "b":
        return "brief"
    if key == "r":
        return "report"
    if key == "f":
        return "files"
    top = _wv_entry_count(wk)   # the page clamps the offset again when it draws
    page = max(rows - 8, 1)
    if key in ("up", "k"):
        ui.scroll = min(ui.scroll + 1, top)
    elif key in ("down", "j"):
        ui.scroll = max(ui.scroll - 1, 0)
    elif key == "pgup":
        ui.scroll = min(ui.scroll + page, top)
    elif key == "pgdn":
        ui.scroll = max(ui.scroll - page, 0)
    elif key == "home":
        ui.scroll = top
    elif key == "end":
        ui.scroll = 0
    return ""



# ──────────────────── sessionview ────────────────────
"""Ops console: the session page. Identity, metrics, TOOLS/MIN, goal, what the lead is doing, and every worker this
session spawned (only this session's: `stage.snap.workers`). Imports model, widgets and the ops* helpers only; render.py
draws the key line under it."""


SV_KEYS = (("↑↓", "scroll"), ("Enter", "worker"), ("Esc", "back"))

_SV_SPARK_MAX = 60
_SV_TEXT_LINES = 4          # most wrapped lines of the goal / brief
_SV_DOING = 6               # lead actions shown


def _sv_head(text: str) -> str:
    return _wd_c(text, _wd_C_DIM, bold=True)


def _sv_counts(workers: list[Worker]) -> tuple[int, int, int, int]:
    """(total, running, done, failed) over this session's workers."""
    running = sum(wk.state in LIVE_STATES for wk in workers)
    done = sum(wk.state == DONE for wk in workers)
    failed = sum(wk.state == FAILED for wk in workers)
    return len(workers), running, done, failed


def _sv_mark(wk: Worker, t: float) -> str:
    if wk.state in LIVE_STATES:
        return _wd_c(_wd_spinner(t), _wd_family_color(wk.family))
    if wk.state == DONE:
        return _wd_c("✔", _wd_C_GREEN)
    if wk.state == FAILED:
        return _wd_c("✖", _wd_C_RED)
    return _wd_c("◌", _wd_C_FAINT)


def _sv_crumb(stage: Stage, t: float, cols: int) -> str:
    sep = _wd_c(" › ", _wd_C_FAINT)
    project = _wd_clean(stage.label)
    name = _wd_clean(stage.display_name or stage.session_name) or stage.session_id[:8]
    left = _wd_c("◆ ", _wd_C_GREEN) + (_wd_c(_wd_trunc(project, cols // 3), _wd_C_MUTED) if project else _wv_unknown())
    left += sep + _wd_c(_wd_trunc(name or "session", cols // 2), _wd_C_TEXT, bold=True)
    state = {"active": "live", "idle": "idle", "closed": "closed"}.get(stage.state, stage.state or "—")
    right = (_wd_c(stage.level_tag or ("LEAD" if not stage.parent else "SPAWN"), _wd_C_DIM) + _wd_c(" · ", _wd_C_FAINT)
             + _wd_c(state, _wd_C_GREEN if state == "live" else _wd_C_MUTED) + _wd_c(" · ", _wd_C_FAINT)
             + _wd_c(_wd_fmt_clock(t, seconds=True), _wd_C_DIM))
    return _wd_lr(left, right, cols)


def _sv_identity(stage: Stage, model: str, cols: int) -> list[str]:
    fields = [
        _wv_field("MODEL", _wv_val(model, _wd_C_TEXT)),
        _wv_field("HARNESS", _wv_val(_wd_clean(stage.lead_kind or stage.tag))),
        _wv_field("ACCOUNT", _wv_val(_wd_clean(stage.account))),
        _wv_field("PID", _wv_val(str(stage.lead_pid) if stage.lead_pid else "")),
        _wv_field("TMUX", _wv_val(_wd_clean(stage.tmux))),
        _wv_field("DIR", _wv_val(_wd_clean(stage.cwd or stage.dir))),
    ]
    return _wv_wrap(fields, cols)


def _sv_metrics(stage: Stage, cells: object, cols: int) -> list[str]:
    cost = getattr(cells, "cost", None)
    cost_txt = (_wd_c(_wd_fmt_money(cost), _wd_C_SUB) if cost is not None
                else _wd_c("— " + ("local" if getattr(cells, "cost_note", "") == "local" else "sub"), _wd_C_FAINT))
    tools = getattr(cells, "tools", None)
    tokens = getattr(cells, "tokens", None)
    ctx = getattr(cells, "ctx_pct", None)
    fields = [
        _wv_field("ELAPSED", _wv_val(cells.elapsed, _wd_C_TEXT)),
        _wv_field("TOOLS", _wv_val("" if tools is None else str(tools), _wd_C_TEXT)),
        _wv_field("TOKENS", _wv_val("" if tokens is None else _wd_fmt_tok(tokens), _wd_C_TEXT)),
        _wv_field("CTX", _wv_val(_og_ctx_text(cells), _wd_ctx_color(ctx))),
        _wv_field("COST", cost_txt),
    ]
    return _wv_wrap(fields, cols)


def _sv_workers_line(stage: Stage, cols: int) -> str:
    total, running, done, failed = _sv_counts(stage.snap.workers)
    parts = [_wd_c("WORKERS ", _wd_C_DIM), _wd_c(f"{total} spawned", _wd_C_TEXT, bold=True)]
    parts.append(_wd_c(f"  {running} running", _wd_C_GREEN if running else _wd_C_FAINT))
    parts.append(_wd_c(f"  {done} done", _wd_C_SUB if done else _wd_C_FAINT))
    parts.append(_wd_c(f"  {failed} failed", _wd_C_RED if failed else _wd_C_FAINT))
    if stage.snap.groups:
        parts.append(_wd_c(f"  {len(stage.snap.groups)} batches", _wd_C_MUTED))
    return _wd_fit("".join(parts), cols)


def _sv_spark(stage: Stage, t: float, cols: int) -> str:
    cells = min(_SV_SPARK_MAX, max(0, cols - 20))
    bins = _os_bins(stage.lead_tool_pulses, t, cells, OS_SPAN_S)
    return _wd_fit(_wd_c("TOOLS/MIN ", _wd_C_DIM) + _os_spark(bins, cells) + _wd_c("  30m", _wd_C_FAINT), cols)


def _sv_text_block(label: str, text: str, cols: int, lines: int = _SV_TEXT_LINES) -> list[str]:
    """A labelled paragraph wrapped under the label, cut to `lines` lines with a `…` when longer."""
    width = max(10, cols - len(label) - 1)
    wrapped = _wd_wrap(text, width) if text.strip() else []
    if not wrapped:
        return [_wd_fit(_wd_c(label + " ", _wd_C_DIM) + _wv_unknown(), cols)]
    out = []
    for i, line in enumerate(wrapped[:lines]):
        last = i == lines - 1 and len(wrapped) > lines
        out.append(_wd_fit((_wd_c(label + " ", _wd_C_DIM) if i == 0 else " " * (len(label) + 1))
                           + _wd_c(line + (" …" if last else ""), _wd_C_TEXT), cols))
    return out


def _sv_doing(stage: Stage, t: float, cols: int) -> list[str]:
    if not stage.doing:
        return []
    out = [_sv_head("LEAD ACTIVITY")]
    for stamp, text in reversed(stage.doing[-_SV_DOING:]):
        age = _og_age(max(0.0, t - stamp)) if stamp else ""
        out.append(_wd_fit("  " + _wd_c(_wd_pad(age, 5), _wd_C_FAINT) + " " + _wd_c(_wd_clean(text), _wd_C_SUB), cols))
    return out


def _sv_changes(stage: Stage, cols: int) -> list[str]:
    work = stage.work
    if work is None or not (work.branch or work.dirty or work.ahead or work.unmerged):
        return []
    badge = work.badge()
    text = _wd_c(work.branch or "—", _wd_C_TEXT) + (_wd_c("  ● " + badge, _wd_C_AMBER) if badge else
                                                    _wd_c("  clean", _wd_C_FAINT))
    return [_wd_fit(_wd_c("GIT ", _wd_C_DIM) + text, cols)]


def _sv_worker_line(wk: Worker, selected: bool, t: float, cols: int) -> str:
    cells = _og_worker_cells(wk, t)
    state = wk.state or "—"
    name_w = max(12, min(30, cols // 4))
    left = (_wd_c("▸ " if selected else "  ", _wd_C_TEXT) + _sv_mark(wk, t) + " "
            + _wd_c(_wd_pad(_wd_trunc(_wd_clean(wk.name), name_w), name_w), _wd_C_TEXT, bold=selected) + " "
            + _wd_c(_wd_pad(_wd_trunc(cells.model or "—", 16), 16), _wd_C_SUB) + " "
            + _wd_c(_wd_pad(state, 9), _WV_STATE_COL.get(wk.state, _wd_C_MUTED)) + " "
            + _wd_c(_wd_pad(cells.elapsed or "—", 8), _wd_C_MUTED))
    tools = "" if cells.tools is None else f"{cells.tools}t"
    left += " " + _wd_c(_wd_pad(tools or "—", 5), _wd_C_MUTED) + " "
    room = max(0, cols - _wd_width(left))
    goal = _wd_clean(wk.goal or wk.title or (wk.summary[0] if wk.summary else ""))
    line = left + _wd_c(_wd_trunc(goal, room), _wd_C_FAINT)
    return _wd_fit(line, cols)


def _sv_worker_rows(stage: Stage, sel: int, t: float, cols: int) -> list[str]:
    head = _wd_fit(_wd_c("  " + "  " + "WORKER".ljust(max(12, min(30, cols // 4))) + " " + "MODEL".ljust(16) + " "
                         + "STATE".ljust(9) + " " + "ELAPSED".ljust(8) + " " + "TOOLS".ljust(5) + " GOAL", _wd_C_DIM), cols)
    workers = stage.snap.workers
    if not workers:
        return [head, _wd_fit(_wd_c("  this session has spawned no workers", _wd_C_FAINT), cols)]
    return [head] + [_sv_worker_line(wk, i == sel, t, cols) for i, wk in enumerate(workers)]


def _sv_sel(ui: UIState, stage: Stage) -> int:
    return min(max(ui.sel, 0), max(0, len(stage.snap.workers) - 1))


def _sv_page(stage: Stage, ui: UIState, cols: int, rows: int, t: float) -> list[str]:
    """Exactly `rows` lines (the key line is drawn by the caller)."""
    if rows <= 0 or cols <= 0:
        return [""] * max(0, rows)
    cells = _og_stage_cells(stage, t)
    rule = _wd_c("─" * cols, _wd_C_BORDER)
    head = [_sv_crumb(stage, t, cols), rule]
    head += _sv_identity(stage, cells.model, cols)
    head += _sv_metrics(stage, cells, cols)
    head.append(_sv_workers_line(stage, cols))
    head.append(_sv_spark(stage, t, cols))
    head += _sv_changes(stage, cols)
    head.append(rule)
    goal = _wd_clean(stage.goal) or _wd_clean(stage.snap.title)
    head += _sv_text_block("GOAL", goal, cols)
    if stage.brief_text and not stage.goal:
        head += _sv_text_block("BRIEF", " ".join(stage.brief_text), cols)
    extra = _sv_doing(stage, t, cols)
    if stage.snap.milestones:
        extra.append(_sv_head("MILESTONES"))
        for ms in reversed(stage.snap.milestones[-3:]):
            stamp = _wd_fmt_clock(ms.ts) if ms.ts is not None else "     "
            extra.append(_wd_fit("  " + _wd_c(stamp + " ", _wd_C_FAINT) + _wd_c(_wd_clean(ms.text), _wd_C_SUB), cols))
    body = extra + ([""] if extra else []) + [_sv_head("WORKERS THIS SESSION")] + _sv_worker_rows(stage, _sv_sel(ui, stage), t, cols)
    room = max(0, rows - len(head) - 1)
    sel_line = len(body) - len(stage.snap.workers) + _sv_sel(ui, stage) if stage.snap.workers else 0
    off = max(0, min(sel_line - room + 1, max(0, len(body) - room))) if sel_line >= room else 0   # keep the cursor in view
    lines = head + [""] + body[off:off + room]
    ui.hits.append((0, 0, 0, max(0, cols // 2), "back", ""))   # the crumb goes back to the tree
    first = len(body) - len(stage.snap.workers)
    for i in range(len(stage.snap.workers)):   # a click picks a worker, a double click opens its page
        if off <= first + i < off + room:
            y = len(head) + 1 + first + i - off
            ui.hits.append((y, y, 0, cols - 1, "svw", str(i)))
    lines = lines[:rows]
    lines += [""] * (rows - len(lines))
    return [_wd_fit(line, cols) for line in lines]


def _sv_key(ui: UIState, stage: Stage, key: str, rows: int) -> str:
    """Keys on the session page. Returns "" (used or ignored) or "worker:<name>" to open that worker's page."""
    count = len(stage.snap.workers)
    ui.sel = _sv_sel(ui, stage)
    if key in ("up", "k"):
        ui.sel = max(0, ui.sel - 1)
    elif key in ("down", "j"):
        ui.sel = min(max(0, count - 1), ui.sel + 1)
    elif key == "pgup":
        ui.sel = max(0, ui.sel - max(rows - 8, 1))
    elif key == "pgdn":
        ui.sel = min(max(0, count - 1), ui.sel + max(rows - 8, 1))
    elif key == "home":
        ui.sel = 0
    elif key == "end":
        ui.sel = max(0, count - 1)
    elif key in ("enter", "space", "o", "right", "l") and count:
        return "worker:" + stage.snap.workers[ui.sel].name
    return ""



