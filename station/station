# ──────────────────── usageview ────────────────────
"""The usage screen (u): one table row per account, the selected account opened, credit and OpenRouter below.

Pure drawing: takes the quota data and a cursor, returns lines. Imports only widgets and model so render can call it.
"""



_UV_ON_PACE = 5.0          # points either side of pace that still read as "on pace"
_UV_WIN_SECS = {"five_hour": 5 * 3600, "seven_day": 7 * 86400, "thirty_day": 30 * 86400}


def _uv_plain() -> bool:
    return os.environ.get("NO_COLOR") is not None


def _uv_c(text: str, fg: tuple[int, int, int] | None = None, bold: bool = False) -> str:
    return text if _uv_plain() else _wd_c(text, fg, bold=bold)


def _uv_pct_mark(used: float, stale: bool) -> str:
    """Plain cue for quota bands when colour is off (matches _wd_QUOTA_STOPS thresholds)."""
    if stale:
        return ""
    if used >= 100.0:
        return " cap"
    if used >= 90.0:
        return " high"
    if used >= 70.0:
        return " warn"
    return ""


def _uv_spark_plain(values: list[float], width: int, vmax: float) -> str:
    vals = [0.0] * max(0, width - len(values)) + list(values)[-width:]
    return "".join(_wd_SPARK[min(lv, 7)] if lv > 0 else "_" for lv in _wd_levels(vals, vmax))


def _uv_ttr(resets_at: float | None, now: float) -> str:
    """Time to reset, two units at most: 2h14m, 3d4h, 45m."""
    if resets_at is None:
        return ""
    secs = resets_at - now
    if secs <= 0:
        return "now"
    mins = int(secs // 60)
    if mins < 1:
        return "<1m"
    if mins < 60:
        return f"{mins}m"
    hours, rem = divmod(mins, 60)
    if hours < 24:
        return f"{hours}h" + (f"{rem}m" if rem else "")
    days, hrem = divmod(hours, 24)
    return f"{days}d" + (f"{hrem}h" if hrem else "")


def _uv_winner(acct: QuotaAccount) -> QuotaWindow | None:
    """The window that binds the account: a capped one, else the earliest projected run-out, else the fullest."""
    wins = acct.windows
    if not wins:
        return None
    capped = [w for w in wins if w.used >= 100.0]
    if capped:
        return max(capped, key=lambda w: w.used)
    proj = [w for w in wins if w.runs_out_at is not None]
    if proj:
        return min(proj, key=lambda w: w.runs_out_at or 0.0)
    return max(wins, key=lambda w: (w.used, -_UV_WIN_SECS.get(w.window, 7 * 86400)))


def _uv_verdict(win: QuotaWindow, now: float) -> tuple[str, tuple[int, int, int]]:
    """Plain words for how the burn compares with an even spend: (text, colour)."""
    if win.used >= 100.0:
        return "capped", _wd_C_RED
    if win.runs_out_at is not None and win.runs_out_at > now:
        return "out in " + _uv_ttr(win.runs_out_at, now), _wd_C_RED
    if win.pace is None or win.used < 1.0:
        return "", _wd_C_MUTED
    delta = win.used - win.pace
    if delta > _UV_ON_PACE:
        return f"{delta:.0f} over pace", _wd_C_AMBER
    if delta < -_UV_ON_PACE:
        return f"{-delta:.0f} under pace", _wd_C_GREEN
    return "on pace", _wd_C_MUTED


def _uv_pct(used: float, stale: bool) -> str:
    txt = f"{min(max(used, 0), 999):.0f}%".rjust(4)
    mark = _uv_pct_mark(used, stale)
    if _uv_plain():
        return txt + mark
    return _wd_c(txt, _wd_C_DIM if stale else _wd_pct_color(used))


def _uv_bar(win: QuotaWindow, bw: int, stale: bool) -> str:
    if bw <= 0:
        return ""
    if _uv_plain():
        frac = min(max(win.used / 100.0, 0.0), 1.0)
        full = min(bw, int(frac * bw + 0.999))
        pace = None if win.pace is None else win.pace / 100.0
        tick = -1
        if pace is not None:
            tick = min(bw - 1, max(0, int(min(max(pace, 0.0), 1.0) * bw)))
        fill = "#" if stale else "="
        out: list[str] = []
        for i in range(bw):
            if i == tick:
                out.append("|")
            elif i < full:
                out.append(fill)
            else:
                out.append(".")
        return "".join(out)
    pace = None if win.pace is None else win.pace / 100.0
    return _wd_bar(win.used / 100.0, bw, lambda x: _wd_pct_color(x * 100), pace, _wd_C_DIM if stale else None)


def _uv_rank(name: str) -> int:
    """your order: claude, codex, cursor, opencode, then claude-work, then the rest."""
    n = name.lower()
    if n == "claude":
        return 0
    if n == "codex":
        return 1
    if n.startswith("cursor"):
        return 2
    if n.startswith("opencode"):
        return 3
    if n == "claude-work":
        return 4
    return 5


def _uv_groups(accounts: list[QuotaAccount], spend_shown: set[str]) -> tuple[list[QuotaAccount], list[QuotaAccount], list[str]]:
    """(accounts with windows, credit accounts, names with nothing to show). Same-name duplicates collapse."""
    credit_names = {a.name for a in accounts if a.credit is not None}
    live: list[QuotaAccount] = []
    credit: list[QuotaAccount] = []
    quiet: list[str] = []
    seen: set[str] = set()
    for a in accounts:
        if a.credit is not None:
            if a.name in spend_shown:
                continue    # a spend block below carries it
            credit.append(a)
            continue
        if a.windows and not a.stale:
            live.append(a)
        elif a.name in credit_names or a.name in seen:
            continue        # a windowless twin of a credit account
        else:
            quiet.append(_wd_clean(a.name))
        seen.add(a.name)
    live.sort(key=lambda a: (_uv_rank(a.name), a.name))
    return live, credit, quiet


def _uv_credit_text(a: QuotaAccount) -> tuple[str, bool]:
    c = a.credit
    if c is None or c.balance is None:
        return "no balance", False
    txt = f"${c.balance:.2f} left"
    if c.burn_per_day:
        txt += f" · ${c.burn_per_day:.2f}/day"
    if c.runs_out_at:
        txt += " · out " + time.strftime("%b %d", time.localtime(c.runs_out_at))
    return txt, c.low


def _uv_spend(snap: SpendSnapshot, iw: int) -> list[str]:
    head = ""
    if snap.balance is None:
        if snap.month_to_date_usd is not None:
            head += _uv_c(f"${snap.month_to_date_usd:.2f} mtd", _wd_C_TEXT, bold=True)
        else:
            head += _uv_c("no balance recorded", _wd_C_MUTED)
    else:
        head += _uv_c(f"${snap.balance:.2f}", _wd_C_RED if snap.low else _wd_C_TEXT, bold=True)
        if snap.low and _uv_plain():
            head += " LOW"
        bits = []
        if snap.burn_per_day is not None:
            bits.append(f"${snap.burn_per_day:.2f}/day")
        if snap.runs_out_at:
            bits.append("out " + time.strftime("%b %d", time.localtime(snap.runs_out_at)))
        if snap.floor_usd is not None:
            bits.append(f"floor ${snap.floor_usd:.2f}")
        if bits:
            head += "  " + _uv_c(" · ".join(bits), _wd_C_MUTED)
    if snap.stale:
        head += _uv_c("  stale", _wd_C_DIM)
    out = [head]
    days = sorted(snap.per_day, key=lambda r: r.date)
    if days:
        today = days[-1]
        prev = days[-2] if len(days) > 1 else None
        txt = f"today ${today.usd:.2f} · {today.requests} req"
        if prev is not None:
            txt += f" (yesterday ${prev.usd:.2f})"
        spark_vals = [r.usd for r in days[-14:]]
        spark_w = min(len(days), 14)
        spark = (_uv_spark_plain(spark_vals, spark_w, max(max(spark_vals), 1.0)) if _uv_plain()
                 else _wd_c(_wd_spark(spark_vals, spark_w), _wd_C_SUB))
        out.append("  " + spark + "  " + _uv_c(txt, _wd_C_MUTED))
    total = sum(r.usd for r in snap.per_model)
    top = sorted(snap.per_model, key=lambda r: -r.usd)[:3]
    if top and total > 0:
        out.append("  " + _uv_c(_wd_trunc("top  " + " · ".join(f"{r.model.split('/')[-1]} {100 * r.usd / total:.0f}%" for r in top), iw - 2), _wd_C_DIM))
    return out


def _uv_rule(title: str, note: str, iw: int) -> str:
    """Section header: TITLE ─────── note."""
    head = _uv_c(title, _wd_C_BLUE, bold=True)
    tail = _uv_c(note, _wd_C_DIM) if note else ""
    fill = max(2, iw - _wd_width(title) - _wd_width(note) - (3 if note else 1))
    return head + " " + _uv_c("─" * fill, _wd_C_DIM) + (" " + tail if tail else "")


def _uv_block(a: QuotaAccount, bw: int, iw: int, now: float, hist: list[float] | None, spark: bool = True) -> list[str]:
    """One subscription: its name and verdict, then one bar per window, then a blank line."""
    bind = _uv_winner(a)
    text, col = _uv_verdict(bind, now) if bind is not None else ("", _wd_C_MUTED)
    if bind is not None and not text:
        text = "fine"
    dot = ("* " if a.in_use else "o ") if _uv_plain() else _wd_c("● ", _wd_C_BLUE if a.in_use else _wd_C_DIM)
    left = dot + _uv_c(_wd_clean(a.name), _wd_C_TEXT, bold=True)
    if a.in_use:
        left += _uv_c("  in use", _wd_C_DIM)
    right = _uv_c(text, col)
    if a.extra is not None:
        right += _uv_c("   +$" + (f"{a.extra.usd:.2f}" if a.extra.usd is not None else "?") + " past cap", _wd_C_RED, bold=True)
    out = [_wd_lr(left, right, iw, 2)]
    lw = max([9] + [_wd_width(w.name) + 1 for w in a.windows])
    ordered = sorted(a.windows, key=lambda x: _UV_WIN_SECS.get(x.window, 7 * 86400))
    for w in ordered:
        row = ("    " + _uv_c(_wd_pad(w.name, lw), _wd_C_MUTED) + _uv_bar(w, bw, w.stale) + " " + _uv_pct(w.used, w.stale)
               + "   " + _uv_c(_wd_pad("resets " + _uv_ttr(w.resets_at, now), 15), _wd_C_MUTED))
        if w.projected_pct is not None and w.projected_pct > w.used + 1:
            proj = f"heading to {w.projected_pct:.0f}%"
            if _uv_plain() and w.projected_pct >= 100:
                proj += " !"
            row += _uv_c(proj, _wd_C_RED if w.projected_pct >= 100 else _wd_C_DIM)
        out.append(row.rstrip())
    if spark and hist and len(hist) >= 2 and iw >= 70:
        spark_w = min(len(hist), bw)
        vmax = max(max(hist), 10.0)
        spark = (_uv_spark_plain(hist, spark_w, vmax) if _uv_plain()
                 else _wd_c(_wd_spark(hist, spark_w, vmax), _wd_C_SUB))
        out.append("    " + _uv_c(_wd_pad("last 24h", lw), _wd_C_MUTED) + spark
                   + _uv_c(f"   low {min(hist):.0f}% · high {max(hist):.0f}%", _wd_C_DIM))
    return out


def _uv_two_up(blocks: list[list[str]], cw: int) -> list[str]:
    """Blocks laid out in two columns, left then right, row by row."""
    out: list[str] = []
    for i in range(0, len(blocks), 2):
        left = blocks[i]
        right = blocks[i + 1] if i + 1 < len(blocks) else []
        for k in range(max(len(left), len(right))):
            l_cell = left[k] if k < len(left) else ""
            r_cell = right[k] if k < len(right) else ""
            out.append(_wd_pad(l_cell, cw) + "   " + r_cell)
        out.append("")
    return out


_UV_NO_SOURCES = "no usage data: no quota or spend command answered"
_UV_NO_SOURCES_HINT = "set STATUS_QUOTA_CMD, STATUS_OPENROUTER_CMD or STATUS_OPENAI_CMD"
_UV_QUOTA_DOWN = "quota unavailable (STATUS_QUOTA_CMD missing or not answering)"


def _uv_merge_spend(openrouter: SpendSnapshot | None, openrouter_ok: bool,
                    spend: dict[str, SpendSnapshot] | None, spend_ok: dict[str, bool] | None) -> tuple[dict[str, SpendSnapshot], dict[str, bool]]:
    merged: dict[str, SpendSnapshot] = dict(spend or {})
    ok: dict[str, bool] = dict(spend_ok or {})
    if openrouter is not None:
        merged.setdefault(OPENROUTER_ACCOUNT, openrouter)
    if openrouter_ok:
        ok[OPENROUTER_ACCOUNT] = True
    return merged, ok


def usage_lines(quota: list[QuotaAccount], quota_ok: bool, openrouter: SpendSnapshot | None,
                openrouter_ok: bool, sel: int, iw: int, now: float,
                history: dict[str, list[float]] | None = None, spark: bool = True, two_up: bool = False,
                airy: bool = True, spend: dict[str, SpendSnapshot] | None = None,
                spend_ok: dict[str, bool] | None = None) -> tuple[list[str], int, int]:
    """(body lines, 0, number of subscriptions). Every subscription is a block with all its windows; the
    concerns are separate labelled sections: subscriptions, API credits, OpenRouter, no live data."""
    history = history or {}
    spend_map, spend_ok_map = _uv_merge_spend(openrouter, openrouter_ok, spend, spend_ok)
    spend_shown = {pid for pid in SPEND_PROVIDER_ORDER if spend_ok_map.get(pid) and spend_map.get(pid)}
    if not quota_ok and not spend_shown:
        return [_uv_c(_UV_NO_SOURCES, _wd_C_DIM), _uv_c(_UV_NO_SOURCES_HINT, _wd_C_DIM)], 0, 0
    # Spend comes from its own commands, so a missing or failing quota command only drops the subscription sections.
    live, credit, quiet = _uv_groups(quota if quota_ok else [], spend_shown)
    nw = max((_wd_width(_wd_clean(a.name)) for a in credit), default=6)
    cw = (iw - 3) // 2 if two_up else iw
    bw = min(max(cw - (4 + 12 + 1 + 4 + 3 + 15 + 18), 10), 44)
    gap = [""] if airy else []
    lines: list[str] = []
    if quota_ok:
        lines += [_uv_rule("SUBSCRIPTIONS", f"{len(live)} live", iw)] + gap
        blocks = [_uv_block(a, bw, cw, now, history.get(a.name), spark) for a in live]
        if two_up:
            lines += _uv_two_up(blocks, cw)
        else:
            for blk in blocks:
                lines += blk + [""]
        if not live:
            lines += [_uv_c("  none reporting", _wd_C_DIM), ""]
    else:
        lines += [_uv_rule("SUBSCRIPTIONS", "unavailable", iw)] + gap + [_uv_c("  " + _UV_QUOTA_DOWN, _wd_C_DIM), ""]
    if credit:
        lines += [_uv_rule("API CREDITS", "", iw)] + gap
        for a in credit:
            txt, low = _uv_credit_text(a)
            lines.append("  " + _uv_c(_wd_pad(_wd_trunc(_wd_clean(a.name), nw), nw), _wd_C_TEXT, bold=True) + "   "
                         + (_uv_c(txt + " LOW", _wd_C_RED, bold=True) if low else _uv_c(txt, _wd_C_MUTED)))
        lines.append("")
    for pid in SPEND_PROVIDER_ORDER:
        snap = spend_map.get(pid)
        if not spend_ok_map.get(pid) or snap is None:
            continue
        title = pid.upper() if pid != OPENAI_ACCOUNT else "OPENAI"
        lines += [_uv_rule(title, "", iw)] + gap + ["  " + x for x in _uv_spend(snap, iw - 2)] + [""]
    if quiet:
        lines += [_uv_rule("NO LIVE DATA", "", iw)] + gap + ["  " + _uv_c(_wd_trunc("  ·  ".join(quiet), iw - 2), _wd_C_DIM)]
    while lines and not lines[-1]:
        lines.pop()
    return lines, 0, len(live)


def usage_screen(quota: list[QuotaAccount], quota_ok: bool, openrouter: SpendSnapshot | None,
                 openrouter_ok: bool, scroll: int, cols: int, rows: int, now: float,
                 history: dict[str, list[float]] | None = None,
                 spend: dict[str, SpendSnapshot] | None = None,
                 spend_ok: dict[str, bool] | None = None) -> list[str]:
    """The boxed screen, `rows` tall; `scroll` is the first line shown when the content is still too tall."""
    iw, ih = cols - 4, rows - 2
    # Step down until it fits: airy, tight, two columns (wide only), no sparklines, no sparklines in two columns.
    steps = [(True, False, True), (True, False, False)]
    if iw >= 120:
        steps.append((True, True, False))
    steps.append((False, False, False))
    if iw >= 120:
        steps.append((False, True, False))
    lines: list[str] = []
    for spark, two_up, airy in steps:
        lines, _at, _n = usage_lines(quota, quota_ok, openrouter, openrouter_ok, 0, iw, now, history, spark, two_up, airy,
                                     spend=spend, spend_ok=spend_ok)
        if len(lines) <= ih:
            break
    first = min(max(int(scroll), 0), max(0, len(lines) - ih))
    body = lines[first:first + ih]
    boxed = _wd_box([" " + x for x in body], cols, rows, _uv_c("usage", _wd_C_BLUE, bold=True),
                    thumb=_wd_thumb(len(lines), ih, first))
    if _uv_plain():
        return [_wd_SGR_RE.sub("", line) for line in boxed]
    return boxed



# ──────────────────── opsspark ────────────────────
"""Ops console: tools/min sparklines, step lines and failure reasons (R4/R5). Pure text helpers; imports model and
widgets only, never render or app."""



OS_SPAN_S = 1800      # the sparkline covers the last 30 minutes
OS_CELLS = 15         # 2 minutes per cell on a session row

_OS_SPARK_CHARS = "▁▂▃▄▅▆▇█"
_OS_STEP_HEAD_W = 31  # cells before the step text: indent, time, tool, outcome, duration
_OS_WHY_LABEL = "  why "


def _os_bins(pulses: list[tuple[float, int]], now: float, cells: int = OS_CELLS, span: float = OS_SPAN_S) -> list[int]:
    """Tool calls per cell over the last `span` seconds, oldest cell first."""
    if cells <= 0:
        return []
    out = [0] * cells
    start = now - span
    for ts, n in pulses:
        if not start < ts <= now:
            continue
        idx = min(cells - 1, int((ts - start) * cells / span))
        out[idx] += n
    return out


def _os_spark(values: list[int], cells: int) -> str:
    """`▁…█` from the values (TEAL→BLUE→CYAN by height), zero as a FAINT `·`; exactly `cells` wide."""
    if cells <= 0:
        return ""
    vals = list(values)[-cells:]
    vals = [0] * (cells - len(vals)) + vals
    top = max(vals, default=0)
    if top <= 0:
        top = 1
    out: list[str] = []
    for v in vals:
        if v <= 0:
            out.append(_wd_c("·", _wd_C_FAINT))
            continue
        i = min(7, max(0, round(v / top * 7)))
        col = _wd_C_CYAN if i >= 6 else _wd_C_BLUE if i >= 3 else _wd_C_TEAL
        out.append(_wd_c(_OS_SPARK_CHARS[i], col))
    return "".join(out)


def _os_tools_spark(pulses: list[tuple[float, int]], now: float, cells: int = OS_CELLS) -> str:
    """The TOOLS/MIN cell: bins then spark."""
    return _os_spark(_os_bins(pulses, now, cells), cells)


def _os_clock(ts: float) -> str:
    """Local HH:MM:SS, or dashes when the log carried no time."""
    if not ts > 0:
        return "--:--:--"
    try:
        return time.strftime("%H:%M:%S", time.localtime(ts))
    except (OverflowError, OSError, ValueError):
        return "--:--:--"


def _os_dur(dur: float | None) -> str:
    """`<0.1s` under a tenth of a second, blank when unknown."""
    if dur is None or not math.isfinite(dur):
        return ""
    if dur < 0.1:
        return "<0.1s"
    return _wd_fmt_dur(dur)


def _os_outcome(step: Step, live: bool, now: float) -> str:
    """ok / ✖ / spinner for a running step / blank; always 3 cells."""
    if step.outcome == "ok":
        return _wd_c("ok ", _wd_C_GREEN)
    if step.outcome == "failed":
        return _wd_c("✖  ", _wd_C_RED)
    if live and not step.outcome:
        return _wd_c(_wd_spinner(now) + "  ", _wd_C_BLUE)
    return "   "


def _os_step_line(step: Step, w: int, now: float, live: bool = False) -> str:
    """One step row: `TIME  TOOL ok DUR  STEP` (ok / ✖ / spinner while running); exactly fits `w`."""
    tool = step.tool if step.kind == "tool" and step.tool else step.kind
    dur_col = _wd_C_AMBER if step.dur is not None and step.dur >= 60 else _wd_C_MUTED
    head = ("  " + _wd_c(_os_clock(step.ts), _wd_C_FAINT) + "  "
            + _wd_c(_wd_pad(_wd_trunc(tool, 6), 6), _wd_C_BLUE) + " "
            + _os_outcome(step, live, now)
            + _wd_c(_os_dur(step.dur).rjust(7), dur_col) + "  ")
    text = _wd_c(_wd_trunc(step.text, w - _OS_STEP_HEAD_W), _wd_C_SUB)
    return _wd_fit(head + text, w)


def _os_why(wk: Worker) -> str:
    """The failure reason for a `why` sub-line, "" when there is none."""
    if wk.failure:
        return wk.failure
    if (wk.state or "").lower() != FAILED:
        return ""
    for step in reversed(wk.log.steps):
        if step.kind == "error":
            return step.text
    return ""


def _os_why_line(cont: str, text: str, w: int) -> str:
    """`<cont>  why <reason>`: RED label, SUB reason, cut to `w`."""
    head = _wd_c(cont, _wd_C_BORDER) + _wd_c(_OS_WHY_LABEL, _wd_C_RED)
    reason = _wd_c(_wd_trunc(text, w - _wd_width(cont) - _wd_width(_OS_WHY_LABEL)), _wd_C_SUB)
    return _wd_fit(head + reason, w)



# ──────────────────── opstree ────────────────────
"""Ops console: box-drawing tree prefixes and level tags (R2). Pure text helpers; imports model and widgets only."""


OT_TAGS = ("LEAD", "SPAWN", "SUB", "WORKER", "CRON")

_OT_TAG_COLOUR = {"LEAD": _wd_C_SUB, "SPAWN": _wd_C_VIOLET, "SUB": _wd_C_TEAL, "WORKER": _wd_C_DIM, "CRON": _wd_C_BLUE}
_OT_TAG_SHORT = {"LEAD": "LEAD", "SPAWN": "SPWN", "SUB": "SUB", "WORKER": "WRKR", "CRON": "CRON"}


def _ot_prefixes(depths: list[int]) -> list[tuple[str, str]]:
    """For nodes listed in tree order with their depth (0 = a child of the project heading), each node's
    (prefix, continuation): the prefix draws `├─ ` / `└─ ` after `│  ` or `   ` for every open ancestor level; the
    continuation is the same width for the node's sub-lines (`│  ` where a later sibling follows, else spaces)."""
    levels: list[int] = []
    prev = -1
    for d in depths:
        prev = max(0, min(d, prev + 1))     # a jump deeper than one level counts as one level
        levels.append(prev)
    n = len(levels)
    last = [True] * n
    for i, d in enumerate(levels):
        for j in range(i + 1, n):
            if levels[j] <= d:
                last[i] = levels[j] < d
                break
    out: list[tuple[str, str]] = []
    open_: list[int] = []                   # open ancestor index at each level
    for i, d in enumerate(levels):
        del open_[d:]
        ancestors = "".join("│  " if not last[a] else "   " for a in open_)
        kids = i + 1 < n and levels[i + 1] > d
        tail = "│  " if (not last[i] or kids) else "   "
        out.append((ancestors + ("└─ " if last[i] else "├─ "), ancestors + tail))
        open_.append(i)
    return out


def _ot_tag(tag: str, short: bool) -> str:
    """The level tag cell, coloured by role, fixed width (6, or 4 with short names when `short`); blank when no tag."""
    width = 4 if short else 6
    if tag not in _OT_TAG_COLOUR:
        return " " * width
    text = _OT_TAG_SHORT[tag] if short else tag
    return _wd_c(text.ljust(width), _OT_TAG_COLOUR[tag])



# ──────────────────── opsgrid ────────────────────
"""Ops console: the width plan, metric cells and row/heading lines (R1). Pure text helpers; imports model, widgets,
opsspark and opstree only. The width plan lives here and nowhere else."""



# Metric columns left to right: (key, width). One list drives the plan, the header, every row and the project totals,
# so a header cell and its data can never drift apart. A narrow width drops columns in _OG_DROP order.
_OG_NAME_MIN = 20     # the name column never gets less than this (a session's name is the point of the row)
_OG_TAIL_NAME = 3      # a row keeps at least this much of its name before a tail may take the rest of the name column
_OG_DROP = ("spark", "tools", "tokens", "tag", "harn", "ctx", "cost")   # model and elapsed are the last to go (phone rule)
_OG_PHONE_COLS = 90
_OG_EMPTY_METRICS = ("ctx", "cost", "tokens", "tools")   # may hide on a phone when every drawn row is empty
_OG_WIDE_COLS = 190
_OG_HEAD_NAME = 28
_OG_HEAD_NAME_WIDE = 56   # project titles may use more of the line when the terminal is very wide


@dataclass
class _og_Plan:
    """Which columns a width shows, and their widths (spec section 2)."""
    cols: int
    spark: bool = False
    tools: bool = False
    tokens: bool = False
    short: bool = False      # 4-letter level tags
    tag_w: int = 6
    model_w: int = 16
    fixed: int = 0           # width of everything right of the name column, the 2-cell gutter included
    control_center: bool = False
    hidden: set[str] = field(default_factory=set)   # columns a narrow width dropped

    def columns(self) -> list[tuple[str, int]]:
        """The shown metric columns, left to right."""
        every = [("tag", self.tag_w), ("harn", 5), ("model", self.model_w), ("ctx", 4), ("tokens", 6), ("cost", 6),
                 ("elapsed", 7), ("tools", 5), ("spark", 15)]
        return [(key, width) for key, width in every if key not in self.hidden]

    @property
    def name_w(self) -> int:
        """Cells of the name column (gutter excluded)."""
        return max(0, self.cols - self.fixed)


@dataclass
class _og_Cells:
    """One row's metric values, unformatted. None = unknown (drawn as a FAINT `—`)."""
    tag: str = ""
    harn: str = ""
    model: str = ""
    ctx_pct: int | None = None
    ctx_tokens: int | None = None     # the context size itself; the CTX cell shows it, coloured by ctx_pct
    ctx_limit: int | None = None      # the danger limit ctx_pct is measured against (`_og_ctx_limit`)
    ctx_has_data: bool = False        # raw ctx exists even when window is missing (cell still draws `—`)
    tokens: int | None = None
    cost: float | None = None
    cost_note: str = ""                 # "local" | "sub" | "" for an unknown cost
    elapsed: str = ""                   # already formatted, e.g. "12m 39s" or "⟳ 30m"
    tools: int | None = None
    pulses: list[tuple[float, int]] = field(default_factory=list)
    now: str = ""
    now_age: float | None = None
    live: bool = False
    sub: bool = True                    # False: this row's NOW sub-line is shown elsewhere (folded or opened rows)


def _og_metric_empty(key: str, cells: _og_Cells) -> bool:
    """True when a metric column would draw as blank (`—` or an empty total)."""
    if key == "ctx":
        return cells.ctx_pct is None and not cells.ctx_has_data
    if key == "tokens":
        return cells.tokens is None
    if key == "cost":
        return cells.cost is None
    if key == "tools":
        return cells.tools is None
    return False


def _og_hide_empty_metrics(plan: _og_Plan, rows: list[_og_Cells]) -> None:
    """On a phone, drop metric columns that are empty on every session, worker and project heading row."""
    if plan.cols >= _OG_PHONE_COLS or not rows:
        return
    for key in _OG_EMPTY_METRICS:
        if key in plan.hidden or not all(_og_metric_empty(key, cells) for cells in rows):
            continue
        plan.hidden.add(key)


def _og_plan(cols: int, control_center: bool = False, metric_rows: list[_og_Cells] | None = None) -> _og_Plan:
    """One column plan per width, the same in every mode (v never moves a column). A width that leaves the name column
    under _OG_NAME_MIN drops metric columns in _OG_DROP order until it fits."""
    plan = _og_Plan(cols, control_center=control_center)
    plan.hidden = {key for key, ok in (("spark", cols >= 112), ("tools", cols >= 100), ("tokens", cols >= 90)) if not ok}
    plan.spark = cols >= 112
    plan.tools = cols >= 100
    plan.tokens = cols >= 90
    plan.short = cols < 100
    plan.tag_w = 4 if plan.short else 6
    plan.model_w = 12 if cols < 90 else 16
    phone = cols < _OG_PHONE_COLS and metric_rows
    if phone:
        _og_hide_empty_metrics(plan, metric_rows)
    for dropped in (None, *_OG_DROP):
        if dropped is not None:
            plan.hidden.add(dropped)
            if dropped in ("spark", "tools", "tokens"):
                setattr(plan, dropped, False)
        cells = plan.columns()
        plan.fixed = 2 + sum(width for _, width in cells) + len(cells) - 1
        if cols - plan.fixed >= _OG_NAME_MIN:
            break
    return plan


def _og_header(plan: _og_Plan) -> str:
    """The column header line: every label sits over its data (text left-aligned, numbers right-aligned, as in _og_row)."""
    labels = {"tag": ("LVL" if plan.short else "LEVEL", False), "harn": ("HARN", False), "model": ("MODEL", False),
              "ctx": ("CTX", True), "tokens": ("TOKENS", True), "cost": ("COST", True), "elapsed": ("ELAPSED", True),
              "tools": ("TOOLS", True)}
    cells = []
    for key, width in plan.columns():
        if key == "spark":
            cells.append("TOOLS/MIN" + " " * max(1, width - len("TOOLS/MIN") - len("30m")) + "30m")
        else:
            text, right = labels[key]
            cells.append((_og_lpad if right else _og_rpad)(text, width))
    line = _og_rpad("  SESSION", plan.name_w) + "  " + " ".join(cells)
    return _wd_c(_wd_trunc(line, plan.cols), _wd_C_MUTED)


def _og_worker_cells(wk: Worker, now: float) -> _og_Cells:
    log = wk.log
    live = wk.state in ("running", "quiet", "stalled")
    model = display_model(wk.model or log.model)
    if wk.effort:
        effort = _og_effort(wk.effort)
        model = f"{model} · {effort}" if model else effort
    ctx_limit = _og_ctx_limit(log.ctx_window, wk.model, log.model)
    ctx = _og_pct(log.ctx_tokens, ctx_limit)
    tokens = _og_tokens(log.tokens_in, log.tokens_out)
    has_log = bool(log.path or log.steps or log.tool_counts or log.tool_pulses or log.last_ts)
    tools = sum(log.tool_counts.values()) if has_log else None
    step = log.steps[-1] if live and log.steps else None
    local = _og_local(wk.family, wk.account, log.harness, wk.model, log.model)
    return _og_Cells(
        tag=wk.level_tag or "WORKER", harn=_og_worker_harness(wk), model=model, ctx_pct=ctx,
        ctx_tokens=log.ctx_tokens, ctx_limit=ctx_limit,
        ctx_has_data=log.ctx_tokens is not None or bool(log.ctx_window),
        tokens=tokens, cost=log.cost, cost_note="local" if local else "", elapsed=_og_worker_elapsed(wk, now),
        tools=tools, pulses=list(log.tool_pulses), now=step.text if step else "",
        now_age=max(0.0, now - log.last_ts) if step and log.last_ts else None, live=live,
    )


def _og_stage_cells(stage: Stage, now: float) -> _og_Cells:
    live = stage.state == "active" or stage.lead_state in ("live", "background")
    model = display_model(stage.lead_model)
    if stage.effort:
        effort = _og_effort(stage.effort)
        model = f"{model} · {effort}" if model else effort
    ctx_limit = _og_ctx_limit(stage.lead_ctx_window, stage.lead_model)
    pct = _og_pct(stage.lead_ctx, ctx_limit)
    name = stage.display_name or stage.session_name or stage.label
    tag = "" if stage.unlinked else stage.level_tag or ("LEAD" if not stage.parent else "SPAWN")
    harn = _og_stage_harness(stage)
    pulse = list(stage.lead_tool_pulses)
    stamp, text = stage.doing[-1] if live and stage.doing else (0.0, "")
    local = _og_local(stage.tag, stage.lead_kind, stage.vitals.provider if stage.vitals else "", model, name)
    return _og_Cells(
        tag=tag, harn=harn, model=model, ctx_pct=pct, ctx_tokens=stage.lead_ctx, ctx_limit=ctx_limit,
        ctx_has_data=stage.lead_ctx is not None or bool(stage.lead_ctx_window),
        tokens=stage.lead_tokens, cost=stage.lead_cost,
        cost_note="local" if local else "", elapsed=_og_stage_elapsed(stage, now),
        tools=stage.lead_tools, pulses=pulse, now=text, now_age=max(0.0, now - stamp) if stamp else None, live=live,
    )


def _og_cell_values(plan: _og_Plan, cells: _og_Cells, now: float) -> dict[str, str]:
    """Each shown metric column of one row as a styled, padded cell."""
    harn_color = _og_harn_color(cells.harn)
    out = {
        "tag": _ot_tag(cells.tag, plan.short),   # already coloured and padded to plan.tag_w
        "harn": _wd_c(_og_rpad(cells.harn or "—", 5), harn_color if cells.harn else _wd_C_FAINT),
        "model": _wd_c(_og_rpad(_wd_trunc(cells.model or "—", plan.model_w), plan.model_w),
                       _wd_C_MUTED if cells.model else _wd_C_FAINT),
        "ctx": _og_ctx_cell(cells.ctx_tokens, cells.ctx_pct),
    }
    out["tokens"] = _og_money_or_count(_wd_fmt_tok(cells.tokens) if cells.tokens is not None else "—", 6,
                                       cells.tokens is not None, _wd_C_MUTED)
    cost = ("<$0.01" if 0 < cells.cost < 0.01 else _wd_fmt_money(cells.cost)) if cells.cost is not None else "—"
    out["cost"] = _og_metric(cost, 6, _wd_C_TEXT if cells.cost is not None else _wd_C_FAINT, right=True)
    out["elapsed"] = _og_metric(cells.elapsed or "—", 7, _wd_C_MUTED if cells.elapsed else _wd_C_FAINT, right=True)
    out["tools"] = _og_money_or_count(str(cells.tools) if cells.tools is not None else "—", 5,
                                      cells.tools is not None, _wd_C_MUTED)
    out["spark"] = _os_tools_spark(cells.pulses, now, 15)
    return out


def _og_money_or_count(text: str, width: int, known: bool, color: tuple[int, int, int]) -> str:
    return _og_metric(text, width, color if known else _wd_C_FAINT, right=True)


def _og_now_text(cells: _og_Cells, now: float) -> tuple[str, float | None]:
    """The sub-line's words and age. A live row always has one: the last action, else the last tool call, else an honest
    'nothing recorded'."""
    if cells.now:
        return cells.now, cells.now_age
    newest = max((ts for ts, n in cells.pulses if n > 0 and ts > 0), default=0.0)
    if newest:
        return "last tool call", max(0.0, now - newest)
    return ("no activity recorded", None) if cells.tag in ("LEAD", "SPAWN", "CRON", "") else ("", None)


def _og_row(plan: _og_Plan, prefix: str, cont: str, mark: str, name: str, cells: _og_Cells, now: float,
            why: str = "", selected: bool = False, tail: str = "") -> list[str]:
    """A session or worker row, then its `› now · 4s` sub-line (live rows always) and its `why` line."""
    if tail:   # a tail (the swarm hive, `▸ N spawns`) closes the name column; it never pushes a metric out of its cell
        avail = plan.name_w - _wd_width(prefix) - 2
        # the tail may take what the name does not need, but never fewer than 2 cells (`▲1`, a hidden failure) while a name fits
        tail = _wd_clip(tail, max(avail - 1 - _OG_TAIL_NAME, 2)) if avail >= 2 + 1 + 1 else ""
    room = plan.name_w - (_wd_width(tail) + 1 if tail else 0)
    name_w = max(0, room - _wd_width(prefix) - 2)
    left = _wd_c(prefix, _wd_C_BORDER) + mark + " " + _wd_c(
        _wd_trunc(name, name_w), _wd_C_TEXT if cells.live else _wd_C_SUB, bold=cells.live)
    if tail:
        left = _wd_pad(left, room) + " " + tail
    values = _og_cell_values(plan, cells, now)
    parts = [values[key] for key, _ in plan.columns()]
    line = _wd_pad(left, plan.name_w) + "  " + " ".join(parts)
    out = [_og_fit_line(line, plan.cols)]
    if cells.live and cells.sub:
        text, age_s = _og_now_text(cells, now)
        if text:
            age = _wd_fmt_dur(age_s) if age_s is not None else ""
            suffix = _wd_c("  · " + age, _wd_C_DIM) if age else ""
            lead = _wd_c(cont, _wd_C_BORDER) + "  "
            body_w = max(0, plan.cols - _wd_width(lead) - _wd_width(suffix) - 1)   # the cells under it are empty: use the line
            words = _wd_c(_wd_trunc("› " + text, body_w), _wd_C_SUB if cells.now else _wd_C_DIM)
            out.append(_og_fit_line(lead + words + suffix, plan.cols))
    if why:
        out.append(_og_fit_line(_os_why_line(cont, why, plan.cols), plan.cols))
    if selected:
        out = [_wd_bg_line(row, _wd_C_SELBG, plan.cols) for row in out]
    return out


def _og_badge(work: WorkState | None) -> str:
    """The coloured work-state badge (`● uncommitted`, `● 2 unpushed`, `● unmerged`, `✔ merged`), "" when clean/unknown."""
    if work is None:
        return ""
    if work.dirty:
        return _wd_c("● uncommitted", _wd_C_AMBER)
    if work.ahead:
        return _wd_c(f"● {work.ahead} unpushed", _wd_C_AMBER)
    if work.unmerged:
        return _wd_c("● unmerged", _wd_C_BLUE)
    if work.unmerged is False and work.branch and work.dirty is False:
        return _wd_c("✔ merged", _wd_C_GREEN)
    return ""


def _og_project_head(plan: _og_Plan, name: str, opened: bool, live: bool, counts: str, badge: str = "",
                     right: str = "", selected: bool = False, totals: _og_Cells | None = None) -> str:
    """`▾ name ───── 2 live · 1 idle  ● 2 unpushed ──   1.2M   $0.82   61`. The counts end before the metric columns; the
    project's totals sit inside TOKENS, COST and TOOLS so they line up under their headers."""
    arrow = _wd_c("▾" if opened else "▸", _wd_C_BLUE if live else _wd_C_DIM)
    counts_part = "  " + _wd_c(_wd_clean(counts), _wd_C_MUTED)
    badge_part = "  " + badge if badge else ""
    age_part = "  " + _wd_c(_wd_clean(right), _wd_C_DIM) if right else ""
    name_cap = _OG_HEAD_NAME_WIDE if plan.cols >= _OG_WIDE_COLS else _OG_HEAD_NAME
    want = min(_wd_width(name), name_cap)          # the name keeps this much before the tail sheds anything
    tails = (counts_part + badge_part + age_part, counts_part + badge_part, counts_part)   # age goes first
    attempts = [(zone, tail) for zone in (plan.name_w + 2, plan.cols) for tail in tails] + [(plan.cols, "")]
    for zone, tail in attempts:                    # a phone borrows the metric zone before it drops the counts
        tail += " "
        name_w = max(1, zone - 4 - _wd_width(tail) - 2)      # `▾ ` and 2 spaces round the title, 2 cells of rule
        if name_w >= want:
            break
    title = _wd_c(_wd_trunc(name, name_w), _wd_C_TEXT if live else _wd_C_SUB, bold=live)
    head = arrow + " " + title + "  "
    rule_w = max(0, zone - _wd_width(head) - _wd_width(tail))
    left = head + _wd_c("─" * rule_w, _wd_C_BORDER) + tail
    if zone >= plan.cols:                          # the whole line went to the name: no room for totals
        return _og_selected(_og_fit_line(left, plan.cols), plan.cols, selected)
    cells = []
    for key, width in plan.columns():
        blank = " " * width
        if totals is not None and key == "tokens" and totals.tokens is not None:
            blank = _og_metric(_wd_fmt_tok(totals.tokens), width, _wd_C_MUTED, right=True)
        elif totals is not None and key == "cost" and totals.cost is not None:
            blank = _og_metric(_wd_fmt_money(totals.cost), width, _wd_C_TEXT if live else _wd_C_MUTED, right=True)
        elif totals is not None and key == "tools" and totals.tools is not None:
            blank = _og_metric(str(totals.tools), width, _wd_C_MUTED, right=True)
        cells.append(blank)
    line = _wd_pad(_wd_clip(left, zone), zone) + " ".join(cells)
    return _og_selected(_og_fit_line(line, plan.cols), plan.cols, selected)


def _og_idle_divider(plan: _og_Plan, projects: int, selected: bool = False) -> str:
    """`╌╌ idle · N projects · quiet under 2h ╌╌╌ h hide`."""
    head = _wd_c(f"╌╌ idle · {projects} projects · quiet under 2h ", _wd_C_DIM)
    hint = "h hide"
    tail = " " + _wd_c(hint, _wd_C_FAINT)
    middle = _wd_c("╌" * max(2, plan.cols - _wd_width(head) - _wd_width(tail)), _wd_C_FAINT)
    return _og_selected(_og_fit_line(head + middle + tail, plan.cols), plan.cols, selected)


def _og_closed_line(plan: _og_Plan, closed: int, need_sweep: int, selected: bool = False) -> str:
    """`31 closed · 4 need sweep · a shows closed · session-sweep cleans up`."""
    text = f"{closed} closed · {need_sweep} need sweep  ·  a shows closed  ·  session-sweep cleans up"
    return _og_selected(_og_fit_line(_wd_c(text, _wd_C_MUTED), plan.cols), plan.cols, selected)


def _og_finished_line(plan: _og_Plan, prefix: str, n: int, last_age: float | None, opened: bool,
                      selected: bool = False) -> str:
    """`└─ ▸ finished 6   last 25m ago` under its project."""
    age = _og_age(last_age) + " ago" if last_age is not None else "— ago"
    text = _wd_c(prefix, _wd_C_BORDER) + _wd_c("▾" if opened else "▸", _wd_C_MUTED) + _wd_c(
        f" finished {n}   last {age}", _wd_C_MUTED)
    return _og_selected(_og_fit_line(text, plan.cols), plan.cols, selected)


def _og_lpad(text: str, width: int) -> str:
    text = _wd_trunc(text, width)
    return " " * max(0, width - _wd_width(text)) + text


def _og_rpad(text: str, width: int) -> str:
    return _wd_pad(_wd_trunc(text, width), width)


def _og_metric(text: str, width: int, color: tuple[int, int, int], right: bool = False) -> str:
    text = _wd_trunc(text, width)
    return _wd_c((_og_lpad if right else _og_rpad)(text, width), color)


_OG_EFFORT = {"low": "lo", "medium": "med", "high": "hi", "xhigh": "xhi", "minimal": "min"}


def _og_effort(effort: str) -> str:
    return _OG_EFFORT.get(effort.lower(), effort)


def _og_age(sec: float) -> str:
    """A coarse age: `40s`, `25m`, `1h 05m`, `3d`."""
    sec = max(0, int(sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    if sec < 86400:
        return f"{sec // 3600}h {sec % 3600 // 60:02d}m"
    return f"{sec // 86400}d"


def _og_pct(used: int | None, window: int | None) -> int | None:
    return round(used * 100 / window) if used is not None and window else None


# Danger limits in tokens (the user 2026-10-25). Haiku's is hard: 100k, with autocompact at 80k. Opus and Sonnet get 300k
# to be safe. The window caps a limit; any other model is measured against its own window.
_OG_CTX_LIMITS = (("haiku", 100_000), ("opus", 300_000), ("sonnet", 300_000))


def _og_ctx_limit(window: int | None, *models: str | None) -> int | None:
    """The token count at which this model's context turns red: a fixed limit for Haiku/Opus/Sonnet, else its window."""
    text = " ".join(str(model or "").lower() for model in models)
    for key, limit in _OG_CTX_LIMITS:
        if key in text:
            return min(limit, window) if window else limit
    return window or None


def _og_tokens(tokens_in: int | None, tokens_out: int | None) -> int | None:
    return None if tokens_in is None and tokens_out is None else (tokens_in or 0) + (tokens_out or 0)


def _og_local(*values: str) -> bool:
    text = " ".join(str(value or "").lower() for value in values)
    return any(hint in text for hint in ("local", "llamacpp", "ollama", "ornith"))


def _og_worker_harness(wk: Worker) -> str:
    mapping = {"claude": "CC", "codex": "Codex", "opencode": "OCode", "cursor": "Cursr", "openclaw": "OClaw"}
    return mapping.get((wk.log.harness or "").lower(), mapping.get(wk.family.lower(), "—"))


def _og_stage_harness(stage: Stage) -> str:
    if stage.tag:
        return stage.tag
    kind = (stage.lead_kind or "").lower()
    for key, label in (("claude", "CC"), ("codex", "Codex"), ("opencode", "OCode"), ("cursor", "Cursr"), ("openclaw", "OClaw")):
        if key in kind:
            return label
    return "OClaw" if stage.vitals else "—"


def _og_harn_color(harn: str) -> tuple[int, int, int]:
    if harn.startswith("CC"):
        return _wd_family_color("claude")
    if harn == "Codex":
        return _wd_family_color("codex")
    if harn == "OCode":
        return _wd_C_BLUE
    if harn == "Cursr":
        return _wd_family_color("cursor")
    if harn == "OClaw":
        return _wd_C_VIOLET
    return _wd_C_MUTED


def _og_ctx_cell(tokens: int | None, pct: int | None) -> str:
    """The context size (`84k`), shaded by how full the window is; plain when the window is unknown."""
    if tokens is None:
        return _og_metric("—", 4, _wd_C_FAINT, right=True)
    return _og_metric(_wd_fmt_tok(tokens), 4, _wd_ctx_color(pct), right=True)


def _og_ctx_text(cells: object) -> str:
    """`82k of 300k · 27%` (size, danger limit, share of it) for the detail views; `82k` without a limit."""
    tokens, pct = getattr(cells, "ctx_tokens", None), getattr(cells, "ctx_pct", None)
    limit = getattr(cells, "ctx_limit", None)
    if tokens is None:
        return "" if pct is None else f"{pct}%"
    if not limit or pct is None:
        return _wd_fmt_tok(tokens)
    return f"{_wd_fmt_tok(tokens)} of {_wd_fmt_tok(limit)} · {pct}%"


def _og_worker_elapsed(wk: Worker, now: float) -> str:
    if not wk.start:
        return "—"
    end = now if wk.state in ("running", "quiet", "stalled") else (wk.end or now)
    return _wd_fmt_dur(max(0, end - wk.start))


def _og_stage_elapsed(stage: Stage, now: float) -> str:
    if not stage.lead_since:
        return "—"
    end = now if stage.state == "active" or stage.lead_state in ("live", "background") else (stage.activity or now)
    return _wd_fmt_dur(max(0, end - stage.lead_since))


def _og_fit_line(line: str, cols: int) -> str:
    return _wd_pad(_wd_clip(line, cols), cols)


def _og_selected(line: str, cols: int, selected: bool) -> str:
    return _wd_bg_line(line, _wd_C_SELBG, cols) if selected else line


OG_SWARM_MIN = 3   # workers in a session's current task that make it a swarm (the user 2026-10-24)

_OG_SW_LIVE = ("running", "quiet", "stalled")
_OG_SW_PULSE_S = 0.9      # a tool call's heat fades over this long
_OG_SW_HOT_S = 0.6        # hive glyph turns CYAN bold this long after a tool call
_OG_SW_RATE_S = 60.0      # tools/min window
_OG_SW_BAR_CELLS = 8
_OG_SW_SPARK_MIN = 90     # no combined sparkline below this width
_OG_SW_SPARK_WIDE = 120   # 30 cells from here, else 14
_OG_SW_SPARK_30 = 30
_OG_SW_SPARK_14 = 14


def _og_sw_static() -> bool:
    """NO_COLOR pins the spinner to one frame so --plain and the tests see the same text."""
    return os.environ.get("NO_COLOR") is not None


def _og_sw_state(wk: Worker) -> str:
    return (wk.state or "").lower()


def _og_sw_live(wk: Worker) -> bool:
    return _og_sw_state(wk) in _OG_SW_LIVE


def _og_sw_newest(wk: Worker) -> float:
    """Epoch of the newest tool call the log recorded, 0.0 when it has none."""
    return max((ts for ts, n in wk.log.tool_pulses if n > 0 and ts > 0), default=0.0)


def _og_sw_age(wk: Worker, now: float) -> float | None:
    """Seconds since that worker's newest tool call, clamped at 0 when the clock runs ahead."""
    newest = _og_sw_newest(wk)
    return max(0.0, now - newest) if newest else None


def _og_pulse(wk: Worker, now: float) -> float:
    """0..1 heat of a worker's newest tool call: 1 right after it, fading to 0 over 0.9 s (the name brightens to CYAN)."""
    if not _og_sw_live(wk):
        return 0.0
    age = _og_sw_age(wk, now)
    if age is None:
        return 0.0
    return max(0.0, 1.0 - age / _OG_SW_PULSE_S)


def _og_sw_glyph(wk: Worker, index: int, frame_t: float, now: float) -> str:
    """One hive cell: spinner, ✔, ✖ or ○."""
    state = _og_sw_state(wk)
    if state not in _OG_SW_LIVE:
        if state == "done":
            return _wd_c("✔", _wd_C_GREEN)
        if state == "failed":
            return _wd_c("✖", _wd_C_RED)
        return _wd_c("○", _wd_C_DIM)
    age = _og_sw_age(wk, now)
    hot = age is not None and age < _OG_SW_HOT_S
    glyph = _wd_spinner(frame_t + index * 0.1)   # one frame apart, so the strip ripples
    return _wd_c(glyph, _wd_C_CYAN, bold=True) if hot else _wd_c(glyph, _wd_family_color(wk.family))


def _og_sw_glyphs(workers: list[Worker], t: float, now: float) -> list[str]:
    frame_t = 0.0 if _og_sw_static() else t
    return [_og_sw_glyph(wk, i, frame_t, now) for i, wk in enumerate(workers)]


def _og_hive(workers: list[Worker], t: float, now: float) -> str:
    """One glyph per worker in launch order: spinner in family colour, out of phase so the strip ripples; CYAN bold while
    that worker made a tool call in the last 0.6 s; ✔ GREEN / ✖ RED when finished."""
    return "".join(_og_sw_glyphs(workers, t, now))


def _og_sw_hive_fit(glyphs: list[str], avail: int) -> str:
    """The whole hive when it fits, else the first k glyphs and a FAINT `+n`; never cut mid-glyph."""
    total = len(glyphs)
    if total == 0 or sum(_wd_width(g) for g in glyphs) <= avail:
        return "".join(glyphs)
    for k in range(total - 1, 0, -1):
        suffix = f"+{total - k}"
        if sum(_wd_width(g) for g in glyphs[:k]) + _wd_width(suffix) <= avail:
            return "".join(glyphs[:k]) + _wd_c(suffix, _wd_C_FAINT)
    suffix = f"+{total}"
    return _wd_c(suffix, _wd_C_FAINT) if _wd_width(suffix) <= avail else ""


def _og_sw_bar(done: int, total: int) -> str:
    """`▰▰▱▱ 3/8`: any finished counts as done."""
    full = min(_OG_SW_BAR_CELLS, max(0, round(done * _OG_SW_BAR_CELLS / total))) if total else 0
    return ("  " + _wd_c("▰" * full, _wd_C_GREEN) + _wd_c("▱" * (_OG_SW_BAR_CELLS - full), _wd_C_FAINT)
            + _wd_c(f" {done}/{total}", _wd_C_SUB))


def _og_sw_rate(workers: list[Worker], now: float) -> tuple[int, bool]:
    """Combined tool calls in the last minute, and whether any worker carries tool data at all."""
    pulses = [pulse for wk in workers for pulse in wk.log.tool_pulses]
    if not pulses:
        return 0, False
    return sum(n for ts, n in pulses if now - _OG_SW_RATE_S < ts <= now), True


def _og_sw_chunks(workers: list[Worker], now: float, cols: int) -> list[str]:
    """The parts after the hive, left to right; the caller drops them from the right when the band is narrow."""
    chunks: list[str] = []
    total = len(workers)
    if total:
        done = sum(1 for wk in workers if not _og_sw_live(wk))
        chunks.append(_og_sw_bar(done, total))
        rate, has_data = _og_sw_rate(workers, now)
        chunks.append(_wd_c("  ·  ", _wd_C_FAINT)
                      + (_wd_c(str(rate), _wd_C_CYAN, bold=True) if has_data else _wd_c("—", _wd_C_FAINT))
                      + _wd_c(" tools/min", _wd_C_MUTED))
        if cols >= _OG_SW_SPARK_MIN:
            cells = _OG_SW_SPARK_30 if cols >= _OG_SW_SPARK_WIDE else _OG_SW_SPARK_14
            pulses = [pulse for wk in workers for pulse in wk.log.tool_pulses]
            chunks.append(" " + _os_spark(_os_bins(pulses, now, cells), cells))
    failed = sum(1 for wk in workers if _og_sw_state(wk) == "failed")
    if failed:
        chunks.append(_wd_c("  ·  ", _wd_C_FAINT) + _wd_c(f"{failed} failed", _wd_C_RED))
    return chunks


def _og_swarm_band(plan: _og_Plan, cont: str, workers: list[Worker], now: float, t: float) -> str:
    """`<cont>╭─ SWARM 8 <hive>  ▰▰▱▱ 3/8  ·  67 tools/min <combined spark>  ·  1 failed`, exactly plan.cols wide."""
    total = len(workers)
    head = (_wd_c(cont, _wd_C_BORDER) + _wd_c("╭─ ", _wd_C_VIOLET)
            + _wd_c("SWARM", _wd_C_VIOLET, bold=True) + _wd_c(f" {total} ", _wd_C_TEXT))
    hive = _og_sw_hive_fit(_og_sw_glyphs(workers, t, now), max(0, plan.cols - _wd_width(head)))
    chunks = _og_sw_chunks(workers, now, plan.cols)
    while chunks and _wd_width(head) + _wd_width(hive) + sum(_wd_width(c) for c in chunks) > plan.cols:
        chunks.pop()      # drop parts right to left: failed, spark, rate, bar
    return _og_fit_line(head + hive + "".join(chunks), plan.cols)




# ──────────────────── ccactions ────────────────────
"""Control center: the actions behind the confirm line. Stop / kill a process, spawn a worker, resume a session.
Nothing here runs without a caller having shown `confirm_text` and got `y`. Every run is appended to
`$STATUS_ACTIONS_LOG`, else Station's ledger under STATION_HOME. Imports model and standard library
only. The runner arguments let tests replace os.kill / subprocess; real sessions are never touched in tests."""



ACTIONS = ("stop", "kill", "resume", "spawn")

_CX_STOP_GRACE_S = 3.0        # kill is offered this long after a stop went to the same pid
_CX_MIN_HEADROOM = 5.0        # percent; a subscription tighter than this is greyed
_CX_CONFIRM_MAX = 99          # the confirm line must fit one row, under 100 chars
_CX_TMUX_MAX = 64             # tmux session name limit
_CX_BRIEF_HEAD = 60           # title / goal cut in a dispatch brief
_CX_QUOTA_BIN = home_path("bin/quota")
_CX_GUARDS = home_path("picker/guards.json")
_CX_MODELS = home_path("picker/models.json")
_CX_LAUNCH_SESSION = home_path("bin/launch-session")
_CX_DISPATCH = home_path("bin/dispatch")
_CX_LOGFILE = home_path("ledger/status-actions.jsonl")
_CX_TAGS = (("cc", "claude"), ("claude", "claude"), ("cdx", "codex"), ("codex", "codex"),
            ("ocode", "opencode"), ("opencode", "opencode"), ("oclaw", "openclaw"), ("openclaw", "openclaw"),
            ("cur", "cursor"), ("cursor", "cursor"))
_CX_READ_ERRORS = (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError)
_CX_RESUME = re.compile(r"(codex resume|claude --resume) ([A-Za-z0-9][A-Za-z0-9._:-]{0,127})")
_CX_STOPS: dict[int, float] = {}   # pid -> time a stop was sent to it in this process
_CX_LAUNCHED: list[subprocess.Popen] = []   # launches are never waited on; old ones are polled so they do not pile up
_CX_DEMO = False   # the tutorial: every action reports what it would do and does nothing (see cx_set_demo)
_cac_PIDFD = hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal")   # Linux 5.3+; tests flip it


def cx_set_demo(on: bool) -> None:
    """Tutorial mode. can() skips the /proc checks (the demo rows carry made-up pids), run() and spawn() send no signal,
    start no process and write no log, and spawn_choices() returns a fixed list. Nothing outside this module sets it."""
    global _CX_DEMO
    _CX_DEMO = bool(on)


def cx_is_demo() -> bool:
    return _CX_DEMO


@dataclass
class Target:
    """What an action acts on: one row, as plain data."""
    kind: str                            # "stage" (a lead/session row) | "worker"
    label: str
    pid: int | None = None
    harness: str = ""                    # "codex" | "claude" | "opencode" | ...
    session_id: str = ""
    tmux: str = ""
    cwd: str = ""
    resume_cmd: str = ""
    live: bool = False                   # the process is running now
    start: int | None = None             # /proc starttime read with the pid, so a recycled pid is caught


@dataclass
class Choice:
    """One line of the spawn picker."""
    id: str                              # picker id, e.g. "deepseek"
    label: str
    ok: bool                             # False = listed greyed
    reason: str = ""                     # why it is greyed, e.g. "not allowed", "headroom 3%"


# ── /proc reads: the only place a pid is trusted ─────────────────────────────────────────────────────

def _cac_stat(pid: int) -> tuple[str, int, int] | None:
    """(state, ppid, starttime) of a pid from /proc, or None when it is gone. comm may hold spaces."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            raw = fh.read()
        rest = raw[raw.rindex(")") + 1:].split()
        return rest[0], int(rest[1]), int(rest[19])
    except (OSError, ValueError, IndexError):
        return None


def _cac_start(pid: int | None) -> int | None:
    """The pid's starttime in clock ticks, or None."""
    if not pid:
        return None
    stat = _cac_stat(pid)
    return None if stat is None else stat[2]


def _cac_uid(pid: int) -> int | None:
    """The real uid that owns a pid: /proc/<pid>/status, else the owner of /proc/<pid>."""
    try:
        with open(f"/proc/{pid}/status", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("Uid:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    try:
        return os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None


def _cac_ancestor(pid: int) -> bool:
    """True when pid is this process or sits above it (the terminal, its shell, the TUI): never signal those."""
    seen: set[int] = set()
    cur: int | None = os.getpid()
    while cur and cur not in seen:
        if cur == pid:
            return True
        seen.add(cur)
        stat = _cac_stat(cur)
        cur = None if stat is None else stat[1]
    return False


def _cac_harness(*hints: str) -> str:
    """The harness name from the first usable tag/kind/family hint ("CC·W", "CDX", "OCode", "claude")."""
    for hint in hints:
        text = (hint or "").strip().lower()
        if not text:
            continue
        for tag, name in _CX_TAGS:
            if text.startswith(tag):
                return name
    return ""


def _cac_signal_pid(pid: int) -> int:
    """The pid to hand os.kill: -pid when it leads its own process group and that group is not ours."""
    try:
        pgid, mine = os.getpgid(pid), os.getpgid(0)
    except OSError:
        return pid
    if pgid == pid and pgid > 1 and pgid != mine:
        return -pid
    return pid


def _cac_sig_error(exc: OSError) -> str:
    """The refusal text for a failed signal: a vanished pid reads as gone, anything else as a failure."""
    if isinstance(exc, ProcessLookupError):
        return "process already gone"
    return f"signal failed: {exc.strerror or exc}"


def _cac_pidfd_signal(pid: int, start: int | None, sig: int) -> str | None:
    """Signal a pid through a pidfd, returning the refusal reason or None when it went. The fd is opened first,
    so it pins whichever process holds the pid; the /proc start time is re-read after it and must still match.
    A process group has no fd, so a group leader is only checked through the pidfd and then signalled with killpg:
    the group id stays unpinned, so a pid recycled as a new group leader in that last gap could still be hit."""
    try:
        fd = os.pidfd_open(pid)
    except OSError as exc:
        return _cac_sig_error(exc)
    try:
        stat = _cac_stat(pid)
        if stat is None:
            return "process already gone"
        if start is not None and stat[2] != start:
            return "pid changed"
        try:
            if _cac_signal_pid(pid) < 0:
                os.killpg(pid, sig)
            else:
                signal.pidfd_send_signal(fd, sig)
        except OSError as exc:
            return _cac_sig_error(exc)
        return None
    finally:
        os.close(fd)


def _cac_numeric_signal(pid: int, start: int | None, sig: int) -> str | None:
    """The fallback for a platform without pidfd: re-read /proc, then a numeric os.kill. The read and the kill are
    not atomic, so a pid recycled in between would still be signalled: that is the old window, kept only here."""
    stat = _cac_stat(pid)
    if stat is None:
        return "process already gone"
    if start is not None and stat[2] != start:
        return "pid changed"
    try:
        os.kill(_cac_signal_pid(pid), sig)
    except OSError as exc:
        return _cac_sig_error(exc)
    return None


# ── Target ───────────────────────────────────────────────────────────────────────────────────────────

def target_of(stage: Stage, worker: Worker | None = None) -> Target:
    """The Target for a lead row (worker None) or a worker row."""
    cwd = stage.cwd or stage.dir or stage.path
    if worker is None:
        return Target(kind="stage", label=stage.label, pid=stage.lead_pid,
                      harness=_cac_harness(stage.harness, stage.tag, stage.lead_kind),
                      session_id=stage.session_id, tmux=stage.tmux, cwd=cwd,
                      resume_cmd=stage.resume_cmd, live=stage.lead_state in ("live", "background"),
                      start=_cac_start(stage.lead_pid))
    return Target(kind="worker", label=worker.name, pid=worker.pid,
                  harness=_cac_harness(worker.harness, worker.family),
                  session_id=worker.native_id, cwd=cwd, resume_cmd=worker.resume_cmd,
                  live=worker.state in LIVE_STATES, start=_cac_start(worker.pid))


# ── can ──────────────────────────────────────────────────────────────────────────────────────────────

def can(action: str, target: Target, *, now: float | None = None,
        uid: Callable[[int], int | None] | None = None) -> tuple[bool, str]:
    """Whether `action` is offered for `target`, and why not. stop/kill need a live pid of this user that is not
    pid 1, this process or one of its ancestors; kill only after a stop was sent or when the row is stuck; resume needs
    resume_cmd and no live process."""
    if action not in ACTIONS:
        return False, "unknown action"
    if action == "spawn":
        if _CX_DEMO or (target.cwd and os.path.isdir(target.cwd)):
            return True, ""
        return False, "no such directory"
    if action == "resume":
        if not target.resume_cmd.strip():
            return False, "no resume command"
        if _cac_resume_parts(target.resume_cmd) is None:
            return False, "unsafe resume command"
        if target.live:
            return False, "session is running"
        return True, ""
    pid = target.pid
    if _CX_DEMO:   # same rules as below on the made-up row, without touching /proc
        if not pid:
            return False, "no pid"
        if not target.live:
            return False, "not running"
        if action == "kill":
            stopped = _CX_STOPS.get(pid)
            if stopped is None:
                return False, "send stop first"
            waited = (time.time() if now is None else now) - stopped
            if waited < _CX_STOP_GRACE_S:
                return False, f"stop was {waited:.0f}s ago, wait {_CX_STOP_GRACE_S:.0f}s"
        return True, ""
    if not pid:
        return False, "no pid"
    if not target.live:
        return False, "not running"
    if pid == 1:
        return False, "pid 1 is not ours"
    if pid == os.getpid():
        return False, "that is this terminal"
    if not os.path.isdir("/proc"):
        return False, "no /proc on this machine"
    stat = _cac_stat(pid)
    if stat is None:
        return False, "process is gone"
    owner = (uid or _cac_uid)(pid)
    if owner is None:
        return False, "cannot check the owner"
    if owner != os.getuid():
        return False, "another user's process"
    if _cac_ancestor(pid):
        return False, "that is this terminal"
    if target.start is not None and stat[2] != target.start:
        return False, "pid was reused"
    if action == "kill":
        stopped = _CX_STOPS.get(pid)
        if stopped is None:
            if stat[0] in ("D", "Z"):     # stuck in the kernel or already a zombie: stop cannot land
                return True, ""
            return False, "send stop first"
        waited = (time.time() if now is None else now) - stopped
        if waited < _CX_STOP_GRACE_S:
            return False, f"stop was {waited:.0f}s ago, wait {_CX_STOP_GRACE_S:.0f}s"
    return True, ""


# ── confirm line ─────────────────────────────────────────────────────────────────────────────────────

def _cac_cut(text: str, limit: int) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:max(1, limit - 1)] + "…"


def confirm_text(action: str, target: Target) -> str:
    """The one-line question shown on the confirm line, ending in "(y/n)"."""
    label = _cac_cut(target.label or "(row)", 40)
    if action in ("stop", "kill"):
        pid = f" (pid {target.pid})" if target.pid else ""
        line = (f"Stop {label}{pid}?  any other key cancels (y/n)" if action == "stop"
                else f"Kill {label}{pid}?  SIGKILL, any other key cancels (y/n)")
        return line if len(line) <= _CX_CONFIRM_MAX else _cac_cut(line, _CX_CONFIRM_MAX)
    if action == "resume":
        head = f"Resume {label} in a new terminal: "
        tail = "?  (y/n)"
        room = max(8, _CX_CONFIRM_MAX - len(head) - len(tail) - 1)
        return head + _cac_cut(target.resume_cmd, room) + tail
    if action == "spawn":
        line = f"Spawn {label} in {target.cwd}?  (y/n)"
        return line if len(line) <= _CX_CONFIRM_MAX else _cac_cut(line, _CX_CONFIRM_MAX)
    return ""


# ── actions log ─────────────────────────────────────────────────────────────────────────────────────

def _cac_log(record: dict[str, object]) -> None:
    """Append one JSON line; a missing or read-only ledger is not worth failing an action over."""
    path = os.environ.get("STATUS_ACTIONS_LOG") or _CX_LOGFILE
    try:
        path = os.path.expanduser(path)
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass


def _cac_result(action: str, target: Target, text: str, ts: float) -> str:
    """Log and return the one-line result. Never carries prompt text: only row fields."""
    _cac_log({"ts": round(ts, 3), "action": action, "label": target.label, "pid": target.pid,
             "harness": target.harness, "session_id": target.session_id, "result": text})
    return text


# ── run ─────────────────────────────────────────────────────────────────────────────────────────────

def _cac_tmux_name(name: str) -> str:
    """A safe tmux session name: the allowed charset only, at most 64 chars."""
    clean = re.sub(r"[^A-Za-z0-9._:-]", "-", name).strip("-")
    return (clean or "cc")[:_CX_TMUX_MAX]


def _cac_popen(argv: list[str], cwd: str, log: str = "") -> subprocess.Popen:
    """The default launch: detached, never waited on. `log` collects the child's output when given."""
    _CX_LAUNCHED[:] = [proc for proc in _CX_LAUNCHED if proc.poll() is None]
    if not log:
        proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a", encoding="utf-8") as out:
            proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out,
                                    stderr=subprocess.STDOUT, start_new_session=True)
    _CX_LAUNCHED.append(proc)
    return proc


def _cac_resume_parts(cmd: str) -> tuple[str, str, str] | None:
    """(executable, flag, id) when the stored command is exactly `codex resume <id>` or `claude --resume <id>` with a
    plain one-token id; None otherwise. Only these two shapes are accepted, so no stored option can be smuggled in."""
    found = _CX_RESUME.fullmatch(cmd or "")
    if found is None:
        return None
    exe, flag = found.group(1).split()
    return exe, flag, found.group(2)


def _cac_resume_argv(target: Target) -> list[str]:
    """The visible-terminal argv for a resume: `<terminal> -e tmux new-session -A -s <name> -c <cwd> <cmd...>`.
    The argv is built from the validated parts, never from a general split; a shell never sees it."""
    parts = _cac_resume_parts(target.resume_cmd)
    if parts is None:
        raise ValueError("unsafe resume command")
    cwd = target.cwd
    if not cwd or not os.path.isdir(cwd):
        raise ValueError("no such directory")
    terminal = os.environ.get("LAUNCH_TERMINAL") or "ghostty"
    name = _cac_tmux_name("resume-" + (target.label or "row"))
    return [terminal, "-e", "tmux", "new-session", "-A", "-s", name, "-c", cwd, *parts]


def run(action: str, target: Target, now: float | None = None, *, kill: Callable[[int, int], None] | None = None,
        launch: Callable[[list[str], str], None] | None = None) -> str:
    """Do a confirmed stop, kill or resume and return a one-line result for ui.note. Re-checks `can` and re-reads /proc
    for the pid right before signalling. Appends to the actions log whatever the outcome."""
    ts = time.time() if now is None else now
    ok, why = can(action, target, now=ts)
    if _CX_DEMO:
        if not ok:
            return f"refused: {why}"
        if action == "stop" and target.pid:
            _CX_STOPS[target.pid] = ts
        return f"demo: {action} of {target.label} not sent. A real {action} would have run."
    if not ok:
        return _cac_result(action, target, f"refused: {why}", ts)
    if action == "spawn":
        return _cac_result(action, target, "refused: spawn goes through spawn()", ts)
    if action in ("stop", "kill"):
        pid = int(target.pid or 0)
        stat = _cac_stat(pid)
        if stat is None:
            return _cac_result(action, target, "refused: process is gone", ts)
        if target.start is not None and stat[2] != target.start:
            return _cac_result(action, target, "refused: pid was reused", ts)
        sig = signal.SIGTERM if action == "stop" else signal.SIGKILL
        if kill is not None:                       # tests: the injected callable is used exactly as before
            try:
                kill(_cac_signal_pid(pid), sig)
            except OSError as exc:
                why = f"signal failed: {exc.strerror or exc}"
            else:
                why = None
        elif _cac_PIDFD:
            why = _cac_pidfd_signal(pid, target.start, sig)
        else:
            why = _cac_numeric_signal(pid, target.start, sig)
        if why is not None:
            return _cac_result(action, target, f"refused: {why}", ts)
        if action == "stop":
            _CX_STOPS[pid] = ts
        done = "stopped" if action == "stop" else "killed"
        return _cac_result(action, target, f"{done} {target.label} ({signal.Signals(sig).name}, pid {pid})", ts)
    try:
        argv = _cac_resume_argv(target)
        (launch or _cac_popen)(argv, target.cwd)
    except (OSError, ValueError) as exc:
        return _cac_result(action, target, f"refused: {exc}", ts)
    return _cac_result(action, target, f"resumed {target.label} (tmux {argv[argv.index('-s') + 1]})", ts)


# ── spawn choices ───────────────────────────────────────────────────────────────────────────────────

def _cac_json(path: str) -> dict:
    with open(os.path.expanduser(path), encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise TypeError(f"not a JSON object: {path}")
    return data


def _cac_default_runner(argv: list[str]) -> str:
    """`quota status --json` stdout. Read-only; never a shell."""
    done = subprocess.run(argv, capture_output=True, text=True, timeout=20, check=False)
    if done.returncode != 0:
        raise OSError(f"{argv[0]} exited {done.returncode}")
    return done.stdout


def _cac_pct(value: object) -> float:
    """A percentage or balance as float; junk reads as 0.0 so one bad row cannot sink the picker."""
    try:
        return float(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return 0.0


def _cac_job_reason(model: dict) -> str:
    """Why a model may not build a job, "" when it may."""
    only = model.get("onlyJobs")
    if isinstance(only, list) and only and "build" not in only:
        return f"{only[0]} only"
    never = model.get("neverJobs")
    if isinstance(never, list) and "build" in never:
        return "never builds"
    return ""


def _cac_fit(sub: str, limits: list, credits: dict, pay: dict, meta: dict,
            floor_pct: float) -> tuple[bool, str, str]:
    """(ok, reason, label tail) for a subscription's headroom: credits first, then its tightest window."""
    rule = pay.get(sub) if isinstance(pay, dict) else None
    if isinstance(rule, dict):
        account = str(rule.get("creditAccount") or "")
        floor = _cac_pct(rule.get("minBalanceUsd"))
        entry = credits.get(account)
        balance = entry.get("balanceUsd") if isinstance(entry, dict) else None
        if not isinstance(balance, (int, float)):
            return False, "credits unknown", (f" {account}" if account else "")
        tail = f" {account} ${balance:.2f}"
        return balance >= floor, "" if balance >= floor else f"credits ${balance:.2f}", tail
    if limits:
        worst = max(limits, key=lambda win: _cac_pct(win.get("usedPct")))
        used = _cac_pct(worst.get("usedPct"))
        head = 100.0 - used
        tail = f" {worst.get('name') or worst.get('window') or ''} {used:.0f}%"
        if head < floor_pct:
            return False, f"headroom {head:.0f}%", tail
        return True, "", tail
    if meta.get("unmetered") or meta.get("credits"):
        return True, "", ""
    return False, "no quota data", ""


def spawn_choices(runner: Callable[[list[str]], str] | None = None, *, guards_path: str | None = None,
                  models_path: str | None = None) -> list[Choice]:
    """The spawn picker: every id in $STATION_HOME/picker/guards.json allowedModels, ok=False with a reason for models under
    5% headroom or never-jobs, using `quota pick`/`quota status` output (runner replaces the subprocess)."""
    if _CX_DEMO:
        return [Choice("luna", "luna (medium)", True), Choice("haiku", "haiku", True),
                Choice("sonnet", "sonnet (medium)", False, "headroom 3%"), Choice("opus", "opus (medium)", True)]
    guards_path = guards_path or _CX_GUARDS
    models_path = models_path or _CX_MODELS
    if not os.path.isfile(os.path.expanduser(guards_path)) or not os.path.isfile(os.path.expanduser(models_path)):
        return []
    quota_cmd = optional_cmd(_CX_QUOTA_BIN)
    if runner is None and quota_cmd is None:
        return []
    try:
        guards = _cac_json(guards_path)
        models = _cac_json(models_path)
        allowed = (guards.get("allowedModels") or {}).get("models")
        if not isinstance(allowed, list):
            raise TypeError("guards.json has no allowedModels.models")
        entries = {str(mod["id"]): mod for mod in models.get("models") or []
                   if isinstance(mod, dict) and isinstance(mod.get("id"), str)}
        subs = models.get("subscriptions") if isinstance(models.get("subscriptions"), dict) else {}
        status = json.loads((runner or _cac_default_runner)([quota_cmd or _CX_QUOTA_BIN, "status", "--json"]))
        if not isinstance(status, dict):
            raise TypeError("quota status is not an object")
        windows = {str(row["id"]): [win for win in row.get("limits") or [] if isinstance(win, dict)]
                   for row in status.get("subscriptions") or [] if isinstance(row, dict) and "id" in row}
        credits = {str(row["account"]): row for row in status.get("credits") or []
                   if isinstance(row, dict) and "account" in row}
        pay = guards.get("payPerToken") if isinstance(guards.get("payPerToken"), dict) else {}
        floor_pct = float(guards.get("minHeadroomPct") or _CX_MIN_HEADROOM)
    except FileNotFoundError:
        return []
    except _CX_READ_ERRORS:
        return [Choice(id="", label="picker unavailable", ok=False)]
    out: list[Choice] = []
    for mid in allowed:
        if not isinstance(mid, str) or not mid:
            continue
        model = entries.get(mid)
        if model is None:
            out.append(Choice(id=mid, label=f"{mid}  unknown model", ok=False, reason="not in models.json"))
            continue
        sub = str(model.get("subscription") or "")
        meta = subs.get(sub) if isinstance(subs.get(sub), dict) else {}
        reason = _cac_job_reason(model)
        if reason:
            out.append(Choice(id=mid, label=f"{mid}  {sub}".strip(), ok=False, reason=reason))
            continue
        ok, why, tail = _cac_fit(sub, windows.get(sub) or [], credits, pay, meta, floor_pct)
        out.append(Choice(id=mid, label=f"{mid}  {sub}{tail}".strip(), ok=ok, reason=why))
    if runner is None:
        available = {model_id: model for model_id, model in entries.items()
                     if optional_cmd(_CX_LAUNCH_SESSION if model.get("cli") == "claude" else _CX_DISPATCH)}
        out = [choice for choice in out if choice.id in available]
    return sorted(out, key=lambda choice: not choice.ok)


# ── spawn ───────────────────────────────────────────────────────────────────────────────────────────

def _cac_brief(model_id: str, task: str, project_dir: str) -> str:
    """The dispatch brief: the fixed header dispatch reads, then the task text as typed."""
    title = _cac_cut(task, _CX_BRIEF_HEAD)
    return (f"# {title}\n\nGoal: {title}\nJob: build\nModel: {model_id}\nMode: write\nCwd: {project_dir}\n\n{task}\n")


def _cac_write(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text if text.endswith("\n") else text + "\n")


def spawn(model_id: str, project_dir: str, task_text: str, now: float | None = None, *,
          launch: Callable[[list[str], str], None] | None = None, choices: list[Choice] | None = None,
          runner: Callable[[list[str]], str] | None = None, guards_path: str | None = None,
          models_path: str | None = None) -> str:
    """Start a new worker/session through dispatch / launch-session with the chosen model; refuses ids that are not ok."""
    ts = time.time() if now is None else now
    if _CX_DEMO:
        return f"demo: spawn of {model_id} not started. A real spawn would have launched it."
    project_dir = os.path.abspath(os.path.expanduser(project_dir or "."))

    def refuse(why: str, cli: str = "", name: str = "") -> str:
        _cac_log({"ts": round(ts, 3), "action": "spawn", "label": str(model_id or ""), "pid": None,
                 "harness": cli, "session_id": name, "result": f"refused: {why}"})
        return f"refused: {why}"

    picks = choices if choices is not None else spawn_choices(
        runner, guards_path=guards_path, models_path=models_path)
    pick = next((choice for choice in picks if choice.id == model_id and choice.id), None)
    if pick is None:
        return refuse(f"unknown model {model_id!r}")
    if not pick.ok:
        return refuse(f"{model_id}: {pick.reason or 'not allowed'}")
    try:
        models = _cac_json(models_path or _CX_MODELS)
    except _CX_READ_ERRORS:
        return refuse("models.json unreadable")
    entry = next((mod for mod in models.get("models") or []
                  if isinstance(mod, dict) and mod.get("id") == model_id), None)
    if entry is None:
        return refuse(f"{model_id} is not in models.json")
    cli = str(entry.get("cli") or "")
    if not os.path.isdir(project_dir):
        return refuse(f"no such directory: {project_dir}", cli)
    task = task_text.strip()
    if not task:
        return refuse("empty task", cli)
    if not cli:
        return refuse(f"{model_id} has no cli", cli)
    if launch is None:
        required = _CX_LAUNCH_SESSION if cli == "claude" else _CX_DISPATCH
        if optional_cmd(required) is None:
            return refuse(f"{os.path.basename(required)} is unavailable", cli)
    name = "cc-" + secrets.token_hex(3)
    try:
        if cli == "claude":
            brief = os.path.join(project_dir, ".stage", "ops-spawn", f"{name}.md")
            _cac_write(brief, task)
            alias = model_id.split("-")[0]
            argv = [optional_cmd(_CX_LAUNCH_SESSION) or _CX_LAUNCH_SESSION, "--model", alias, name, project_dir, brief]
            (launch or _cac_popen)(argv, project_dir)
            result = f"spawned {model_id} ({name}) as a claude session in {project_dir}"
        else:
            brief = os.path.join(project_dir, ".stage", "briefs", f"{name}.md")
            _cac_write(brief, _cac_brief(model_id, task, project_dir))
            stage = os.path.join(project_dir, ".stage")
            log = os.path.join(stage, f"dispatch-{name}.log")
            argv = [optional_cmd(_CX_DISPATCH) or _CX_DISPATCH, "run", stage, name]
            if launch is not None:
                launch(argv, project_dir)
            else:
                _cac_popen(argv, project_dir, log)
            result = f"spawned {model_id} ({name}) via dispatch in {project_dir}"
    except OSError as exc:
        return refuse(f"launch failed: {exc.strerror or exc}", cli, name)
    _cac_log({"ts": round(ts, 3), "action": "spawn", "label": model_id, "pid": None,
             "harness": cli, "session_id": name, "result": result})
    return result



