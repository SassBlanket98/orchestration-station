def nest_workers(workers: list[Worker]) -> list[Worker]:
    """``workers`` with each nested worker moved right after the worker that launched it (children in the order given,
    at any depth). A worker whose ``parent`` is not in the list, or that would close a loop, stays where it was."""
    names = {wk.name for wk in workers}
    kids: dict[str, list[Worker]] = {}
    for wk in workers:
        if wk.parent and wk.parent in names and wk.parent != wk.name:
            kids.setdefault(wk.parent, []).append(wk)
    out: list[Worker] = []
    seen: set[str] = set()

    def add(wk: Worker) -> None:
        if wk.name in seen:
            return
        seen.add(wk.name)
        out.append(wk)
        for child in kids.get(wk.name, ()):
            add(child)

    for wk in workers:
        if not (wk.parent and wk.parent in names and wk.parent != wk.name):
            add(wk)
    for wk in workers:   # a parent loop has no root: keep its members listed
        add(wk)
    return out



# ──────────────────── procs_darwin ────────────────────
"""macOS process provider in the Linux table shape, read from ps, sysctl and lsof.

Every reader returns empty on any failure (missing binary, timeout, non-zero exit, odd output).
Known limits:
- argv is split on whitespace, so an argument with spaces comes back as several words (comm is
  then the first word of argv[0]); environ values with spaces are cut short.
- macOS 15 and later print no environment for other processes (`ps -E`), so every environ read is
  empty there: leads started with CLAUDE_CONFIG_DIR, CODEX_HOME or similar fall back to defaults.
- start times come from `lstart` (local wall clock, whole seconds); a process started in the
  repeated hour of a daylight-saving fall-back can be placed an hour off.
"""


_PD_CLK = 100                  # clock ticks per second, as ps and the Linux shape count them
_PD_TIMEOUT = 5                # seconds per subprocess call
_PD_TTL = 1.0                  # seconds one process table scan is reused
_PD_FAIL_TTL = 10.0            # seconds a failed scan is reused before ps is tried again
_PD_CWD_MAX = 2000             # cwd cache entries; the cache is cleared when it is full
_PD_CWD_RETRY = 30.0           # seconds before a cwd lookup that failed (timeout, no lsof) is retried
_PD_ENV_MAX = 2000             # environ cache entries; cleared when full
_PD_TTY_BASE = 0x10000         # ttysNNN -> BASE + NNN (stable and non-zero)
_PD_TTY_OTHER = 0x20000        # other tty names -> OTHER + crc32 of the name (stable, non-zero)
_PD_LSTART_FMT = "%a %b %d %H:%M:%S %Y"
_PD_TIME_RE = re.compile(r"^(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)(?:\.(\d+))?$")
_PD_SEC_RE = re.compile(r"\bsec\s*=\s*(\d+)")
_PD_USEC_RE = re.compile(r"\busec\s*=\s*(\d+)")
_PD_TTY_DIGITS_RE = re.compile(r"(\d+)$")

# pid -> (ppid, utime, stime, start_ticks, tty, argv, rss_bytes)
_pd_table_memo: tuple[float, dict[int, tuple]] | None = None
_pd_boot_memo: float | None = None
_pd_cwd_memo: dict[tuple[int, int], tuple[str, float]] = {}   # (pid, start) -> (cwd, retry_at)
_pd_env_memo: dict[tuple[int, int, tuple[str, ...]], dict[str, str]] = {}
_pd_env_visible: bool | None = None   # does `ps -E` show any environment here? (macOS 15: no)


def _pd_run(argv: list[str], ok: tuple[int, ...] = (0,)) -> str | None:
    """Stdout of a command, or None on any error or an exit code outside `ok`.

    Output is decoded as UTF-8 with replacement: argv is arbitrary bytes, and one bad byte must not
    lose the whole table.
    """
    try:
        done = subprocess.run(argv, stdin=DEVNULL, capture_output=True, text=True, encoding="utf-8",
                              errors="replace", timeout=_PD_TIMEOUT, check=False)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if done.returncode not in ok:
        return None
    return done.stdout


def _pd_parse_cpu_time(text: str) -> float | None:
    """Seconds from ps time: m:ss.cc, mm:ss.cc, h:mm:ss.cc or d-hh:mm:ss (fraction optional)."""
    m = _PD_TIME_RE.match(text.strip())
    if m is None:
        return None
    days, hours, minutes, seconds, frac = m.groups()
    total = int(days or 0) * 86400 + int(hours or 0) * 3600 + int(minutes) * 60 + int(seconds)
    secs = float(total)
    if frac:
        secs += int(frac) / 10 ** len(frac)
    return secs


def _pd_parse_boottime(text: str) -> float | None:
    """Epoch seconds from `sysctl -n kern.boottime` ({ sec = N, usec = M } ...)."""
    m = _PD_SEC_RE.search(text)
    if m is None:
        return None
    usec = _PD_USEC_RE.search(text)
    return int(m.group(1)) + (int(usec.group(1)) / 1_000_000 if usec else 0.0)


def _pd_tty_num(tty: str) -> int:
    """A non-zero number for a controlling tty, 0 for none (`??` or `-`)."""
    if tty in ("", "??", "-"):
        return 0
    m = _PD_TTY_DIGITS_RE.search(tty)
    if m is not None:
        return _PD_TTY_BASE + int(m.group(1))
    return _PD_TTY_OTHER + zlib.crc32(tty.encode()) % 0x10000


def _pd_parse_table(text: str, boot: float | None) -> dict[int, tuple]:
    """Rows of `ps -axww -o pid=,ppid=,time=,rss=,tty=,lstart=,command=`, keyed by pid.

    The start tick is 0 when boot is unknown. Malformed lines are skipped, never raised on.
    """
    table: dict[int, tuple] = {}
    for line in text.splitlines():
        parts = line.split(None, 10)
        if len(parts) < 10:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            rss = int(parts[3])
            epoch = time.mktime(time.strptime(" ".join(parts[5:10]), _PD_LSTART_FMT))
        except (ValueError, OverflowError):
            continue
        cpu = _pd_parse_cpu_time(parts[2])
        if cpu is None:
            continue
        # The command is split on whitespace; argument spaces are lost (documented limit).
        argv = tuple(parts[10].split()) if len(parts) > 10 else ()
        start = 0 if boot is None else max(0, round((epoch - boot) * _PD_CLK))
        table[pid] = (ppid, round(cpu * _PD_CLK), 0, start, _pd_tty_num(parts[4]),
                      argv, rss * 1024)
    return table


def _pd_boot() -> float | None:
    """Boot time in epoch seconds; read once and kept for the process lifetime."""
    global _pd_boot_memo
    if _pd_boot_memo is None:
        out = _pd_run(["sysctl", "-n", "kern.boottime"])
        if out is not None:
            _pd_boot_memo = _pd_parse_boottime(out)
    return _pd_boot_memo


def _pd_table() -> dict[int, tuple]:
    """The full process table, reused for _PD_TTL seconds; a stale or empty memo is re-read."""
    global _pd_table_memo
    now = time.monotonic()
    memo = _pd_table_memo
    if memo is not None and now - memo[0] < _PD_TTL:
        return memo[1]
    out = _pd_run(["ps", "-axww", "-o", "pid=,ppid=,time=,rss=,tty=,lstart=,command="])
    if out is None:
        # ps failed: keep the empty table longer so a broken or slow ps is not retried every refresh
        _pd_table_memo = (now + _PD_FAIL_TTL - _PD_TTL, {})
        return {}
    rows = _pd_parse_table(out, _pd_boot())
    _pd_table_memo = (now, rows)
    return rows


def _pd_boot_time() -> float:
    """Boot time in epoch seconds; 0.0 when unknown."""
    return _pd_boot() or 0.0


def _pd_boot_id() -> str:
    """kern.boottime whole seconds: the same for one boot, different after a reboot; "" when unknown."""
    boot = _pd_boot()
    return str(int(boot)) if boot else ""


def _pd_scan() -> dict[int, tuple[int, int, int, int, int]]:
    """pid -> (ppid, utime, stime, start_ticks, tty) for every process, as the Linux reader does."""
    return {pid: row[:5] for pid, row in _pd_table().items()}


def _pd_resident(pid: int, page: int) -> int | None:
    """Resident set size in bytes; `page` is ignored (ps reports bytes already scaled)."""
    row = _pd_table().get(pid)
    return None if row is None else row[6]


def _pd_argv(pid: int) -> list[str]:
    """argv of a process, split on whitespace; [] when unknown."""
    row = _pd_table().get(pid)
    return [] if row is None else list(row[5])


def _pd_stat(pid: int) -> tuple[int, int, str] | None:
    """(ppid, start_ticks, comm) with comm the basename of argv[0]; None when unknown."""
    row = _pd_table().get(pid)
    if row is None:
        return None
    argv = row[5]
    comm = os.path.basename(argv[0]) if argv else ""
    return (row[0], row[3], comm)


def _pd_parse_env(text: str, keys: Iterable[str]) -> dict[str, str]:
    """Values of the requested KEY=VALUE tokens only; the last occurrence wins."""
    names = frozenset(keys)
    found: dict[str, str] = {}
    for token in text.split():
        name, sep, value = token.partition("=")
        if sep and name in names:
            found[name] = value
    return found


def _pd_environ(pid: int, keys: Iterable[str]) -> dict[str, str]:
    """The requested environment variables of a process (own processes only); {} otherwise."""
    global _pd_env_visible
    wanted = tuple(keys)
    if not wanted:
        return {}
    if _pd_env_visible is None:
        # One probe of our own process: macOS 15 prints no environment, so skip a ps per call there.
        probe = _pd_run(["ps", "-E", "-ww", "-o", "command=", "-p", str(os.getpid())])
        _pd_env_visible = probe is not None and "PATH=" in probe
    if not _pd_env_visible:
        return {}
    row = _pd_table().get(pid)
    key = (pid, row[3] if row is not None else -1, wanted)
    if key in _pd_env_memo:   # ps -E shows the environment at exec, so one read per process lifetime
        return dict(_pd_env_memo[key])
    out = _pd_run(["ps", "-E", "-ww", "-o", "command=", "-p", str(pid)])
    if out is None:
        return {}
    found = _pd_parse_env(out, wanted)
    if row is not None:   # no start time: not cached, so a reused pid cannot inherit it
        if len(_pd_env_memo) >= _PD_ENV_MAX:
            _pd_env_memo.clear()
        _pd_env_memo[key] = found
    return dict(found)


def _pd_parse_lsof_cwd(text: str) -> dict[int, str]:
    """pid -> cwd from `lsof -a -d cwd -Fn` output (p, f and n lines); pids may be several."""
    found: dict[int, str] = {}
    pid: int | None = None
    for line in text.splitlines():
        if line.startswith("p"):
            pid = int(line[1:]) if line[1:].isdigit() else None
        elif line.startswith("n") and len(line) > 1 and pid is not None and pid not in found:
            found[pid] = line[1:]
    return found


def _pd_cwd(pid: int) -> str:
    """Working directory of a process, cached per (pid, start_ticks).

    A miss looks up this pid and every other uncached pid in the table with one lsof, so the first
    snapshot costs one fork, not one per process. A process lsof cannot see (another user's) is
    cached as "" for its lifetime; a failed lsof (missing, timeout) is retried after _PD_CWD_RETRY.
    """
    table = _pd_table()
    now = time.monotonic()

    def key_of(p: int) -> tuple[int, int]:
        row = table.get(p)
        return (p, row[3] if row is not None else -1)

    def fresh(k: tuple[int, int]) -> bool:
        hit = _pd_cwd_memo.get(k)
        return hit is not None and now < hit[1]

    key = key_of(pid)
    if fresh(key):
        return _pd_cwd_memo[key][0]
    want = [pid] + [p for p in table if p != pid and not fresh(key_of(p))]
    # lsof exits 1 when some pids are gone or hidden but still prints the rest
    out = _pd_run(["lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(map(str, want))], ok=(0, 1))
    if len(_pd_cwd_memo) + len(want) > _PD_CWD_MAX:
        _pd_cwd_memo.clear()
    found = {} if out is None else _pd_parse_lsof_cwd(out)
    # nothing at all came back (timeout, no lsof, or lsof read no pid): a failure for the whole batch,
    # retried later, so the next caller does not pay the same timeout again
    until = float("inf") if found else now + _PD_CWD_RETRY
    for p in want:
        if p in table:   # a pid missing from the table has no start time, so a reused pid could inherit it
            _pd_cwd_memo[key_of(p)] = (found.get(p, ""), until)
    return found.get(pid, "")



# ──────────────────── procs ────────────────────
"""Process-table reads (pid scan, argv, cwd, environ, stat, boot id) from /proc, with the macOS provider dispatched per function."""



_PR_DARWIN = sys.platform == "darwin"


def _pr_clk_tck() -> int:
    try:
        return int(os.sysconf("SC_CLK_TCK"))
    except (ValueError, OSError, AttributeError):
        return 100


def _pr_boot_time() -> float:
    if _PR_DARWIN:
        return _pd_boot_time()
    try:
        with open("/proc/stat", "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("btime "):
                    fields = line.split()
                    if len(fields) >= 2:
                        return float(fields[1])
    except (OSError, ValueError, IndexError):
        pass
    try:
        with open("/proc/uptime", "r", encoding="utf-8", errors="replace") as fh:
            uptime = float(fh.read().split()[0])
        return time.time() - uptime
    except (OSError, ValueError, IndexError):
        return 0.0


def _pr_scan() -> dict[int, tuple[int, int, int, int, int]]:
    """pid -> (ppid, utime, stime, starttime_ticks, tty_nr) read from /proc/<pid>/stat."""
    if _PR_DARWIN:
        return _pd_scan()
    procs: dict[int, tuple[int, int, int, int, int]] = {}
    try:
        entries = os.listdir("/proc")
    except OSError:
        return procs
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f"/proc/{pid}/stat", "rb") as fh:
                data = fh.read()
        except OSError:
            continue
        close = data.rfind(b")")
        if close < 0:
            continue
        fields = data[close + 2:].split()
        if len(fields) < 20:
            continue
        try:
            procs[pid] = (
                int(fields[1]),
                int(fields[11]),
                int(fields[12]),
                int(fields[19]),
                int(fields[4]),
            )
        except ValueError:
            continue
    return procs


def _pr_stat(pid: int) -> tuple[int, int, str] | None:
    """(ppid, starttime_ticks, comm) from /proc/<pid>/stat; None on any error.

    comm sits between the first "(" and the LAST ")", since it may contain spaces and ")" itself.
    """
    if _PR_DARWIN:
        return _pd_stat(pid)
    try:
        with open(f"/proc/{pid}/stat", "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    open_paren = data.find(b"(")
    close = data.rfind(b")")
    if open_paren < 0 or close < open_paren:
        return None
    fields = data[close + 2:].split()
    if len(fields) < 20:
        return None
    try:
        ppid = int(fields[1])
        start = int(fields[19])
    except ValueError:
        return None
    comm = data[open_paren + 1:close].decode("utf-8", "replace")
    return (ppid, start, comm)


def _pr_resident(pid: int, page: int) -> int | None:
    if _PR_DARWIN:
        return _pd_resident(pid, page)
    try:
        with open(f"/proc/{pid}/statm", "r", encoding="utf-8", errors="replace") as fh:
            fields = fh.read().split()
        return int(fields[1]) * page
    except (OSError, IndexError, ValueError):
        return None


def _pr_argv(pid: int) -> list[str]:
    """A process's argv from /proc/<pid>/cmdline; empty on any error."""
    if _PR_DARWIN:
        return _pd_argv(pid)
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            data = fh.read()
    except OSError:
        return []
    return [tok.decode("utf-8", "replace") for tok in data.split(b"\x00") if tok]


def _pr_cwd(pid: int) -> str:
    if _PR_DARWIN:
        return _pd_cwd(pid)
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def _pr_environ(pid: int, keys: tuple[str, ...]) -> dict[str, str]:
    """The variables named in ``keys`` from /proc/<pid>/environ. The rest is never kept: it holds secrets."""
    if _PR_DARWIN:
        return _pd_environ(pid, keys)
    try:
        with open(f"/proc/{pid}/environ", "rb") as fh:
            data = fh.read()
    except OSError:
        return {}
    found: dict[str, str] = {}
    for item in data.split(b"\0"):
        key, sep, value = item.partition(b"=")
        name = key.decode("utf-8", "replace")
        if sep and name in keys:
            found[name] = value.decode("utf-8", "replace")
    return found


def _pr_boot_id() -> str:
    if _PR_DARWIN:
        return _pd_boot_id()
    try:
        with open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""



# ──────────────────── labels ────────────────────
"""Human-readable model names for the UI and the web payloads.

A raw model id (``claude-haiku-5-5``, ``opencode/deepseek-v4.1-flash-free``) becomes the name a person reads
(``Haiku 5.5``, ``DeepSeek V4.1 Flash``). Provider prefixes are stripped first; an id that is not in the map comes back
with only the prefix removed. Versions are never invented: ``gpt-6-sol`` is ``GPT-6 Sol``, not ``GPT-6.1 Sol``.
"""


_PREFIXES = ("opencode-go/", "opencode/", "anthropic/", "cursor-")

# Claude lead models arrive as the short form ``sonnet-5.5``; the version is read from the id, never guessed.
_CLAUDE_SHORT = re.compile(r"(sonnet|opus|haiku)-(\d+)\.(\d+)")

_NAMES = {
    "deepseek-v4.1-flash": "DeepSeek V4.1 Flash",
    "deepseek-v4.1-flash-free": "DeepSeek V4.1 Flash",
    "claude-haiku-5-5": "Haiku 5.5",
    "claude-sonnet-5-5": "Sonnet 5.5",
    "claude-opus-5-5": "Opus 5.5",
    "composer-2.5": "Composer 2.5",
    "gpt-6-sol": "GPT-6 Sol",
    "gpt-6.1-sol": "GPT-6.1 Sol",
    "gpt-6-luna": "GPT-6 Luna",
    "flint-40b-free": "Flint 40B",
    "glm-5.3-flash-free": "GLM-5.3 Flash",
    "grok-4.6-medium": "Grok 4.6",
}


def display_model(raw: str) -> str:
    """The readable name for a raw model id; unknown ids keep their text minus any provider prefix."""
    text = raw or ""
    for prefix in _PREFIXES:
        if text.lower().startswith(prefix):
            text = text[len(prefix):]
            break
    if text.lower() in _NAMES:
        return _NAMES[text.lower()]
    short = _CLAUDE_SHORT.fullmatch(text.lower())
    if short:
        return f"{short[1].capitalize()} {short[2]}.{short[3]}"
    return text



# ──────────────────── registry ────────────────────
"""Validated, read-only execution records. Producers live in register.py."""



REGISTRY_SCHEMA = 1
MAX_ARTIFACT_BYTES = 16 * 1024 * 1024
_rg_id = re.compile(r"^[a-f0-9]{64}$")
_rg_harnesses = {"codex", "t3", "claude", "cursor", "opencode", "openclaw", "other"}
_rg_numbers = {"registered", "started", "activity", "ended", "cost"}
_rg_integers = {"pid", "pid_start", "exit_code", "context_tokens", "tokens_in", "tokens_out", "tokens_cache", "revision"}
_rg_booleans = {"output_available"}
_rg_cache: dict[str, tuple[tuple[int, int, int], ExecutionRecord]] = {}


def registry_root() -> str:
    override = os.environ.get("STATUS_REGISTRY_ROOT")
    return os.path.expanduser(override) if override else home_path("status-registry")


default_registry_root = registry_root   # alias so the joined station has the same name collect.py imports


def execution_key(harness: str, account: str, native_id: str) -> str:
    return hashlib.sha256(json.dumps([harness, account, native_id], separators=(",", ":")).encode()).hexdigest()


def validate_execution(data: object) -> ExecutionRecord:
    if not isinstance(data, dict) or type(data.get("schema")) is not int or data["schema"] != REGISTRY_SCHEMA:
        raise ValueError("unsupported record schema")
    allowed = {f.name for f in fields(ExecutionRecord)}
    values = {k: v for k, v in data.items() if k in allowed}
    for key, value in values.items():
        if key == "schema":
            continue
        if key in _rg_integers:
            if key == "revision" and value is None:
                raise ValueError("invalid revision")
            if value is not None and type(value) is not int:
                raise ValueError("invalid integer")
        elif key in _rg_numbers:
            if key in ("registered", "started", "activity") and value is None:
                raise ValueError("invalid required timestamp")
            if value is not None and (type(value) not in (int, float) or not math.isfinite(value) or value < 0):
                raise ValueError("invalid timestamp or cost")
        elif key in _rg_booleans:
            if type(value) is not bool:
                raise ValueError("invalid boolean")
        elif not isinstance(value, str):
            raise ValueError("invalid string")
    identity = values.get("execution_id", "")
    if not _rg_id.fullmatch(identity):
        raise ValueError("invalid execution identity")
    if values.get("harness") not in _rg_harnesses or values.get("role", "worker") not in ("lead", "worker"):
        raise ValueError("invalid harness or role")
    for key in ("parent_id", "root_id"):
        if values.get(key) and not _rg_id.fullmatch(values[key]):
            raise ValueError("invalid parent identity")
    for kind, key in (("brief", "brief_ref"), ("result", "result_ref")):
        if values.get(key) and values[key] != f"artifacts/{identity}/{kind}.txt":
            raise ValueError("invalid artifact reference")
    if values.get("state", "running") not in ("running", "idle", "closed", "finished"):
        raise ValueError("invalid execution state")
    if values.get("outcome", "unknown") not in ("unknown", "success", "failed", "cancelled"):
        raise ValueError("invalid execution outcome")
    if values.get("pid") is not None and values["pid"] <= 0:
        raise ValueError("invalid process identity")
    return ExecutionRecord(**values)


def _rg_regular(root: Path, path: Path) -> bool:
    try:
        relative = path.relative_to(root)
        here = root
        for part in relative.parts:
            here = here / part
            if here.is_symlink():
                return False
        return path.is_file() and path.resolve().is_relative_to(root.resolve())
    except (OSError, ValueError):
        return False


def read_registry(root: str) -> RegistrySnapshot:
    base = Path(root)
    snap = RegistrySnapshot()
    folder = base / "records"
    if folder.is_symlink():
        snap.diagnostics.append("registry records directory is a symlink")
        return snap
    try:
        paths = sorted(folder.glob("*.json"))
    except OSError:
        snap.diagnostics.append("registry records unavailable")
        return snap
    for path in paths:
        try:
            if not _rg_regular(base, path) or path.stat().st_size > 256 * 1024:
                raise ValueError("unsafe or oversized record")
            stat = path.stat()
            fingerprint = (stat.st_ino, stat.st_mtime_ns, stat.st_size)
            cached = _rg_cache.get(str(path))
            record = cached[1] if cached and cached[0] == fingerprint else validate_execution(json.loads(path.read_text()))
            if path.stem != record.execution_id:
                raise ValueError("record identity does not match filename")
            _rg_cache[str(path)] = (fingerprint, record)
            snap.records.append(record)
        except (OSError, ValueError, TypeError, UnicodeError, RecursionError):
            snap.diagnostics.append(f"invalid execution record {path.stem[:12]}")
    present = {str(p) for p in paths}
    for key in list(_rg_cache):
        if str(Path(key).parent) == str(folder) and key not in present:
            del _rg_cache[key]
    return snap


def read_execution_artifact(root: str, execution_id: str, kind: str) -> list[str]:
    if not _rg_id.fullmatch(execution_id) or kind not in ("brief", "result"):
        return []
    base = Path(root)
    path = base / "artifacts" / execution_id / (kind + ".txt")
    if not _rg_regular(base, path):
        return []
    try:
        if path.stat().st_size > MAX_ARTIFACT_BYTES:
            return ["artifact exceeds the supported 16 MiB limit; full content was not loaded"]
        return path.read_text(encoding="utf-8").replace("\t", "    ").splitlines()
    except (OSError, UnicodeError):
        return []



# ──────────────────── native ────────────────────
"""Native execution evidence. Never assign a transcript to a process by cwd alone.

Supported stores (all read-only):
- Codex / T3 Code: ~/.codex/sessions/**/*.jsonl. T3 is split out only when session_meta originator names T3.
- Claude personal / work: ~/.claude*/projects/**/*.jsonl; subagent files link to the parent sessionId.
- OpenCode: ~/.local/share/opencode/opencode.db (session_v2 + session_message).
- OpenClaw (openclaw agent only): ~/.openclaw/agents/openclaw/agent/openclaw-agent.sqlite session_nodes.entry_json.
- Cursor: ~/.cursor/projects/*/agent-transcripts/*/*.jsonl, with cwd/times from only the
  schemaVersion, createdAtMs, updatedAtMs and cwd fields of ~/.cursor/chats/*/*/meta.json.
  store.db is opaque and never read. Task children match an exact <user_query> prompt after
  CRLF normalization and outer whitespace trimming; ambiguous matches remain unlinked.
"""



__all__ = ["execution_key", "read_native_executions"]
_nv_cache: dict[str, dict] = {}
_NV_HEAD = 4096
_NV_TAIL = 256
_NV_HOPS = 32
_NV_SCAN_LIMIT = 400
_NV_OVERSIZE_NOTE = "(native event over 16 MiB not loaded)"
_NV_TEXT_PARTS = ("input_text", "output_text", "text")
_NV_STORED_CAP = 1024 * 1024          # max UTF-8 bytes kept for a stored brief or result
_NV_TRUNC_MARK = "\n[truncated]"
_NV_CURSOR_HEAD = 64 * 1024
_NV_CURSOR_TAIL = 64 * 1024
_nv_cursor_cache: dict[str, dict] = {}
# Metrics parsed by the native scan, readable by the collector without touching the record: (harness, native id) -> dict.
_nv_metrics: dict[tuple[str, str], dict] = {}
_nv_metric_paths: dict[tuple[str, str], str] = {}


def _nv_time(value: object) -> float:
    if type(value) in (int, float):
        return float(value) / 1000 if value > 100_000_000_000 else float(value)
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value).timestamp()
        except ValueError:
            pass
    return 0.0


def _nv_int(value: object) -> int | None:
    return value if type(value) is int and value >= 0 else None


def _nv_sum(*values: int | None) -> int | None:
    """The sum of the counters that were read; None when every one is an absent column or SQL NULL.

    A measured 0 therefore stays 0, while a store that does not carry the counter at all stays unknown.
    """
    known = [value for value in values if value is not None]
    return sum(known) if known else None


def _nv_text(value: object) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return "\n".join(str(part.get("text", "")) for part in value
                         if isinstance(part, dict) and part.get("type") in _NV_TEXT_PARTS)
    return ""


def _nv_cap(text: str) -> str:
    """Bound a stored brief/result to _NV_STORED_CAP UTF-8 bytes, ending in a '[truncated]' marker line."""
    if len(text) <= _NV_STORED_CAP // 4:
        return text                      # every char is at most 4 UTF-8 bytes: already within the cap
    raw = text.encode("utf-8", "replace")
    if len(raw) <= _NV_STORED_CAP:
        return text
    keep = _NV_STORED_CAP - len(_NV_TRUNC_MARK.encode("utf-8"))
    return raw[:keep].decode("utf-8", "ignore") + _NV_TRUNC_MARK


def _nv_goal(brief: str) -> tuple[str, str]:
    if not brief:
        return "", ""
    match = re.search(r"^Goal:\s*(.+)$", brief, re.MULTILINE | re.IGNORECASE)
    if match:
        return match.group(1).strip(), "native task"
    return " ".join(brief.split())[:240], "native excerpt"


def _nv_sig(path: Path, start: int, length: int) -> str:
    with path.open("rb") as stream:
        stream.seek(start)
        return hashlib.sha256(stream.read(length)).hexdigest()


def _nv_lines(stream, limit: int):
    """Yield (begin, raw, complete). Oversized lines yield raw=None and are consumed only once terminated."""
    while True:
        begin = stream.tell()
        raw = stream.readline(limit + 1)
        if not raw:
            return
        if len(raw) > limit:
            while not raw.endswith(b"\n"):
                chunk = stream.readline(limit + 1)
                if not chunk:
                    stream.seek(begin)   # still being appended: retry the whole line later
                    return
                raw = chunk
            yield begin, None, True
            continue
        yield begin, raw, raw.endswith(b"\n")


def _nv_start(obj: dict, body: dict, family: str, account: str, path: Path, stamp: float) -> ExecutionRecord | None:
    typ = obj.get("type")
    if family == "codex":
        if typ != "session_meta":
            return None
        sid = str(body.get("id", body.get("session_id", "")))
        if not sid:
            return None
        source = body.get("source")
        sub = source.get("subagent") if isinstance(source, dict) else None
        spawn = sub.get("thread_spawn") if isinstance(sub, dict) else None
        parent = str(spawn.get("parent_thread_id", "")) if isinstance(spawn, dict) else ""
        tokens = re.findall(r"[a-z0-9]+", str(body.get("originator", "")).lower())
        actual = "t3" if "t3" in tokens else "codex"
        return ExecutionRecord(execution_key(actual, account, sid), harness=actual, account=account, native_id=sid,
                               role="worker" if parent or source == "exec" else "lead", cwd=str(body.get("cwd", "")),
                               parent_id=execution_key(actual, account, parent) if parent else "",
                               linkage="native" if parent else "unknown",
                               started=stamp or _nv_time(body.get("timestamp")), source=str(path))
    if family == "claude" and obj.get("sessionId"):
        parent = str(obj["sessionId"])
        child = str(obj.get("agentId", "")) if "subagents" in path.parts[:-1] else ""
        headless = obj.get("entrypoint") in ("sdk-cli", "sdk-ts") or obj.get("promptSource") == "sdk"
        return ExecutionRecord(execution_key("claude", account, child or parent), harness="claude", account=account,
                               native_id=child or parent, role="worker" if child or headless else "lead", cwd=str(obj.get("cwd", "")),
                               title=_nv_subagent_description(path) if child else "",
                               parent_id=execution_key("claude", account, parent) if child else "",
                               linkage="native" if child else "unknown", started=stamp, source=str(path))
    return None


def _nv_subagent_description(path: Path) -> str:
    """The task a Claude subagent was given: the ``description`` in the ``.meta.json`` beside its transcript."""
    try:
        with open(path.with_suffix(".meta.json"), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return ""
    text = data.get("description") if isinstance(data, dict) else ""
    return text.strip()[:80] if isinstance(text, str) else ""


def _nv_codex_counts(usage: object) -> tuple[int, int, int] | None:
    """(input, output incl. reasoning, cache) counters of one codex usage object."""
    if not isinstance(usage, dict):
        return None
    return (_nv_int(usage.get("input_tokens")) or 0,
            (_nv_int(usage.get("output_tokens")) or 0) + (_nv_int(usage.get("reasoning_output_tokens")) or 0),
            (_nv_int(usage.get("cached_input_tokens")) or 0) + (_nv_int(usage.get("cache_write_input_tokens")) or 0))


def _nv_codex_window(payload: dict) -> int | None:
    """A codex event's ``model_context_window``, at the payload root or under ``info``."""
    for row in (payload, payload.get("info")):
        if isinstance(row, dict):
            value = row.get("model_context_window")
            if isinstance(value, int) and not isinstance(value, bool) and value > 0:
                return value
    return None


def _nv_opencode_window(model_id: object, reported: object = None) -> int | None:
    """Known OpenCode model windows, unless the database reports one directly."""
    if type(reported) is int and reported > 0:
        return reported
    if not isinstance(model_id, str):
        return None
    model = model_id.lower()
    if "claude" in model and re.search(r"(?:haiku|sonnet|opus)[- .]?5", model):
        return 1_000_000 if "1m" in model else 200_000
    if "deepseek" in model and "v4" in model:
        return 128_000
    return None


def _nv_codex_metrics(record: ExecutionRecord, st: dict, typ: object, payload: dict) -> None:
    """Codex rollout usage (cumulative thread counters) and the model's context window."""
    total = last = None
    if typ == "token_usage_record":
        total, last = payload.get("thread_token_usage") or payload.get("usage"), payload.get("usage")
    elif typ == "event_msg":
        info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
        if payload.get("type") == "token_count":
            total, last = info.get("total_token_usage"), info.get("last_token_usage")
        window = _nv_codex_window(payload)
        if window is not None:
            st["ctx_window"] = window
    counts = _nv_codex_counts(total)
    if counts is not None:
        record.tokens_in, record.tokens_out, record.tokens_cache = counts
    last_counts = _nv_codex_counts(last)
    if last_counts is not None and last_counts[0] > 0:
        record.context_tokens = last_counts[0]   # the last request's input is the context in use


def _nv_model_window(model_usage: object) -> int | None:
    """The largest ``contextWindow`` in a claude ``modelUsage`` block; None when it has none."""
    if not isinstance(model_usage, dict):
        return None
    windows = [row.get("contextWindow") for row in model_usage.values() if isinstance(row, dict)]
    windows = [value for value in windows if isinstance(value, int) and not isinstance(value, bool) and value > 0]
    return max(windows) if windows else None


def _nv_claude_metrics(record: ExecutionRecord, st: dict, obj: dict) -> None:
    """Cumulative Claude usage (one count per message id) and the model's context window."""
    typ = obj.get("type")
    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
    usage = message.get("usage") if isinstance(message.get("usage"), dict) else None
    msg_id = message.get("id")
    if typ == "assistant" and usage is not None and isinstance(msg_id, str) and msg_id:
        row = ((_nv_int(usage.get("input_tokens")) or 0) + (_nv_int(usage.get("cache_creation_input_tokens")) or 0),
               _nv_int(usage.get("output_tokens")) or 0,
               _nv_int(usage.get("cache_read_input_tokens")) or 0)
        ids = st.setdefault("usage_ids", {})
        totals = st.setdefault("usage_totals", [0, 0, 0])
        previous = ids.get(msg_id)
        if previous is not None:
            for index in range(3):
                totals[index] -= previous[index]
        ids[msg_id] = row
        for index, value in enumerate(row):
            totals[index] += value
        record.tokens_in, record.tokens_out, record.tokens_cache = totals
        context = row[0] + row[2]
        if context > 0:      # zero usage = a synthetic message: keep the last real context
            record.context_tokens = context
    window = _nv_model_window(obj.get("modelUsage"))
    if window is not None:
        st["ctx_window"] = window
    result_usage = obj.get("usage") if typ == "result" and isinstance(obj.get("usage"), dict) else None
    if result_usage is not None:
        record.tokens_in = (_nv_int(result_usage.get("input_tokens")) or 0) + (
            _nv_int(result_usage.get("cache_creation_input_tokens")) or 0)
        record.tokens_out = _nv_int(result_usage.get("output_tokens")) or 0
        record.tokens_cache = _nv_int(result_usage.get("cache_read_input_tokens")) or 0


def _nv_apply(st: dict, obj: dict, family: str, account: str, path: Path) -> None:
    stamp = _nv_time(obj.get("timestamp"))
    typ = obj.get("type")
    body = obj.get("payload", {}) if family == "codex" else obj
    if not isinstance(body, dict):
        return
    if st["record"] is None:
        st["record"] = _nv_start(obj, body, family, account, path, stamp)
        if st["record"] is None:
            return
    record = st["record"]
    record.activity = max(record.activity, stamp)
    if (family == "claude" and record.role == "lead" and
            (obj.get("entrypoint") in ("sdk-cli", "sdk-ts") or obj.get("promptSource") == "sdk")):
        record.role = "worker"
    if family == "claude" and not record.cwd and isinstance(obj.get("cwd"), str):
        record.cwd = obj["cwd"]   # first line may lack cwd (SDK/RC transcripts); take it from the first later line that has one
    if family == "claude" and record.role == "worker":
        message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
        content = message.get("content")
        blocks = content if isinstance(content, list) else []
        pending = st.setdefault("pending_tools", set())
        if typ == "assistant":
            pending.update(block["id"] for block in blocks if isinstance(block, dict)
                           and block.get("type") == "tool_use" and isinstance(block.get("id"), str))
            st["claude_tail"] = "end_turn" if message.get("stop_reason") == "end_turn" else "other"
        elif typ == "user":
            has_tool_result = False
            for block in blocks:
                if isinstance(block, dict) and block.get("type") == "tool_result":
                    has_tool_result = True
                    tool_id = block.get("tool_use_id")
                    if isinstance(tool_id, str):
                        pending.discard(tool_id)
            if has_tool_result or obj.get("isMeta") is not True:
                st["claude_tail"] = "other"
        elif typ in ("result", "system"):
            subtype = obj.get("subtype")
            if obj.get("is_error") is True or subtype in ("error", "failed", "errored"):
                st["claude_tail"] = "failed"
            elif subtype in ("stopped", "cancelled", "aborted"):
                st["claude_tail"] = "cancelled"
            elif typ == "result" and subtype == "success" and not pending:
                st["claude_tail"] = "success"
    if typ == "turn_context":
        record.model = str(body.get("model", record.model))
        record.effort = str(body.get("effort", record.effort))
    if family == "codex":
        _nv_codex_metrics(record, st, typ, body)
    elif family == "claude":
        _nv_claude_metrics(record, st, obj)
    message = obj.get("message", {}) if family == "claude" else body
    if isinstance(message, dict):
        role = message.get("role", typ)
        text = _nv_text(message.get("content", ""))
        if role == "user" and text and not st["brief"] and obj.get("isMeta") is not True:
            st["brief"] = _nv_cap(text)
        if role == "user" and family == "claude":
            st["result"] = ""
            record.output_available = False
        if role == "assistant" and text:
            st["result"] = _nv_cap(text)
            record.output_available = True
        if message.get("model") and message["model"] != "<synthetic>":   # placeholder for error messages: no model
            record.model = str(message["model"])
    kind = body.get("type")
    if typ == "event_msg" and kind in ("task_complete", "turn_complete", "turn_aborted", "task_failed"):
        ended = stamp or st.get("mtime", 0) / 1e9
        record.outcome = {"task_complete": "success", "turn_complete": "success",
                          "turn_aborted": "cancelled", "task_failed": "failed"}[kind]
        if record.role == "worker":
            record.state, record.ended = "finished", ended
        else:
            record.state = "idle"
        st["result"] = _nv_cap(str(body.get("last_agent_message", st["result"]))) or st["result"]


def _nv_claude_finish(st: dict, mtime: float, now: float) -> None:
    record = st["record"]
    if record is None or record.role != "worker":
        return
    tail = st.get("claude_tail")
    if tail == "failed":
        record.outcome = "failed"
    elif tail == "cancelled":
        record.outcome = "cancelled"
    elif tail == "success" or (tail == "end_turn" and not st.get("pending_tools") and now - mtime >= QUIET_S):
        record.outcome = "success"
    else:
        record.outcome = "unknown"
    record.state = "finished" if record.outcome != "unknown" else "running"
    record.ended = (record.activity or mtime) if record.state == "finished" else None


def _nv_jsonl(path: Path, family: str, account: str, now: float) -> ExecutionEvidence | None:
    try:
        stat = path.stat()
        st = _nv_cache.get(str(path))
        if st is not None:
            valid = (st["ino"] == stat.st_ino and stat.st_size >= st["offset"]
                     and _nv_sig(path, 0, st["head_len"]) == st["head"]
                     and _nv_sig(path, st["offset"] - st["tail_len"], st["tail_len"]) == st["tail"])
            if valid and stat.st_size == st["size"]:
                if stat.st_mtime_ns == st["mtime"]:
                    if family == "claude":
                        _nv_claude_finish(st, stat.st_mtime, now)
                    return st["evidence"]
                valid = False           # same-size rewrite: mtime moved while size did not
            if not valid:
                st = None
        if st is None:
            st = {"ino": stat.st_ino, "offset": 0, "record": None, "brief": "", "result": "", "oversized": False}
        start = st["offset"]
        with path.open("rb") as stream:
            stream.seek(start)
            for begin, raw, complete in _nv_lines(stream, MAX_ARTIFACT_BYTES):
                if raw is None:
                    st["oversized"] = True   # diagnosed, never truncated into partial JSON
                    continue
                if not raw.strip():
                    continue
                try:
                    obj = json.loads(raw)
                except (ValueError, UnicodeError, RecursionError):
                    if complete:
                        continue             # malformed complete line: skip, keep parsing
                    stream.seek(begin)       # incomplete append: retry this line later
                    break
                if not isinstance(obj, dict):
                    if not complete:
                        stream.seek(begin)
                        break
                    continue
                _nv_apply(st, obj, family, account, path)
            st["offset"] = stream.tell()
        st.update(size=stat.st_size, mtime=stat.st_mtime_ns, head_len=min(_NV_HEAD, st["offset"]),
                  tail_len=min(_NV_TAIL, st["offset"]))
        st["head"] = _nv_sig(path, 0, st["head_len"])
        st["tail"] = _nv_sig(path, st["offset"] - st["tail_len"], st["tail_len"])
        record = st["record"]
        if record is None:
            st["evidence"] = None
            _nv_cache[str(path)] = st
            return None
        if family == "claude":
            _nv_claude_finish(st, stat.st_mtime, now)
        record.goal, record.purpose_source = _nv_goal(st["brief"])
        if st["oversized"]:
            record.goal = f"{record.goal} {_NV_OVERSIZE_NOTE}".strip()
        _nv_metrics_put(record.harness, record.native_id, _nv_record_metrics(record, st), path)
        st["evidence"] = ExecutionEvidence(record, brief=st["brief"], result=st["result"])
        _nv_cache[str(path)] = st
        return st["evidence"]
    except (OSError, ValueError, TypeError, AttributeError, KeyError):
        return None


def _nv_db_text(conn: sqlite3.Connection, sid: str, kind: str) -> tuple[str, bool]:
    order = "ASC" if kind == "user" else "DESC"
    oversize = False
    rows = conn.execute(f"SELECT data FROM session_message WHERE session_id=? AND type=? ORDER BY seq {order} LIMIT 5",
                        (sid, kind)).fetchall()
    for (raw,) in rows:
        if raw is None or len(raw) > MAX_ARTIFACT_BYTES:
            oversize = True
            continue
        try:
            data = json.loads(raw)
        except (ValueError, RecursionError):
            continue
        if not isinstance(data, dict):
            continue
        text = _nv_text(data.get("text", data.get("content", data.get("parts", "")))) if kind == "user" \
            else _nv_text(data.get("content", data.get("parts", "")))
        if text:
            return _nv_cap(text), oversize
    return "", oversize


def _nv_opencode(home: str) -> list[ExecutionEvidence]:
    path = Path(home) / ".local/share/opencode/opencode.db"
    if not path.is_file():
        return []
    items = []
    try:
        with sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1) as conn:
            columns = {row[1] for row in conn.execute("PRAGMA table_info(session_v2)")}
            extra = [name for name in ("cost", "tokens_input", "tokens_output", "tokens_reasoning",
                                       "tokens_cache_read", "tokens_cache_write") if name in columns]
            rows = conn.execute("SELECT id,parent_id,directory,title,model,time_created,time_updated,time_idle,idle_outcome"
                                + "".join(", " + name for name in extra)
                                + " FROM session_v2 WHERE time_archived IS NULL ORDER BY time_updated DESC LIMIT ?",
                                (_NV_SCAN_LIMIT,)).fetchall()
            for row in rows:
                sid, parent, cwd, title, model, created, updated, idle, outcome = row[:9]
                counts = dict(zip(extra, row[9:]))
                record = ExecutionRecord(execution_key("opencode", "personal", sid), harness="opencode", account="personal", native_id=sid,
                                         role="worker" if parent else "lead", parent_id=execution_key("opencode", "personal", parent) if parent else "",
                                         linkage="native" if parent else "unknown", cwd=cwd or "", title=title or "",
                                         started=_nv_time(created), activity=_nv_time(updated), source=str(path))
                record.tokens_in = _nv_int(counts.get("tokens_input"))
                record.tokens_out = _nv_sum(_nv_int(counts.get("tokens_output")),
                                            _nv_int(counts.get("tokens_reasoning")))
                record.tokens_cache = _nv_sum(_nv_int(counts.get("tokens_cache_read")),
                                              _nv_int(counts.get("tokens_cache_write")))
                cost = counts.get("cost")
                record.cost = float(cost) if type(cost) in (int, float) and cost >= 0 else None
                try:
                    record.model = str(json.loads(model or "{}").get("id", ""))
                except (ValueError, AttributeError):
                    pass
                brief, over_user = _nv_db_text(conn, sid, "user")
                result, over_asst = _nv_db_text(conn, sid, "assistant")
                if idle and _nv_time(idle) >= record.activity:
                    record.state = "finished" if parent else "idle"
                    if parent:
                        record.ended = _nv_time(idle)
                        record.outcome = {"succeeded": "success", "failed": "failed", "error": "failed",
                                          "interrupted": "cancelled"}.get(outcome or "", "unknown")
                record.goal, record.purpose_source = _nv_goal(brief)
                if over_user or over_asst:
                    record.goal = f"{record.goal} {_NV_OVERSIZE_NOTE}".strip()
                record.output_available = bool(result)
                _nv_metrics_put(record.harness, record.native_id,
                                {"tokens_in": record.tokens_in, "tokens_out": record.tokens_out,
                                 "tokens_cache": record.tokens_cache, "cost": record.cost,
                                 "ctx_tokens": None, "ctx_window": None,
                                 "tokens_total": _metric_tokens_total(
                                     {"tokens_in": record.tokens_in, "tokens_out": record.tokens_out})}, path)
                items.append(ExecutionEvidence(record, brief=brief, result=result))
    except (OSError, sqlite3.Error):
        return items
    return items


def _nv_openclaw(home: str) -> list[ExecutionEvidence]:
    path = Path(home) / ".openclaw/agents/openclaw/agent/openclaw-agent.sqlite"
    if not path.is_file():
        return []
    items = []
    try:
        with sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1) as conn:
            rows = conn.execute("SELECT session_key, entry_json FROM session_nodes LIMIT 5000").fetchall()
    except sqlite3.Error:
        return []
    for key, raw in rows:
        try:
            entry = json.loads(raw)
        except (ValueError, TypeError, RecursionError):
            continue
        if not isinstance(entry, dict) or not isinstance(key, str) or not key:
            continue
        parent = entry.get("parentSessionKey") if isinstance(entry.get("parentSessionKey"), str) else ""
        usage = entry.get("usage") if isinstance(entry.get("usage"), dict) else entry
        status = str(entry.get("status") or "")
        ended = _nv_time(entry.get("endedAt")) or None
        record = ExecutionRecord(execution_key("openclaw", "openclaw", key), harness="openclaw", account="openclaw", native_id=key,
                                 role="worker" if parent else "lead", cwd=str(entry.get("spawnedWorkspaceDir", "")),
                                 parent_id=execution_key("openclaw", "openclaw", parent) if parent else "",
                                 linkage="native" if parent else "unknown",
                                 title=str(entry.get("displayName") or entry.get("label") or ""),
                                 model=str(entry.get("model", "")), started=_nv_time(entry.get("startedAt")),
                                 activity=_nv_time(entry.get("lastActivityAt") or entry.get("updatedAt") or entry.get("endedAt")
                                                   or entry.get("startedAt")),
                                 ended=ended, source=str(path))
        record.tokens_in = _nv_int(usage.get("inputTokens"))
        record.tokens_out = _nv_int(usage.get("outputTokens"))
        record.tokens_cache = _nv_sum(_nv_int(usage.get("cacheRead")), _nv_int(usage.get("cacheWrite")))
        cost = entry.get("estimatedCostUsd")
        record.cost = float(cost) if type(cost) in (int, float) and cost >= 0 else None
        if status in ("done", "failed", "killed"):
            record.state = "finished" if parent else "idle"
            if parent:
                record.outcome = {"done": "success", "failed": "failed", "killed": "cancelled"}[status]
        if not parent or status in ("running", ""):
            record.state = "running" if not ended and status in ("running", "") else record.state
        # Hosted OpenClaw sessions have no transcript brief here: the gap is reported, not guessed.
        record.purpose_source = "missing brief"
        items.append(ExecutionEvidence(record))
    return items


def _nv_cursor_query(text: str) -> str:
    """Take one Cursor user_query block; normalize CRLF and trim only its outside whitespace."""
    matches = re.findall(r"<user_query>(.*?)</user_query>", text, re.DOTALL)
    return matches[0].replace("\r\n", "\n").strip() if len(matches) == 1 else ""


def _nv_cursor_prompt(text: str) -> str:
    return text.replace("\r\n", "\n").strip()


def _nv_cursor_blocks(obj: dict) -> list[dict]:
    message = obj.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    return [part for part in content if isinstance(part, dict)] if isinstance(content, list) else []


def _nv_cursor_file(path: Path) -> dict | None:
    """Cache a bounded first query, incremental Task scan, and bounded status/output tail."""
    try:
        stat = path.stat()
        key = str(path)
        st = _nv_cursor_cache.get(key)
        if st is not None:
            valid = (st["ino"] == stat.st_ino and stat.st_size >= st["offset"]
                     and _nv_sig(path, 0, st["head_len"]) == st["head"]
                     and _nv_sig(path, st["offset"] - st["tail_len"], st["tail_len"]) == st["tail"])
            if valid and stat.st_size == st["size"] and stat.st_mtime_ns == st["mtime"]:
                return st
            if not valid or (stat.st_size == st["size"] and stat.st_mtime_ns != st["mtime"]):
                st = None
        if st is None:
            st = {"ino": stat.st_ino, "offset": 0, "brief": "", "prompts": set(), "oversized": False,
                  "started": 0.0}
        with path.open("rb") as stream:
            stream.seek(st["offset"])
            for begin, raw, complete in _nv_lines(stream, MAX_ARTIFACT_BYTES):
                if raw is None:
                    st["oversized"] = True
                    continue
                if not complete:
                    stream.seek(begin)
                    break
                try:
                    obj = json.loads(raw)
                except (ValueError, UnicodeError, RecursionError):
                    continue
                if not isinstance(obj, dict):
                    continue
                if not st["started"]:
                    st["started"] = _nv_time(obj.get("timestamp"))
                blocks = _nv_cursor_blocks(obj)
                if obj.get("role") == "user" and not st["brief"] and begin < _NV_CURSOR_HEAD:
                    text = "".join(part.get("text", "") for part in blocks
                                   if part.get("type") == "text" and isinstance(part.get("text"), str))
                    st["brief"] = _nv_cap(_nv_cursor_query(text))
                if obj.get("role") == "assistant":
                    for part in blocks:
                        if part.get("type") != "tool_use":
                            continue
                        data = part.get("input")
                        if part.get("name") == "CallDynamicTool" and isinstance(data, dict) and data.get("toolName") == "Task":
                            data = data.get("arguments")
                        elif part.get("name") != "Task":
                            continue
                        prompt = data.get("prompt") if isinstance(data, dict) else None
                        if isinstance(prompt, str) and _nv_cursor_prompt(prompt):
                            st["prompts"].add(_nv_cursor_prompt(prompt))
            st["offset"] = stream.tell()
            stream.seek(max(0, stat.st_size - _NV_CURSOR_TAIL))
            if stream.tell():
                stream.readline()  # discard a partial first line
            tail = stream.read(_NV_CURSOR_TAIL)
        st["status"], st["result"] = "", ""
        for raw in tail.splitlines():
            if len(raw) > MAX_ARTIFACT_BYTES:
                st["oversized"] = True
                continue
            try:
                obj = json.loads(raw)
            except (ValueError, UnicodeError, RecursionError):
                continue
            if not isinstance(obj, dict):
                continue
            if obj.get("type") == "turn_ended" and isinstance(obj.get("status"), str):
                st["status"] = obj["status"]
            elif obj.get("role") == "user":
                st["status"] = ""  # a new turn supersedes the prior turn_ended
                st["result"] = ""
            elif obj.get("role") == "assistant":
                text = "\n".join(part["text"] for part in _nv_cursor_blocks(obj)
                                 if part.get("type") == "text" and isinstance(part.get("text"), str))
                if text:
                    st["result"] = _nv_cap(text)
        st.update(size=stat.st_size, mtime=stat.st_mtime_ns, head_len=min(_NV_HEAD, st["offset"]),
                  tail_len=min(_NV_TAIL, st["offset"]))
        st["head"] = _nv_sig(path, 0, st["head_len"])
        st["tail"] = _nv_sig(path, st["offset"] - st["tail_len"], st["tail_len"])
        _nv_cursor_cache[key] = st
        return st
    except (OSError, ValueError, TypeError, AttributeError, KeyError):
        return None


def _nv_cursor(home: str, now: float) -> list[ExecutionEvidence]:
    base = Path(home) / ".cursor"
    project_root = base / "projects"
    chat_root = base / "chats"
    if not project_root.is_dir():
        return []
    metadata: dict[str, dict] = {}
    cwd_slugs: dict[str, set[str]] = {}
    try:
        meta_paths = chat_root.glob("*/*/meta.json")
        chat_root_resolved = chat_root.resolve()
        for path in meta_paths:
            try:
                if path.is_symlink() or not path.resolve().is_relative_to(chat_root_resolved) or path.stat().st_size > _NV_CURSOR_HEAD:
                    continue
                with path.open("rb") as stream:
                    data = json.load(stream)
            except (OSError, ValueError, RecursionError):
                continue
            if not isinstance(data, dict) or not isinstance(data.get("schemaVersion"), int):
                continue
            chat_id = path.parent.name
            if chat_id in metadata:
                metadata[chat_id] = {}  # duplicate identity is not trustworthy
                continue
            meta = {name: data.get(name) for name in ("schemaVersion", "createdAtMs", "updatedAtMs", "cwd")}
            metadata[chat_id] = meta
            cwd = meta["cwd"]
            if isinstance(cwd, str) and os.path.isabs(cwd):
                for ancestor in (Path(cwd), *Path(cwd).parents):
                    slug = re.sub(r"[^A-Za-z0-9]+", "-", str(ancestor)).strip("-")
                    cwd_slugs.setdefault(slug, set()).add(str(ancestor))
    except (OSError, ValueError, RecursionError):
        pass
    try:
        root = project_root.resolve()
        stamped = []
        for path in project_root.glob("*/agent-transcripts/*/*.jsonl"):
            try:
                if path.is_symlink() or not path.resolve().is_relative_to(root) or path.stem != path.parent.name:
                    continue
                stamped.append((path.stat().st_mtime, path))
            except OSError:
                continue
    except OSError:
        return []
    stamped.sort(key=lambda pair: pair[0], reverse=True)
    items = []
    prompts: dict[str, set[str]] = {}
    for mtime, path in stamped[:_NV_SCAN_LIMIT]:
        parsed = _nv_cursor_file(path)
        if parsed is None:
            continue
        sid = path.stem
        meta = metadata.get(sid)
        has_meta = bool(meta)
        cwd = meta.get("cwd") if has_meta and isinstance(meta.get("cwd"), str) else ""
        if not cwd:
            candidates = cwd_slugs.get(path.parents[2].name, set())
            cwd = next(iter(candidates)) if len(candidates) == 1 else ""
        if os.sep + ".stage" + os.sep in cwd:
            cwd = cwd.split(os.sep + ".stage" + os.sep, 1)[0]
        started = (_nv_time(meta.get("createdAtMs")) or mtime) if has_meta else (parsed["started"] or mtime)
        activity = max(_nv_time(meta.get("updatedAtMs")) if has_meta else 0.0, mtime)
        record = ExecutionRecord(execution_key("cursor", "personal", sid), harness="cursor", account="personal",
                                 native_id=sid, role="lead" if has_meta else "worker", cwd=cwd,
                                 title="" if has_meta else "Cursor task (unlinked)",
                                 started=started, activity=activity, source=str(path))
        status = parsed["status"]
        if status:
            record.outcome = {"success": "success", "error": "failed", "failed": "failed",
                              "aborted": "cancelled", "cancelled": "cancelled"}.get(status, "unknown")
            record.state = "idle" if has_meta else "finished"
            if not has_meta:
                record.ended = activity
        elif now - activity >= ACTIVE_S:
            record.state = "idle" if has_meta else "finished"
            if not has_meta:
                record.ended = activity
        record.goal, record.purpose_source = _nv_goal(parsed["brief"])
        if parsed["oversized"]:
            record.goal = f"{record.goal} {_NV_OVERSIZE_NOTE}".strip()
        record.output_available = bool(parsed["result"])
        items.append(ExecutionEvidence(record, brief=parsed["brief"], result=parsed["result"]))
        for prompt in parsed["prompts"]:
            prompts.setdefault(prompt, set()).add(sid)
    for item in items:
        record = item.record
        if record.role != "worker":
            continue
        matches = prompts.get(_nv_cursor_prompt(item.brief), set()) - {record.native_id}
        if len(matches) == 1:
            record.parent_id = execution_key("cursor", "personal", next(iter(matches)))
            record.linkage = "native"
            record.title = "Cursor task"
            if not record.cwd:
                record.cwd = next((parent.record.cwd for parent in items
                                   if parent.record.execution_id == record.parent_id), "")
        elif len(matches) > 1:
            record.title = "Cursor task (ambiguous, unlinked)"
    return items


def _nv_scan(base: Path, account: str, family: str, now: float) -> list[ExecutionEvidence]:
    try:
        stamped = []
        root = base.resolve()
        for path in base.rglob("*.jsonl"):
            try:
                if path.is_symlink() or not path.resolve().is_relative_to(root):
                    continue             # never follow links out of the harness store
                stamped.append((path.stat().st_mtime, path))
            except OSError:
                continue
    except OSError:
        return []
    stamped.sort(key=lambda pair: pair[0], reverse=True)
    out = []
    for _, path in stamped[:_NV_SCAN_LIMIT]:
        item = _nv_jsonl(path, family, account, now)
        if item is not None:
            out.append(item)
    return out


def _nv_link_roots(items: list[ExecutionEvidence]) -> None:
    by_id = {item.record.execution_id: item.record for item in items}
    for item in items:
        record = item.record
        if not record.parent_id:
            record.root_id = record.execution_id
            continue
        cursor, seen, root = record, {record.execution_id}, ""
        for _ in range(_NV_HOPS):
            parent = by_id.get(cursor.parent_id)
            if parent is None or parent.execution_id in seen:
                break
            seen.add(parent.execution_id)
            if not parent.parent_id:
                root = parent.execution_id
                break
            cursor = parent
        record.root_id = root


# --- metrics: cheap readers used by the collector, one connection per file/DB per snapshot -----------------

_NV_CODEX_CALLS = frozenset({"function_call", "custom_tool_call", "local_shell_call"})
_NV_ROLLOUT_NAME = re.compile(r"rollout-\d{4}-\d{2}-\d{2}T[\d-]+-(.+)\.jsonl$")
_NV_CODEX_STORES = (".codex/sessions", ".codex-testing/sessions")
_metric_codex_paths: dict[str, tuple[float, dict[str, str]]] = {}
_metric_codex: dict[str, dict] = {}
_metric_claude: dict[str, dict] = {}
_metric_opencode_db: dict[str, tuple[object, dict[str, dict], float]] = {}
_metric_opencode_tools: dict[str, dict[str, tuple[float, int, list[tuple[float, int]]]]] = {}
_metric_keep = 400     # cached files per reader
_metric_opencode_ttl_s = 60.0   # a WAL write can leave the main file's stamp alone: re-read at least this often


def _nv_stamp(path: Path) -> tuple[int, int] | None:
    """(mtime in ns, size) of a file; None when it does not exist."""
    try:
        stat = path.stat()
    except OSError:
        return None
    return (stat.st_mtime_ns, stat.st_size)


def _nv_metrics_put(harness: str, native_id: str, metrics: dict, path: object) -> None:
    if harness and native_id:
        _nv_metrics[(harness, native_id)] = metrics
        _nv_metric_paths[(harness, native_id)] = str(path)


def _nv_record_metrics(record: ExecutionRecord, st: dict) -> dict:
    window = st.get("ctx_window") if isinstance(st, dict) else None
    metrics = {"tokens_in": record.tokens_in, "tokens_out": record.tokens_out,
               "tokens_cache": record.tokens_cache, "cost": record.cost,
               "ctx_tokens": record.context_tokens,
               "ctx_window": window if isinstance(window, int) and not isinstance(window, bool) and window > 0 else None}
    metrics["tokens_total"] = _metric_tokens_total(metrics)
    return metrics


def native_metrics(harness: str, native_id: str) -> dict | None:
    """Metrics the last native scan parsed for one run; None when that run was not scanned."""
    if not harness or not native_id:
        return None
    return _nv_metrics.get((harness, native_id))


def _metric_tokens_total(metrics: dict) -> int | None:
    if metrics.get("tokens_in") is None and metrics.get("tokens_out") is None:
        return None
    return (metrics.get("tokens_in") or 0) + (metrics.get("tokens_out") or 0)


def _metric_result(state: dict, now: float) -> dict:
    """The public metrics dict of one incremental parse: tokens, ctx, tools and the pruned pulse ring."""
    pulses = [(stamp, count) for stamp, count in state["pulses"] if stamp >= now - TOOL_RING_S]
    state["pulses"] = pulses[-TOOL_RING_MAX:]
    metrics = dict(state["metrics"])
    metrics.setdefault("cost", None)
    metrics["tools"] = state["tools"]
    metrics["tool_pulses"] = list(state["pulses"])
    metrics["tokens_total"] = _metric_tokens_total(metrics)
    return metrics


def _metric_lines(state: dict, path: Path, apply) -> str:
    """Read the new bytes of ``path`` into ``state`` with ``apply(state, obj)``: "ok", "reset" or "gone"."""
    try:
        stat = path.stat()
    except OSError:
        return "gone"
    if state.get("size") is not None and (
            state.get("ino") != stat.st_ino or stat.st_size < state["offset"]
            or (stat.st_size == state["size"] and stat.st_mtime_ns != state["mtime"])):
        return "reset"
    try:
        with path.open("rb") as stream:
            stream.seek(state["offset"])
            for begin, raw, complete in _nv_lines(stream, MAX_ARTIFACT_BYTES):
                if raw is None or not raw.strip():
                    continue
                try:
                    obj = json.loads(raw)
                except (ValueError, UnicodeError, RecursionError):
                    if complete:
                        continue
                    stream.seek(begin)
                    break
                if not isinstance(obj, dict):
                    if not complete:
                        stream.seek(begin)
                        break
                    continue
                apply(state, obj)
            state["offset"] = stream.tell()
    except OSError:
        return "gone"
    state.update(ino=stat.st_ino, size=stat.st_size, mtime=stat.st_mtime_ns)
    return "ok"


def read_codex_sessions(home: str) -> dict[str, str]:
    """Thread id -> rollout path under codex's stores, newest file wins; rebuilt at most every RESCAN_S."""
    mono = time.monotonic()
    cached = _metric_codex_paths.get(home)
    if cached is not None and mono - cached[0] < RESCAN_S:
        return cached[1]
    found: dict[str, tuple[float, str]] = {}
    for store in _NV_CODEX_STORES:
        base = Path(home) / store
        try:
            if not base.is_dir():
                continue
            for root, _dirs, files in os.walk(base):   # os.walk does not follow symlinked dirs
                for name in files:
                    if not (name.startswith("rollout-") and name.endswith(".jsonl")):
                        continue
                    path = Path(root) / name
                    try:
                        if path.is_symlink():
                            continue
                        match = _NV_ROLLOUT_NAME.fullmatch(name)
                        if match is None:
                            continue
                        mtime = path.stat().st_mtime
                    except OSError:
                        continue
                    prior = found.get(match.group(1))
                    if prior is None or mtime > prior[0]:
                        found[match.group(1)] = (mtime, str(path))
        except OSError:
            continue
    paths = {key: value[1] for key, value in found.items()}
    _metric_codex_paths[home] = (mono, paths)
    return paths


def _metric_codex_item(state: dict, obj: dict) -> None:
    typ, payload = obj.get("type"), obj.get("payload")
    if not isinstance(payload, dict):
        return
    metrics = state["metrics"]
    stamp = _nv_time(obj.get("timestamp"))
    if typ == "token_usage_record":
        counts = _nv_codex_counts(payload.get("thread_token_usage") or payload.get("usage"))
        if counts is not None:
            metrics["tokens_in"], metrics["tokens_out"], metrics["tokens_cache"] = counts
        last = _nv_codex_counts(payload.get("usage"))
        if last is not None and last[0] > 0:
            metrics["ctx_tokens"] = last[0]
    elif typ == "event_msg":
        info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
        if payload.get("type") == "token_count":
            counts = _nv_codex_counts(info.get("total_token_usage"))
            if counts is not None:
                metrics["tokens_in"], metrics["tokens_out"], metrics["tokens_cache"] = counts
            last = _nv_codex_counts(info.get("last_token_usage"))
            if last is not None and last[0] > 0:
                metrics["ctx_tokens"] = last[0]
        window = _nv_codex_window(payload)
        if window is not None:
            metrics["ctx_window"] = window
    elif typ == "response_item" and payload.get("type") in _NV_CODEX_CALLS:
        state["tools"] += 1
        if stamp:
            state["pulses"].append((stamp, 1))
    if len(state["pulses"]) > TOOL_RING_MAX:
        state["pulses"] = state["pulses"][-TOOL_RING_MAX:]


def read_codex_metrics(path: str, now: float | None = None) -> dict | None:
    """Tokens, context window/used and tool pulses of one codex rollout, parsed incrementally."""
    if now is None:
        now = time.time()
    target = Path(path)
    state = _metric_codex.get(str(target))
    if state is None:
        state = {"offset": 0, "metrics": {}, "tools": 0, "pulses": []}
    ok = _metric_lines(state, target, _metric_codex_item)
    if ok == "reset":
        state = {"offset": 0, "metrics": {}, "tools": 0, "pulses": []}
        ok = _metric_lines(state, target, _metric_codex_item)
    if ok != "ok":
        return None
    _metric_codex[str(target)] = state
    while len(_metric_codex) > _metric_keep:
        _metric_codex.pop(next(iter(_metric_codex)))
    return _metric_result(state, now)


def _metric_claude_item(state: dict, obj: dict) -> None:
    typ = obj.get("type")
    metrics = state["metrics"]
    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
    usage = message.get("usage") if isinstance(message.get("usage"), dict) else None
    message_id = message.get("id")
    stamp = _nv_time(obj.get("timestamp"))
    if typ == "assistant" and usage is not None and isinstance(message_id, str) and message_id:
        row = ((_nv_int(usage.get("input_tokens")) or 0) + (_nv_int(usage.get("cache_creation_input_tokens")) or 0),
               _nv_int(usage.get("output_tokens")) or 0,
               _nv_int(usage.get("cache_read_input_tokens")) or 0)
        ids, totals = state.setdefault("ids", {}), state.setdefault("totals", [0, 0, 0])
        previous = ids.get(message_id)
        if previous is not None:
            for index in range(3):
                totals[index] -= previous[index]
        ids[message_id] = row
        for index, value in enumerate(row):
            totals[index] += value
        metrics["tokens_in"], metrics["tokens_out"], metrics["tokens_cache"] = totals
        context = row[0] + row[2]
        if context > 0:
            metrics["ctx_tokens"] = context
        content = message.get("content")
        for block in content if isinstance(content, list) else ():
            if isinstance(block, dict) and block.get("type") == "tool_use":
                tool_id = block.get("id")
                seen = state.setdefault("tool_ids", set())
                if isinstance(tool_id, str) and tool_id:
                    if tool_id in seen:
                        continue
                    seen.add(tool_id)
                state["tools"] += 1
                if stamp:
                    state["pulses"].append((stamp, 1))
    window = _nv_model_window(obj.get("modelUsage"))
    if window is not None:
        metrics["ctx_window"] = window
    if typ == "result" and isinstance(obj.get("usage"), dict):
        result = obj["usage"]
        metrics["tokens_in"] = ((_nv_int(result.get("input_tokens")) or 0)
                                + (_nv_int(result.get("cache_creation_input_tokens")) or 0))
        metrics["tokens_out"] = _nv_int(result.get("output_tokens")) or 0
        metrics["tokens_cache"] = _nv_int(result.get("cache_read_input_tokens")) or 0
        cost = obj.get("total_cost_usd")
        if type(cost) in (int, float) and not isinstance(cost, bool) and cost >= 0:
            metrics["cost"] = float(cost)   # collect keeps it only on a metered route (a subscription drops it)
    if len(state["pulses"]) > TOOL_RING_MAX:
        state["pulses"] = state["pulses"][-TOOL_RING_MAX:]


def read_claude_metrics(path: str, now: float | None = None) -> dict | None:
    """Tokens, context window/used and tool pulses of one Claude transcript, parsed incrementally."""
    if now is None:
        now = time.time()
    target = Path(path)
    state = _metric_claude.get(str(target))
    if state is None:
        state = {"offset": 0, "metrics": {}, "tools": 0, "pulses": []}
    ok = _metric_lines(state, target, _metric_claude_item)
    if ok == "reset":
        state = {"offset": 0, "metrics": {}, "tools": 0, "pulses": []}
        ok = _metric_lines(state, target, _metric_claude_item)
    if ok != "ok":
        return None
    _metric_claude[str(target)] = state
    while len(_metric_claude) > _metric_keep:
        _metric_claude.pop(next(iter(_metric_claude)))
    return _metric_result(state, now)


def read_opencode_sessions(home: str) -> dict[str, dict]:
    """Metrics of every open OpenCode session, keyed by session id; one connection.

    Cached while the database and its ``-wal`` keep their mtime and size, and for 60 s at most, so a
    write that only reaches the WAL still shows up in this snapshot.
    """
    path = Path(home) / ".local/share/opencode/opencode.db"
    stamp = (_nv_stamp(path), _nv_stamp(Path(str(path) + "-wal")))
    if stamp[0] is None:
        return {}
    key = str(path)
    now = time.monotonic()
    cached = _metric_opencode_db.get(key)
    if cached is not None and cached[0] == stamp and now - cached[2] < _metric_opencode_ttl_s:
        return cached[1]
    rows: dict[str, dict] = {}
    try:
        with sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1) as conn:
            columns = {row[1] for row in conn.execute("PRAGMA table_info(session_v2)")}
            model_column = "model" if "model" in columns else "NULL AS model"
            extra = [name for name in ("cost", "tokens_input", "tokens_output", "tokens_reasoning",
                                       "tokens_cache_read", "tokens_cache_write", "time_updated") if name in columns]
            query = ("SELECT id,parent_id,directory,title," + model_column + "".join(", " + name for name in extra)
                     + " FROM session_v2 WHERE time_archived IS NULL")
            for row in conn.execute(query):
                sid, parent, directory, title, model_data = row[:5]
                counts = dict(zip(extra, row[5:]))
                try:
                    model_data = json.loads(model_data) if isinstance(model_data, str) else {}
                except ValueError:
                    model_data = {}
                model_id = model_data.get("id") if isinstance(model_data, dict) else None
                reported_window = None
                if isinstance(model_data, dict):
                    reported_window = model_data.get("contextWindow", model_data.get("context_window"))
                ctx_tokens = None
                try:
                    cursor = conn.execute(
                        "SELECT json_extract(data,'$.tokens.input') FROM session_message "
                        "WHERE session_id=? AND type='assistant' ORDER BY seq DESC LIMIT 1", (sid,)
                    )
                    try:
                        latest = cursor.fetchone()
                    finally:
                        cursor.close()
                    ctx_tokens = _nv_int(latest[0]) if latest else None
                except sqlite3.Error:
                    pass
                metrics = {
                    "parent_id": parent or "", "directory": directory or "", "title": title or "",
                    "tokens_in": _nv_int(counts.get("tokens_input")),
                    "tokens_out": _nv_sum(_nv_int(counts.get("tokens_output")),
                                          _nv_int(counts.get("tokens_reasoning"))),
                    "tokens_cache": _nv_sum(_nv_int(counts.get("tokens_cache_read")),
                                            _nv_int(counts.get("tokens_cache_write"))),
                    "cost": (float(counts["cost"]) if type(counts.get("cost")) in (int, float)
                             and counts["cost"] >= 0 else None),
                    "ctx_tokens": ctx_tokens,
                    "ctx_window": _nv_opencode_window(model_id, reported_window), "tools": None,
                    "updated": _nv_time(counts.get("time_updated")),
                }
                metrics["tokens_total"] = _metric_tokens_total(metrics)
                rows[str(sid)] = metrics
    except (OSError, sqlite3.Error):
        return cached[1] if cached is not None else {}
    _metric_opencode_db[key] = (stamp, rows, now)
    return rows


def read_opencode_lead_tools(home: str, sessions: dict[str, dict], now: float) -> dict[str, tuple[int, list[tuple[float, int]]]]:
    """Tool calls and event-time pulses per session, from the DB's assistant messages; only moved sessions are read."""
    path = Path(home) / ".local/share/opencode/opencode.db"
    store = _metric_opencode_tools.setdefault(str(path), {})
    out = {sid: (store[sid][1], [pulse for pulse in store[sid][2] if pulse[0] >= now - TOOL_RING_S])
           for sid in sessions if sid in store}
    stale = [sid for sid, row in sessions.items() if store.get(sid, (None,))[0] != row.get("updated")]
    if not stale:
        return out
    try:
        with sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1) as conn:
            for sid in stale:
                tools, pulses = 0, []
                for created, raw in conn.execute(
                        "SELECT time_created,data FROM session_message WHERE session_id=? AND type='assistant'", (sid,)):
                    try:
                        data = json.loads(raw)
                    except (ValueError, TypeError, RecursionError):
                        continue
                    count = sum(1 for part in (data.get("content") if isinstance(data, dict) else None) or ()
                                if isinstance(part, dict) and part.get("type") == "tool")
                    if count:
                        tools += count
                        stamp = _nv_time(created)
                        if stamp:
                            pulses.append((stamp, count))
                store[sid] = (sessions[sid].get("updated"), tools, pulses[-TOOL_RING_MAX:])
                out[sid] = (tools, [pulse for pulse in store[sid][2] if pulse[0] >= now - TOOL_RING_S])
    except (OSError, sqlite3.Error):
        return out
    return out


def _nv_evict() -> None:
    """Drop cached transcript state for paths that have been deleted."""
    for key in [key for key in _nv_cache if not os.path.lexists(key)]:
        del _nv_cache[key]
    for key in [key for key in _nv_cursor_cache if not os.path.lexists(key)]:
        del _nv_cursor_cache[key]
    for key in [key for key in _nv_metric_paths if not os.path.lexists(_nv_metric_paths[key])]:
        _nv_metrics.pop(key, None)
        del _nv_metric_paths[key]
    for key in [key for key in _metric_codex if not os.path.lexists(key)]:
        del _metric_codex[key]
    for key in [key for key in _metric_claude if not os.path.lexists(key)]:
        del _metric_claude[key]
    for key in [key for key in _metric_opencode_db if not os.path.lexists(key)]:
        del _metric_opencode_db[key]
        _metric_opencode_tools.pop(key, None)


def read_native_executions(harness: str, home: str, now: float) -> list[ExecutionEvidence]:
    _nv_evict()
    if harness == "opencode":
        items = _nv_opencode(home)
    elif harness == "openclaw":
        items = _nv_openclaw(home)
    elif harness in ("codex", "t3"):
        items = (_nv_scan(Path(home) / ".codex/sessions", "personal", "codex", now)
                 + _nv_scan(Path(home) / ".codex-testing/sessions", "personal", "codex", now))
    elif harness == "claude":
        config_dirs = [name for name in os.environ.get("STATION_CLAUDE_CONFIG_DIRS", ".claude").split(":") if name]
        items = []
        for name in config_dirs:
            account = "work" if "work" in name.lower() else "personal"
            items.extend(_nv_scan(Path(home) / name / "projects", account, "claude", now))
    elif harness == "cursor":
        items = _nv_cursor(home, now)
    else:
        return []
    items = [item for item in items if item.record.harness == harness]
    _nv_link_roots(items)
    return items



# ──────────────────── logparse ────────────────────
"""Incremental parser for a single worker's log file.

Turns one worker's log into a :class:`LogState`, reading only the bytes added
since the previous call. Four shapes are handled: opencode ``--format json``
logs (one JSON object per line), claude ``-p --output-format stream-json`` and
cursor-agent ``-p --output-format stream-json`` logs (the same shape), codex
``exec``/``review`` text logs, and any other plain-text log.
"""



STEP_OK, STEP_FAILED = "ok", "failed"   # Step.outcome values; "" means the log does not say

_LP_ANSI_RE = re.compile(
    r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-Z\\-_])"
)
_LP_MODEL_RE = re.compile(r'"(?:modelID|model)"\s*:\s*"([^"]*)"')
_LP_ERR_RE = re.compile(r"^(?:Error|error:|ERROR)")
_LP_CODEX_RESULT_RE = re.compile(r"^ ?(?:succeeded|exited (-?\d+)) in ([^:]+):\s*$")
_LP_CODEX_DUR_RE = re.compile(r"^(\d+(?:\.\d+)?)(ms|s)$")   # codex writes "0ms", "812ms" or "1.2s"
_LP_CODEX_CWD_RE = re.compile(r" in /\S*$")
_LP_CODEX_STREAM_RE = re.compile(r"^(?:stream (?:error|disconnected)|unexpected status \d{3})", re.IGNORECASE)
_LP_OPENCODE_TYPES = frozenset({"tool_use", "text", "step_finish", "step_start", "error"})
_LP_DETECT_LINES = 40
_LP_MAX_CARRY = 65536                   # an unterminated plain-text line longer than this is parsed as it stands
_LP_MAX_JSON_CARRY = 8 * 1024 * 1024    # an unterminated JSON record is kept up to this, then skipped whole
_LP_CODEX_MARKERS = frozenset({"exec", "tokens used"})
_LP_STREAM_TOOL_KEYS = ("command", "file_path", "notebook_path", "filePath", "path", "pattern", "query", "url")
_LP_ROLLOUT_TYPES = frozenset({"session_meta", "response_item", "event_msg", "turn_context", "world_state"})
_LP_CODEX_CALLS = frozenset({"function_call", "custom_tool_call", "local_shell_call"})
_LP_CODEX_OUTPUTS = frozenset({"function_call_output", "custom_tool_call_output", "local_shell_call_output"})
_LP_ROLLOUT_HEAD_RE = re.compile(
    r'^\{"timestamp"\s*:\s*"[^"]+"\s*,\s*"ordinal"\s*:\s*\d+\s*,\s*"type"\s*:\s*'
    r'"(?:session_meta|response_item|event_msg|turn_context|world_state)"'
)
_LP_CLAUDE_FRESH = ("input_tokens", "cache_creation_input_tokens")
_LP_CURSOR_FRESH = ("inputTokens", "cacheWriteTokens")

_LP_READ = frozenset({"read", "view", "cat", "list", "ls"})
_LP_EDIT = frozenset({"edit", "write", "patch", "apply_patch", "multiedit", "notebookedit"})
_LP_SHELL = frozenset({"bash", "shell", "exec", "command"})
_LP_SEARCH = frozenset({"grep", "glob", "search", "find", "websearch", "webfetch"})


def tool_category(tool: str) -> str:
    """Map a raw tool name to one of ``TOOL_CATS`` (case-insensitive)."""
    name = (tool or "").strip().lower()
    if name in _LP_READ:
        return "read"
    if name in _LP_EDIT:
        return "edit"
    if name in _LP_SHELL:
        return "shell"
    if name in _LP_SEARCH:
        return "search"
    return "other"


def activity(state: LogState, now: float) -> list[int]:
    """Return ``ACT_BUCKETS`` event totals, oldest bucket first."""
    out = [0] * ACT_BUCKETS
    for ts, count in state.pulses:
        delta = now - ts
        delta = max(delta, 0.0)
        index = ACT_BUCKETS - math.ceil(delta / ACT_BUCKET_S)
        if index < 0:
            continue
        if index >= ACT_BUCKETS:
            index = ACT_BUCKETS - 1
        out[index] += count
    return out


def tool_rate(state: LogState, now: float, cells: int = 15, span: float = TOOL_RING_S) -> list[int]:
    """Tool calls per cell over the last ``span`` seconds, oldest cell first."""
    out = [0] * max(cells, 0)
    if cells <= 0 or span <= 0:
        return out
    width = span / cells
    for ts, count in state.tool_pulses:
        age = max(now - ts, 0.0)
        index = cells - 1 - int(age / width)
        if 0 <= index < cells:
            out[index] += count
    return out


def parse_log(path: str, prev: LogState | None = None, now: float | None = None,
              detect_head: bytes | None = None) -> LogState:
    """Parse ``path`` into a :class:`LogState`, appending to ``prev`` if given."""
    if now is None:
        now = time.time()
    try:
        info = os.stat(path)
    except OSError:
        return prev if prev is not None else LogState(path=path)
    size = info.st_size
    if prev is None or size < prev.offset:
        state = LogState(path=path)
        start = 0
    else:
        state = prev
        start = prev.offset
    try:
        with open(path, "rb") as handle:
            if start:
                handle.seek(start)
            data = handle.read()
    except OSError:
        return prev if prev is not None else LogState(path=path)

    state.offset = start + len(data)
    text = _lp_clean(state.carry + data.decode("utf-8", "replace"))
    private = _lp_private(state)
    if private.pop("skip_record", False):
        # the rest of an oversized record: drop it up to its terminating newline
        cut = text.find("\n")
        if cut < 0:
            private["skip_record"] = True
            text = ""
        else:
            text = text[cut + 1:]
    if text.endswith("\n"):
        state.carry = ""
        body = text[:-1]
    else:
        cut = text.rfind("\n")
        if cut == -1:
            state.carry = text
            body = ""
        else:
            state.carry = text[cut + 1:]
            body = text[:cut]
    lines = body.split("\n") if body else []

    if state.carry:
        carry_bytes = len(state.carry.encode("utf-8", "replace"))
        if state.carry.lstrip().startswith("{"):
            if carry_bytes > _LP_MAX_JSON_CARRY:
                # too big for a record: skip its tail and count the truncation instead of losing the next records
                private["truncated"] = private.get("truncated", 0) + 1
                private["skip_record"] = True
                state.carry = ""
        elif carry_bytes > _LP_MAX_CARRY:
            lines.append(state.carry)
            state.carry = ""

    if state.harness == "unknown":
        try:
            if detect_head is None:
                with open(path, "rb") as handle:
                    detect_head = handle.read(16 * 1024)
            head = detect_head.decode("utf-8", "replace")
            _lp_detect(state, _lp_clean(head).splitlines()[:_LP_DETECT_LINES])
        except OSError:
            _lp_detect(state, lines)
    if state.harness == "codex":
        lines = _lp_codex_holdback(state, lines)

    new_ts: list[float] = []
    plain_ts = info.st_mtime if prev is None else now
    timed = state.harness == "opencode"
    if state.harness == "opencode":
        _lp_process_opencode(state, lines, new_ts, now)
    elif state.harness == "codex":
        _lp_process_codex(state, lines, new_ts, plain_ts, start == 0)
    elif state.harness == "claude":
        _lp_process_claude(state, lines, new_ts, plain_ts)
    elif state.harness == "cursor":
        _lp_process_cursor(state, lines, new_ts, plain_ts)
    else:
        _lp_process_plain(state, lines, new_ts, plain_ts)

    if len(state.steps) > MAX_STEPS:
        del state.steps[: len(state.steps) - MAX_STEPS]
    _lp_add_pulses(state, new_ts, plain_ts, timed, now)
    keep = now - ACT_BUCKETS * ACT_BUCKET_S
    state.pulses = [pulse for pulse in state.pulses if pulse[0] >= keep]
    prune_tool_ring(state, now)
    return state


def _lp_clean(text: str) -> str:
    if not text:
        return ""
    return _LP_ANSI_RE.sub("", text).replace("\r", "")


def _lp_try_json(line: str) -> dict | None:
    if not line or line[0] != "{":
        return None
    try:
        obj = json.loads(line)
    except (ValueError, TypeError):
        return None
    return obj if isinstance(obj, dict) else None


def _lp_num(value: object, default: float = 0) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return default
    return value


def _lp_add(cur: float | None, value: float) -> float:
    return (cur or 0) + value


def _lp_ms_to_s(value: object) -> float | None:
    """Milliseconds since the epoch to seconds; ``None`` if not numeric.

    A numeric but absurd value (non-finite, negative or too big for a float)
    is reported as ``0.0`` so callers never trip over it later.
    """
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        seconds = float(value) / 1000.0
    except (OverflowError, ValueError):
        return 0.0
    if not math.isfinite(seconds) or seconds < 0:
        return 0.0
    return seconds


def _lp_event_ts(obj: dict) -> float | None:
    """A stream or rollout event's own ISO-8601 ``timestamp`` in epoch seconds; None when absent or unreadable."""
    value = obj.get("timestamp")
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value).timestamp()
    except ValueError:
        return None


def _lp_find_model(state: LogState, line: str) -> None:
    if state.model:
        return
    match = _LP_MODEL_RE.search(line)
    if match and match.group(1):
        state.model = match.group(1)


def _lp_add_step(
    state: LogState,
    new_ts: list[float],
    ts: float,
    kind: str,
    tool: str,
    text: str,
    dur: float | None = None,
    outcome: str = "",
) -> Step:
    step = _lp_push_step(state, ts, kind, tool, text, dur, outcome)
    new_ts.append(ts)
    return step


def _lp_push_step(
    state: LogState,
    ts: float,
    kind: str,
    tool: str,
    text: str,
    dur: float | None = None,
    outcome: str = "",
) -> Step:
    """Append one step; an error step is a failure whatever else the log says about it."""
    if not outcome and kind == "error":
        outcome = STEP_FAILED
    step = Step(ts=ts, kind=kind, tool=tool, text=" ".join(_lp_clean(text).split()),
                dur=dur, outcome=outcome)
    state.steps.append(step)
    state.steps_total += 1
    if ts > 0:
        if state.first_ts == 0.0 or ts < state.first_ts:
            state.first_ts = ts
        state.last_ts = max(state.last_ts, ts)
    if kind == "tool":
        _lp_tool_pulse(state, ts)
    return step


def _lp_tool_pulse(state: LogState, ts: float) -> None:
    """Count one tool call in the 30-minute ring at its event second; untimed calls are not plotted."""
    if ts <= 0:
        return
    second = float(int(ts))
    ring = state.tool_pulses
    if ring and ring[-1][0] == second:
        ring[-1] = (second, ring[-1][1] + 1)
    elif not ring or ring[-1][0] < second:
        ring.append((second, 1))
    else:   # an event older than the newest one: merge it in place
        for index in range(len(ring) - 1, -1, -1):
            if ring[index][0] == second:
                ring[index] = (second, ring[index][1] + 1)
                break
            if ring[index][0] < second:
                ring.insert(index + 1, (second, 1))
                break
        else:
            ring.insert(0, (second, 1))
    if len(ring) > TOOL_RING_MAX:
        del ring[: len(ring) - TOOL_RING_MAX]


def prune_tool_ring(state: LogState, now: float) -> None:
    """Drop ring entries older than ``TOOL_RING_S`` before ``now``.

    Pruning here, on every parse, is what keeps the ring's 30-minute promise when a log stops
    gaining tool calls: the newest event is not the clock.
    """
    ring = state.tool_pulses
    if not ring:
        return
    cutoff = now - TOOL_RING_S
    drop = 0
    while drop < len(ring) and ring[drop][0] < cutoff:
        drop += 1
    if drop:
        del ring[:drop]
    if len(ring) > TOOL_RING_MAX:
        del ring[: len(ring) - TOOL_RING_MAX]


def _lp_stream_harness(obj: dict | None) -> str:
    """``claude`` or ``cursor`` when ``obj`` is that CLI's stream-json start event, else ``""``."""
    if obj is None or obj.get("type") != "system":
        return ""
    if "claude_code_version" in obj:
        return "claude"
    subtype = obj.get("subtype")
    if isinstance(subtype, str) and subtype.startswith("hook_") and "session_id" in obj:
        return "claude"
    if subtype == "init" and "apiKeySource" in obj:
        return "cursor"
    return ""


def _lp_rollout_item(obj: dict | None) -> bool:
    """True for one line of a codex ``rollout-*.jsonl`` session (an item with a payload and a timestamp)."""
    return (
        isinstance(obj, dict)
        and obj.get("type") in _LP_ROLLOUT_TYPES
        and isinstance(obj.get("payload"), dict)
    )


def _lp_detect(state: LogState, lines: list[str]) -> None:
    seen = 0
    stream = ""
    for raw in lines:
        line = raw.strip()
        if not line:
            continue
        if line.startswith("Reading additional input from stdin"):
            continue
        if line.startswith("OpenAI Codex"):
            state.harness = "codex"
            return
        obj = _lp_try_json(line)
        if isinstance(obj, dict) and obj.get("type") in _LP_OPENCODE_TYPES:
            state.harness = "opencode"
            return
        if _lp_rollout_item(obj) or _LP_ROLLOUT_HEAD_RE.match(line):
            state.harness = "codex"
            return
        if not stream:
            stream = _lp_stream_harness(obj)
        seen += 1
        if seen >= _LP_DETECT_LINES:
            break
    if stream:
        state.harness = stream


def _lp_process_plain(
    state: LogState, lines: list[str], new_ts: list[float], plain_ts: float
) -> None:
    for raw in lines:
        line = raw.strip()
        if not line:
            continue
        if _LP_ERR_RE.match(line):
            _lp_add_step(state, new_ts, plain_ts, "error", "", line)
            state.errors += 1
        else:
            _lp_add_step(state, new_ts, plain_ts, "text", "", line)


def _lp_codex_holdback(state: LogState, lines: list[str]) -> list[str]:
    """Return ``lines`` without a trailing codex marker line, which ``state.carry`` keeps.

    A parse call can end right after ``exec`` or ``tokens used``; the line that
    gives that marker meaning may only arrive next call. Holding the marker back
    keeps the pending state across reads.
    """
    if not lines or lines[-1].strip() not in _LP_CODEX_MARKERS:
        return lines
    state.carry = lines[-1] + "\n" + state.carry
    return lines[:-1]


def _lp_process_opencode(
    state: LogState, lines: list[str], new_ts: list[float], now: float
) -> None:
    for raw in lines:
        line = raw.strip()
        if not line:
            continue
        obj = _lp_try_json(line)
        if obj is None:
            continue
        if not state.model:
            _lp_find_model(state, line)
        ts = _lp_ms_to_s(obj.get("timestamp"))
        if ts is None:
            ts = 0.0 if "timestamp" in obj else now
        kind = obj.get("type")
        if kind == "tool_use":
            _lp_oc_tool(state, obj, ts, new_ts)
        elif kind == "text":
            part = obj.get("part")
            value = part.get("text") if isinstance(part, dict) else None
            if isinstance(value, str) and value.strip():
                _lp_add_step(state, new_ts, ts, "text", "", value)
        elif kind == "step_finish":
            _lp_oc_finish(state, obj)
        elif kind == "error":
            err = obj.get("error")
            msg = err.get("message") if isinstance(err, dict) else None
            text = msg if isinstance(msg, str) and msg else "error"
            _lp_add_step(state, new_ts, ts, "error", "", text)
            state.errors += 1


def _lp_oc_tool(state: LogState, obj: dict, ts: float, new_ts: list[float]) -> None:
    part = obj.get("part")
    if not isinstance(part, dict):
        return
    raw_tool = part.get("tool")
    tool = str(raw_tool) if raw_tool else ""
    stt = part.get("state")
    stt = stt if isinstance(stt, dict) else {}
    inp = stt.get("input")
    inp = inp if isinstance(inp, dict) else {}
    text = ""
    for key in ("command", "filePath", "path"):
        value = inp.get(key)
        if isinstance(value, str) and value:
            text = value
            break
    if not text:
        title = stt.get("title")
        if isinstance(title, str):
            text = title
    cat = tool_category(tool)
    state.tool_counts[cat] = state.tool_counts.get(cat, 0) + 1
    dur, outcome = _lp_oc_state(stt)
    _lp_add_step(state, new_ts, ts, "tool", tool.lower(), text, dur, outcome)


_LP_OC_OUTCOME = {"completed": STEP_OK, "error": STEP_FAILED}


def _lp_oc_state(stt: dict) -> tuple[float | None, str]:
    """An opencode tool part's own duration and outcome, from the timestamps and status it already carries.

    A part still running has no end time and no outcome; then both stay empty rather than being guessed.
    A part whose start and end are the same keeps 0.0, not None.
    """
    outcome = _LP_OC_OUTCOME.get(str(stt.get("status") or ""), "")
    timing = stt.get("time")
    if not isinstance(timing, dict):
        return None, outcome
    start = _lp_ms_to_s(timing.get("start"))
    end = _lp_ms_to_s(timing.get("end"))
    if start is None or end is None or end < start:
        return None, outcome
    return end - start, outcome


def _lp_oc_finish(state: LogState, obj: dict) -> None:
    part = obj.get("part")
    if not isinstance(part, dict):
        return
    cost = part.get("cost")
    if isinstance(cost, (int, float)) and not isinstance(cost, bool):
        state.cost = (state.cost or 0.0) + float(cost)
    toks = part.get("tokens")
    if not isinstance(toks, dict):
        return
    cache = toks.get("cache")
    cache_read = cache.get("read") if isinstance(cache, dict) else 0
    tokens_in = _lp_num(toks.get("input"))
    tokens_out = _lp_num(toks.get("output")) + _lp_num(toks.get("reasoning"))
    tokens_cache = _lp_num(cache_read)
    state.tokens_in = _lp_add(state.tokens_in, tokens_in)
    state.tokens_out = _lp_add(state.tokens_out, tokens_out)
    state.tokens_cache = _lp_add(state.tokens_cache, tokens_cache)
    state.ctx_tokens = int(_lp_num(toks.get("input")) + _lp_num(cache_read))


def _lp_private(state: LogState) -> dict:
    """Parser-only memory that ``LogState`` has no field for; kept on the state object between reads."""
    return vars(state).setdefault("_lp_private", {})


def _lp_set_model(state: LogState, value: object) -> None:
    if not state.model and isinstance(value, str) and value and value != "<synthetic>":   # placeholder for error messages: no model
        state.model = value


def _lp_usage_row(usage: dict, fresh: tuple[str, ...], out_key: str, cache_key: str) -> tuple[int, int, int]:
    """(tokens in, tokens out, tokens cache) of one usage object; every ``fresh`` key counts as input."""
    tokens_in = sum(int(_lp_num(usage.get(key))) for key in fresh)
    return tokens_in, int(_lp_num(usage.get(out_key))), int(_lp_num(usage.get(cache_key)))


def _lp_result_text(content: object) -> str:
    """Text of a tool result: a string, or the text parts of a list of blocks."""
    if isinstance(content, list):
        parts = [part.get("text") for part in content if isinstance(part, dict)]
        value = " ".join(part for part in parts if isinstance(part, str))
    else:
        value = content if isinstance(content, str) else ""
    return " ".join(value.split())[:_LP_STEP_TEXT_MAX] or "error"


def _lp_stream_content(state: LogState, obj: dict, new_ts: list[float], plain_ts: float) -> None:
    """Steps from one claude or cursor ``assistant`` or ``user`` event.

    Tool calls and text come from assistant events only (a user prompt is not a step);
    a tool result flagged ``is_error`` is an error step. A result also gives the tool step it
    answers its outcome, and its duration from ``tool_use_result.durationMs`` or the event times.
    """
    message = obj.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if not isinstance(content, list):
        return
    assistant = obj.get("type") == "assistant"
    event_ts = _lp_event_ts(obj)
    ts = plain_ts if event_ts is None else event_ts
    for block in content:
        if not isinstance(block, dict):
            continue
        kind = block.get("type")
        if assistant and kind == "tool_use":
            step = _lp_stream_tool(state, block, new_ts, ts)
            call_id = block.get("id")
            if isinstance(call_id, str) and call_id:
                _lp_stream_pending(state)[call_id] = (step, event_ts)
        elif assistant and kind == "text":
            value = block.get("text")
            if isinstance(value, str) and value.strip():
                _lp_add_step(state, new_ts, ts, "text", "", value[:_LP_STEP_TEXT_MAX])
        elif kind == "tool_result":
            _lp_stream_result(state, obj, block, new_ts, ts, event_ts)


_LP_PENDING_MAX = 256   # tool calls kept while waiting for their result; a long run must not grow this for ever


def _lp_stream_pending(state: LogState) -> dict[str, tuple[Step, float | None]]:
    """Tool steps waiting for the result that closes them: call id -> (step, event time)."""
    pending = _lp_private(state).setdefault("stream", {}).setdefault("tools", {})
    while len(pending) > _LP_PENDING_MAX:
        pending.pop(next(iter(pending)))
    return pending


def _lp_stream_result(
    state: LogState,
    obj: dict,
    block: dict,
    new_ts: list[float],
    ts: float,
    event_ts: float | None,
) -> None:
    """Close the tool step a result answers, and keep the error step an error result already made."""
    call_id = block.get("tool_use_id")
    failed = block.get("is_error") is True
    if isinstance(call_id, str) and call_id:
        entry = _lp_stream_pending(state).pop(call_id, None)
        if entry is not None:
            step, use_ts = entry
            step.outcome = STEP_FAILED if failed else STEP_OK
            dur = _lp_result_dur(obj)
            if dur is None and use_ts is not None and event_ts is not None and event_ts >= use_ts:
                dur = event_ts - use_ts
            if dur is not None:
                step.dur = dur
    if failed:
        _lp_add_step(state, new_ts, ts, "error", "", _lp_result_text(block.get("content")))
        state.errors += 1


def _lp_result_dur(obj: dict) -> float | None:
    """A claude ``user`` event's own ``tool_use_result.durationMs`` in seconds; 0.0 is a real 0 ms."""
    result = obj.get("tool_use_result")
    if not isinstance(result, dict):
        return None
    value = result.get("durationMs")
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:
        return None
    return float(value) / 1000.0


def _lp_stream_tool(state: LogState, block: dict, new_ts: list[float], ts: float) -> Step:
    raw_tool = block.get("name")
    tool = raw_tool if isinstance(raw_tool, str) else ""
    inp = block.get("input")
    inp = inp if isinstance(inp, dict) else {}
    text = ""
    for key in _LP_STREAM_TOOL_KEYS:
        value = inp.get(key)
        if isinstance(value, str) and value:
            text = value
            break
    cat = tool_category(tool)
    state.tool_counts[cat] = state.tool_counts.get(cat, 0) + 1
    return _lp_add_step(state, new_ts, ts, "tool", tool.lower(), text[:_LP_STEP_TEXT_MAX])


def _lp_claude_store(state: LogState) -> dict:
    return _lp_private(state).setdefault("claude", {"ids": {}, "final": None, "totals": [0, 0, 0]})


def _lp_claude_totals(state: LogState) -> None:
    """Token totals of a claude stream: the final ``result`` usage once seen, else the sum over messages."""
    store = _lp_claude_store(state)
    if store["final"] is not None:
        rows = (store["final"],)
        state.tokens_in, state.tokens_out, state.tokens_cache = (sum(row[i] for row in rows) for i in range(3))
        return
    totals = store.setdefault("totals", [0, 0, 0])
    state.tokens_in, state.tokens_out, state.tokens_cache = totals


def _lp_claude_usage(state: LogState, obj: dict) -> None:
    """Keep one message's usage under its id: events that share an id count once, the last one wins."""
    message = obj.get("message")
    if not isinstance(message, dict):
        return
    msg_id = message.get("id")
    usage = message.get("usage")
    if isinstance(msg_id, str) and msg_id and isinstance(usage, dict):
        row = _lp_usage_row(usage, _LP_CLAUDE_FRESH, "output_tokens", "cache_read_input_tokens")
        store = _lp_claude_store(state)
        previous = store["ids"].get(msg_id)
        if previous is not None:
            for i in range(3):
                store["totals"][i] -= previous[i]
        store["ids"][msg_id] = row
        totals = store.setdefault("totals", [0, 0, 0])
        for i in range(3):
            totals[i] += row[i]
        window = row[0] + int(_lp_num(usage.get("cache_read_input_tokens")))
        if window > 0:      # zero usage = synthetic message, keep the last real window
            state.ctx_tokens = window
        _lp_claude_totals(state)


def _lp_claude_result(state: LogState, obj: dict) -> None:
    """The closing ``result`` event: the run's cost, final usage and the model's context window."""
    cost = obj.get("total_cost_usd")
    if isinstance(cost, (int, float)) and not isinstance(cost, bool):
        state.cost = float(cost)
    usage = obj.get("usage")
    if isinstance(usage, dict):
        row = _lp_usage_row(usage, _LP_CLAUDE_FRESH, "output_tokens", "cache_read_input_tokens")
        _lp_claude_store(state)["final"] = row
        _lp_claude_totals(state)
    window = _lp_model_window(obj.get("modelUsage"))
    if window is not None:
        state.ctx_window = window


def _lp_model_window(model_usage: object) -> int | None:
    """The largest ``contextWindow`` in a claude ``result.modelUsage`` block; None when it has none."""
    if not isinstance(model_usage, dict):
        return None
    windows = [
        row.get("contextWindow") for row in model_usage.values() if isinstance(row, dict)
    ]
    windows = [w for w in windows if isinstance(w, int) and not isinstance(w, bool) and w > 0]
    return max(windows) if windows else None


def _lp_process_claude(
    state: LogState, lines: list[str], new_ts: list[float], plain_ts: float
) -> None:
    """Claude Code ``-p --output-format stream-json`` events, one JSON object per line."""
    for raw in lines:
        obj = _lp_try_json(raw.strip())
        if obj is None:
            continue
        kind = obj.get("type")
        if kind == "system":
            if obj.get("subtype") == "init":
                _lp_set_model(state, obj.get("model"))
        elif kind == "assistant":
            _lp_stream_content(state, obj, new_ts, plain_ts)
            _lp_claude_usage(state, obj)
        elif kind == "user":
            _lp_stream_content(state, obj, new_ts, plain_ts)
        elif kind == "result":
            _lp_claude_result(state, obj)


def _lp_process_cursor(
    state: LogState, lines: list[str], new_ts: list[float], plain_ts: float
) -> None:
    """cursor-agent ``-p --output-format stream-json`` events; its ``result`` has usage but no cost."""
    for raw in lines:
        obj = _lp_try_json(raw.strip())
        if obj is None:
            continue
        kind = obj.get("type")
        if kind == "system":
            if obj.get("subtype") == "init":
                _lp_set_model(state, obj.get("model"))
        elif kind in ("assistant", "user"):
            _lp_stream_content(state, obj, new_ts, plain_ts)
        elif kind == "result":
            usage = obj.get("usage")
            if isinstance(usage, dict):
                row = _lp_usage_row(usage, _LP_CURSOR_FRESH, "outputTokens", "cacheReadTokens")
                state.tokens_in, state.tokens_out, state.tokens_cache = row


def _lp_codex_json(lines: list[str]) -> bool:
    """True when these lines are codex ``rollout-*.jsonl`` items rather than the exec text log."""
    for raw in lines:
        line = raw.strip()
        if line:
            return _lp_rollout_item(_lp_try_json(line))
    return False


def _lp_process_codex_json(
    state: LogState, lines: list[str], new_ts: list[float], plain_ts: float
) -> None:
    """One codex rollout session: each item carries its own ISO ``timestamp``."""
    for raw in lines:
        obj = _lp_try_json(raw.strip())
        if obj is None:
            continue
        payload = obj.get("payload")
        if not isinstance(payload, dict):
            continue
        ts = _lp_event_ts(obj)
        if ts is None:
            ts = plain_ts
        kind = obj.get("type")
        if kind == "event_msg":
            window = _lp_codex_window(payload)
            if window is not None:
                state.ctx_window = window
        elif kind == "turn_context":
            _lp_set_model(state, payload.get("model"))
        elif kind == "response_item":
            _lp_codex_item(state, payload, ts, new_ts)


def _lp_codex_window(payload: dict) -> int | None:
    """A codex ``event_msg``'s ``model_context_window``, at the payload root or under ``info``."""
    for row in (payload, payload.get("info")):
        if not isinstance(row, dict):
            continue
        value = row.get("model_context_window")
        if isinstance(value, int) and not isinstance(value, bool) and value > 0:
            return value
    return None


def _lp_codex_item(state: LogState, payload: dict, ts: float, new_ts: list[float]) -> None:
    """One rollout ``response_item``: a tool call, the output that closes it, or assistant text."""
    ptype = payload.get("type")
    if ptype in _LP_CODEX_CALLS:
        raw_tool = payload.get("name")
        tool = raw_tool if isinstance(raw_tool, str) and raw_tool else "shell"
        text = payload.get("input")
        if not isinstance(text, str):
            text = payload.get("arguments")
        text = text if isinstance(text, str) else ""
        cat = tool_category(tool)
        state.tool_counts[cat] = state.tool_counts.get(cat, 0) + 1
        step = _lp_add_step(state, new_ts, ts, "tool", tool.lower(), text[:_LP_STEP_TEXT_MAX])
        call_id = payload.get("call_id")
        if isinstance(call_id, str) and call_id:
            _lp_stream_pending(state)[call_id] = (step, ts)
    elif ptype in _LP_CODEX_OUTPUTS:
        call_id = payload.get("call_id")
        if isinstance(call_id, str) and call_id:
            entry = _lp_stream_pending(state).pop(call_id, None)
            if entry is not None:
                step, call_ts = entry
                if ts >= call_ts:
                    step.dur = ts - call_ts
    elif ptype == "message" and payload.get("role") == "assistant":
        text = _lp_content_text(payload.get("content"))
        if text.strip():
            _lp_add_step(state, new_ts, ts, "text", "", text)


def _lp_content_text(content: object) -> str:
    """The text of a message body: a string, or the text of a list of content blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [block.get("text") for block in content if isinstance(block, dict)]
        return " ".join(part for part in parts if isinstance(part, str))
    return ""


def _lp_process_codex(
    state: LogState,
    lines: list[str],
    new_ts: list[float],
    plain_ts: float,
    first: bool,
) -> None:
    """Turn codex log lines into steps; see ``_lp_codex_marker`` for the block layout.

    ``state.codex_mode`` carries the block across reads, so a read that stops in
    the middle of a command's output resumes there, not as text. A ``rollout-*.jsonl``
    session is JSON items instead, and goes to ``_lp_process_codex_json``.
    """
    if _lp_codex_json(lines):
        _lp_process_codex_json(state, lines, new_ts, plain_ts)
        return
    in_header = first
    delims = 0
    model_id = ""
    effort = ""
    for raw in lines:
        line = raw.strip()
        if in_header:
            if line == "--------":
                delims += 1
                if delims >= 2:
                    in_header = False
                    if model_id:
                        state.model = model_id + (f" ({effort})" if effort else "")
                continue
            if line.startswith("model:"):
                model_id = line.split(":", 1)[1].strip()
                if model_id and effort:
                    state.model = f"{model_id} ({effort})"
                continue
            if line.startswith("reasoning effort:"):
                effort = line.split(":", 1)[1].strip()
                if model_id and effort:
                    state.model = f"{model_id} ({effort})"
                continue
            continue
        marker = raw.rstrip()
        mode = state.codex_mode
        if mode == "tokens":
            digits = line.replace(",", "").replace(" ", "")
            if digits.isdigit():
                _lp_codex_tokens(state, int(digits))
            state.codex_mode = ""
            continue
        # a banner between blocks starts a new run; inside command output it is just output
        if mode in ("", "message") and line.startswith("OpenAI Codex"):
            _lp_codex_new_run(state)
            state.codex_mode = ""
            continue
        if mode == "user" and marker not in ("codex", "exec"):
            continue
        if _lp_codex_marker(state, marker, new_ts, plain_ts):
            continue
        if not line:
            continue
        new_ts.append(plain_ts)
        if mode == "agent":
            _lp_push_step(state, plain_ts, "text", "", line)
            state.codex_mode = "message"
        elif mode == "message":
            _lp_codex_extend(state, line)
        elif mode == "exec":
            _lp_push_step(state, plain_ts, "tool", "shell", line)
            state.tool_counts["shell"] = state.tool_counts.get("shell", 0) + 1
            state.codex_mode = "command"
        elif mode == "command":
            result = _LP_CODEX_RESULT_RE.match(raw)
            if result:
                _lp_codex_finish_command(state, plain_ts, result.group(1), result.group(2))
            else:
                _lp_codex_extend(state, line)
        elif mode == "patch":
            if raw.startswith("/"):
                _lp_push_step(state, plain_ts, "tool", "edit", line)
                state.tool_counts["edit"] = state.tool_counts.get("edit", 0) + 1
        elif mode == "":   # between blocks: only a column-0 error line counts
            if _LP_ERR_RE.match(raw) or _LP_CODEX_STREAM_RE.match(raw):
                _lp_push_step(state, plain_ts, "error", "", line)
                state.errors += 1
        # mode "output": command output, never a step


def _lp_codex_marker(
    state: LogState, marker: str, new_ts: list[float], plain_ts: float
) -> bool:
    """Handle a codex block marker; return False for any other line.

    A marker closes the block before it. Command output runs until the next
    marker or the result line that ends its command, so echoed file contents
    and command output never become steps.
    """
    if state.codex_mode == "command":
        _lp_codex_strip_cwd(state)
    if marker == "codex":
        state.codex_mode = "agent"
    elif marker == "exec":
        state.codex_mode = "exec"
    elif marker == "user":
        state.codex_mode = "user"
    elif marker == "tokens used":
        state.codex_mode = "tokens"
    elif marker == "apply patch":
        state.codex_mode = "patch"
    elif marker.startswith("hook:"):
        state.codex_mode = ""
    elif marker.startswith("web search:"):
        state.codex_mode = ""
        query = " ".join(marker[len("web search:"):].split())
        if query:
            _lp_push_step(state, plain_ts, "tool", "websearch", query)
            new_ts.append(plain_ts)
            state.tool_counts["search"] = state.tool_counts.get("search", 0) + 1
    else:
        return False
    return True


_LP_STEP_TEXT_MAX = 400  # steps render as one line; longer text is never shown


def _lp_codex_extend(state: LogState, line: str) -> None:
    """Append a continuation line to the step just opened (a multi-line message or command)."""
    last = state.steps[-1]
    if len(last.text) >= _LP_STEP_TEXT_MAX:
        return
    last.text = " ".join(f"{last.text} {line[:_LP_STEP_TEXT_MAX]}".split())[:_LP_STEP_TEXT_MAX]


def _lp_codex_strip_cwd(state: LogState) -> None:
    """Drop the trailing ` in <cwd>` codex appends to a command's last line."""
    last = state.steps[-1]
    last.text = _LP_CODEX_CWD_RE.sub("", last.text)


# exit 1 from these means "no match" or "differs", not a failure
_LP_CODEX_EXIT1_OK_RE = re.compile(r"^(?:\S*bash -lc\s+)?[\"']?\s*(?:grep|egrep|fgrep|rg|diff|cmp|test)\b")


def _lp_codex_dur(value: str | None) -> float | None:
    """The duration codex prints in its result line, in seconds; None when it is not one it knows.

    Codex has no start time for a command, so the result line's own figure is the only duration there is.
    """
    if not value:
        return None
    match = _LP_CODEX_DUR_RE.match(value.strip())
    if not match:
        return None
    amount = float(match.group(1))
    if match.group(2) == "ms":
        return amount / 1000.0
    return amount


def _lp_codex_finish_command(
    state: LogState, plain_ts: float, exit_code: str | None, dur_text: str | None = None
) -> None:
    """Close the command step; a non-zero exit is an error step (except a search finding nothing)."""
    _lp_codex_strip_cwd(state)
    cmd = state.steps[-1].text
    if exit_code == "1" and _LP_CODEX_EXIT1_OK_RE.match(cmd) and not re.search(r"[;&|]", cmd):
        exit_code = None
    state.steps[-1].outcome = STEP_OK if exit_code in (None, "0") else STEP_FAILED
    state.steps[-1].dur = _lp_codex_dur(dur_text)
    if exit_code not in (None, "0"):
        _lp_push_step(state, plain_ts, "error", "", f"command exited {exit_code}")
        state.errors += 1
    state.codex_mode = "output"


def _lp_codex_tokens(state: LogState, value: int) -> None:
    """Record one ``tokens used`` value: a run counts its last value, and the runs add up.

    A value lower than the one before it starts a new run, the same as a banner does.
    """
    store = _lp_private(state).setdefault("codex", {"done": 0, "last": None})
    if store["last"] is not None and value < store["last"]:
        _lp_codex_new_run(state)
    store["last"] = value
    state.tokens_in = store["done"] + value


def _lp_codex_new_run(state: LogState) -> None:
    """Close the current codex run: its last ``tokens used`` value joins the total."""
    store = _lp_private(state).setdefault("codex", {"done": 0, "last": None})
    if store["last"] is not None:
        store["done"] += store["last"]
        store["last"] = None


def _lp_clamp(ts: float, now: float) -> float:
    """Clamp an event time into ``[0, now]``; bad values become ``0.0``."""
    if not math.isfinite(ts) or ts < 0:
        return 0.0
    return min(ts, now)


def _lp_add_pulses(
    state: LogState,
    new_ts: list[float],
    plain_ts: float,
    timed: bool,
    now: float,
) -> None:
    if not new_ts:
        return
    if not timed:
        state.pulses.append((_lp_clamp(plain_ts, now), len(new_ts)))
    else:
        counts: dict[int, int] = {}
        for ts in new_ts:
            key = int(_lp_clamp(ts, now))
            counts[key] = counts.get(key, 0) + 1
        for key, count in counts.items():
            merged = False
            for index, (pts, pcount) in enumerate(state.pulses):
                if int(pts) == key:
                    state.pulses[index] = (pts, pcount + count)
                    merged = True
                    break
            if not merged:
                state.pulses.append((float(key), count))
    limit = ACT_BUCKETS * 4
    if len(state.pulses) > limit:
        state.pulses.sort(key=lambda pulse: pulse[0])
        del state.pulses[: len(state.pulses) - limit]



# ──────────────────── gitstate ────────────────────
"""Git work state of an idle or closed session's directory: uncommitted, unpushed, unmerged.

Read-only git calls, 2 s each, no prompts, no fetch. A result is reused for 30 s while HEAD, the
index and the branch ref keep their mtimes; one snapshot makes at most 64 git calls and takes at
most 1.5 s, and a worktree is read once however many stages sit in it.
"""



_GS_TTL_S = 30.0
_GS_TIMEOUT_S = 2.0
_GS_DEADLINE_S = 1.5     # wall-clock budget for one snapshot, however many stages it covers
_GS_MAX_CALLS = 64
_GS_STATES = frozenset({"idle", "closed"})
_GS_DEFAULT_BRANCHES = ("main", "master")
_GS_SKIP_DIRS = frozenset({".stage", ".sessions"})   # untracked tool state, never a session's own work


class _GsBudget(Exception):
    """The snapshot has no git calls or no wall-clock time left; the stage keeps its last answer."""


class _GsCalls:
    """The git calls one snapshot may still make, and the worktrees it has already read."""

    def __init__(self) -> None:
        self.left = _GS_MAX_CALLS
        self.deadline = time.monotonic() + _GS_DEADLINE_S
        self.shared: dict[str, _GsEntry] = {}


@dataclass
class _GsEntry:
    gitdir: str                  # "" when the path is not inside a worktree
    branch: str
    mtimes: tuple[float, ...]    # HEAD, index, branch ref at check time; () when not a worktree
    state: WorkState | None
    checked: float


_gs_cache: dict[str, _GsEntry] = {}


def work_state(path: str, now: float) -> WorkState | None:
    """Git state of the worktree at path; None when path is not inside one.

    A snapshot with nothing left to spend answers with the cached result, however old, rather than
    with nothing.
    """
    try:
        return _gs_state(path, now, _GsCalls())
    except _GsBudget:
        return _gs_cached(path)


def attach_work(stages: Iterable[Stage], now: float) -> None:
    """Set stage.work for idle and closed stages. Stalest cache entries go first, so every stage gets its turn."""
    todo = [(stage, _gs_dir(stage)) for stage in stages if stage.state in _GS_STATES]
    todo.sort(key=lambda item: _gs_checked(item[1]))
    calls = _GsCalls()
    for stage, path in todo:
        try:
            stage.work = _gs_state(path, now, calls)
        except _GsBudget:
            stage.work = _gs_cached(path)


def _gs_dir(stage: Stage) -> str:
    """The directory to check: the session's cwd, else its stage dir, else the stage path itself."""
    if stage.cwd:
        return stage.cwd
    if stage.dir:
        return stage.dir
    path = stage.path.removesuffix("/.stage")
    return path if os.path.isdir(path) else ""


def _gs_checked(path: str) -> float:
    entry = _gs_cache.get(path)
    return entry.checked if entry is not None else 0.0


def _gs_cached(path: str) -> WorkState | None:
    entry = _gs_cache.get(path)
    return entry.state if entry is not None else None


def _gs_state(path: str, now: float, calls: _GsCalls) -> WorkState | None:
    if not path:
        return None
    entry = _gs_cache.get(path)
    if entry is not None and now - entry.checked < _GS_TTL_S and entry.mtimes == _gs_mtimes(entry.gitdir, entry.branch):
        return entry.state
    entry = _gs_fresh(path, now, calls)
    _gs_cache[path] = entry
    return entry.state


def _gs_fresh(path: str, now: float, calls: _GsCalls) -> _GsEntry:
    rc, out = _gs_git(path, ["rev-parse", "--absolute-git-dir"], calls)
    gitdir = out.strip() if rc == 0 else ""
    if not gitdir:
        return _GsEntry("", "", (), None, now)
    first = calls.shared.get(gitdir)   # another stage of this snapshot already read this worktree
    if first is not None:
        return _GsEntry(gitdir, first.branch, first.mtimes, first.state, now)
    rc, out = _gs_git(path, ["rev-parse", "--abbrev-ref", "HEAD"], calls)
    branch = out.strip() if rc == 0 else ""
    rc, out = _gs_git(path, ["status", "--porcelain", "--untracked-files=normal"], calls)
    dirty = _gs_any_change(out) if rc == 0 else None
    rc, out = _gs_git(path, ["rev-list", "--count", "@{u}..HEAD"], calls)
    ahead = _gs_count(rc, out)
    unmerged = None
    default = _gs_default(path, calls) if branch else None
    if default and branch != default:
        rc, out = _gs_git(path, ["rev-list", "--count", f"{default}..HEAD"], calls)
        ahead_of_default = _gs_count(rc, out)
        unmerged = None if ahead_of_default is None else ahead_of_default > 0
    state = WorkState(branch=branch, dirty=dirty, ahead=ahead, unmerged=unmerged, checked=now)
    entry = _GsEntry(gitdir, branch, _gs_mtimes(gitdir, branch), state, now)
    calls.shared[gitdir] = entry
    return entry


def _gs_any_change(porcelain: str) -> bool:
    """Whether ``git status --porcelain`` (untracked files listed) shows any line but our own tool state."""
    for line in porcelain.splitlines():
        if not line.strip():
            continue
        if line.startswith("??") and _gs_tool_state(line[3:]):
            continue
        return True
    return False


def _gs_tool_state(path: str) -> bool:
    """True for an untracked path under a ``.stage`` or ``.sessions`` directory: status's own scratch, not work."""
    path = path.strip().strip('"')
    return any(part in _GS_SKIP_DIRS for part in path.replace("\\", "/").split("/"))


def _gs_default(path: str, calls: _GsCalls) -> str | None:
    refs = [f"refs/heads/{name}" for name in _GS_DEFAULT_BRANCHES]
    _, out = _gs_git(path, ["for-each-ref", "--format=%(refname:short)", *refs], calls)
    found = set(out.split())
    return next((name for name in _GS_DEFAULT_BRANCHES if name in found), None)


def _gs_count(rc: int, out: str) -> int | None:
    text = out.strip()
    return int(text) if rc == 0 and text.isdigit() else None


def _gs_git(path: str, args: list[str], calls: _GsCalls) -> tuple[int, str]:
    """One git call as (exit code, stdout); 1 with no output when git cannot run, is out of budget or times out."""
    if calls.left <= 0 or time.monotonic() >= calls.deadline:
        raise _GsBudget()
    calls.left -= 1
    env = {**os.environ, "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0"}
    try:
        done = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, errors="replace",
                              stdin=subprocess.DEVNULL, env=env, timeout=_GS_TIMEOUT_S, check=False)
    except (OSError, subprocess.SubprocessError):
        return 1, ""
    return done.returncode, done.stdout


def _gs_mtimes(gitdir: str, branch: str) -> tuple[float, ...]:
    """Mtimes of HEAD, the index and the branch ref: they move on commit, checkout and staging."""
    if not gitdir:
        return ()
    names = ("HEAD", "index", os.path.join("refs", "heads", branch))
    return tuple(_gs_mtime(os.path.join(gitdir, name)) for name in names)


def _gs_mtime(path: str) -> float:
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0.0



# ──────────────────── openclaw ────────────────────
"""OpenClaw (openclaw) per-turn data and session vitals, read from the agent database.

Read-only: every connection is ``file:...?mode=ro`` and is closed by the caller. A turn is one
``run_id`` of ``trajectory_runtime_events``; the last ``model.completed`` of a run is its outcome
and the earlier ones are retries. Turn history is unioned over every ``session_windows`` row of the
session key, not only its current window. A missing or unreadable database gives no turns and no
vitals; nothing here guesses a value.
"""



ASK_MAX = 120        # characters of the user message kept as the turn's ASK
ARGS_MAX = 80        # characters of a tool call's arguments kept as the gist
CALLS_MAX = 40       # tool calls kept per turn
TURNS_MAX = 200      # turns kept per session key
_ERROR_MAX = 200     # characters of an attempt's error kept

_EVENT_TYPES = ("prompt.submitted", "model.completed", "tool.call", "tool.result")
_LOCAL_PROVIDERS = frozenset({"llamacpp", "llama.cpp", "ollama", "lmstudio", "local"})
_VITALS_STATUS = {"running": "running", "done": "done", "failed": "failed", "killed": "killed",
                  "timeout": "timeout", "timed_out": "timeout", "error": "failed", "errored": "failed"}
# an argument that looks like a credential or an environment assignment is dropped, never shown
_SECRET_RE = re.compile(r"(?:token|secret|passw|api[_-]?key|authori[sz]ation)\w*\s*[:=]|bearer\s|"
                        r"sk-[A-Za-z0-9]{8}|xox[bp]-|ghp_|-----BEGIN", re.IGNORECASE)
_ENV_RE = re.compile(r"(?:^|[\s,{])(?:[A-Z][A-Z0-9_]{2,})=")


def _stamp(path: str) -> tuple[int, int] | None:
    """(mtime, size) of a file; None when it does not exist."""
    try:
        found = os.stat(path)
    except OSError:
        return None
    return (found.st_mtime_ns, found.st_size)


def _db_stamp(db_path: str) -> tuple | None:
    """The database's stamp together with its ``-wal``, so a write that only reached the WAL is seen."""
    main = _stamp(db_path)
    if main is None:
        return None
    return (main, _stamp(db_path + "-wal"))


def _float(value: object) -> float | None:
    """A number as a float, ignoring bools and non-numbers."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def _int(value: object) -> int | None:
    found = _float(value)
    return int(found) if found is not None else None


def _seconds(value: object) -> float | None:
    """Epoch seconds from a stored stamp in seconds or milliseconds; None when absent or not a number."""
    found = _float(value)
    if found is None or found <= 0:
        return None
    return found / 1000.0 if found > 100_000_000_000 else found


def _cost(provider: str, value: object) -> float | None:
    """USD when the provider is metered; None for a local model and for a missing or zero cost."""
    found = _float(value)
    if found is None or found <= 0 or provider.strip().lower() in _LOCAL_PROVIDERS:
        return None
    return found


def _line(text: object, limit: int) -> str:
    """One line of a possibly multi-line text, collapsed and cut to ``limit`` characters."""
    if not isinstance(text, str):
        return ""
    line = text.strip().split("\n", 1)[0].strip()
    line = " ".join(line.split())
    return line if len(line) <= limit else line[: max(1, limit - 1)].rstrip() + "…"


def _gist(args: object) -> str:
    """A one-line argument gist; "" for arguments that look like a credential or an env assignment."""
    if args is None:
        return ""
    if isinstance(args, str):
        text = args
    else:
        try:
            text = json.dumps(args, ensure_ascii=False, sort_keys=True)
        except (TypeError, ValueError):
            text = str(args)
    text = " ".join(text.split())
    if _SECRET_RE.search(text) or _ENV_RE.search(text):
        return ""
    return _line(text, ARGS_MAX)


def _message_text(content: object) -> str:
    """The text of one message's content (a string, or a list of typed parts)."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(part.get("text", "") for part in content
                        if isinstance(part, dict) and part.get("type") == "text")
    return ""


def _ask(data: dict, prompt: object) -> str:
    """The turn's user message: the final prompt, else the last user message of the snapshot, else the prompt sent."""
    final = data.get("finalPromptText")
    if isinstance(final, str) and final.strip():
        return _line(final, ASK_MAX)
    snapshot = data.get("messagesSnapshot")
    if isinstance(snapshot, list):
        for message in reversed(snapshot):
            if isinstance(message, dict) and message.get("role") == "user":
                text = _message_text(message.get("content"))
                if text.strip():
                    return _line(text, ASK_MAX)
    return _line(prompt, ASK_MAX)


def _outcome(data: dict) -> str:
    """A finished attempt's outcome: aborted, error or ok (running when the attempt is not there)."""
    if not data:
        return "running"
    if data.get("aborted") is True or data.get("stopReason") == "aborted":
        return "aborted"
    if data.get("stopReason") == "error" or data.get("promptError"):
        return "error"
    return "ok"


def _attempt_error(data: dict) -> str:
    """One line why an attempt failed; "" when it did not fail or the event carries no reason."""
    error = data.get("promptError")
    if isinstance(error, str) and error.strip():
        return _line(error, _ERROR_MAX)
    if data.get("stopReason") == "error":
        texts = data.get("assistantTexts")
        if isinstance(texts, list):
            for text in reversed(texts):
                if isinstance(text, str) and text.strip():
                    return _line(text, _ERROR_MAX)
    return ""


def _ok(value: object) -> bool | None:
    """A tool result's success flag; None when the event does not say."""
    if isinstance(value, bool):
        return value
    if value in (0, 1):
        return bool(value)
    return None


def _call_ts(event: dict, created: float | None) -> float:
    """A tool event's time: the stored stamp, else the event's own timestamp."""
    return created or _seconds(event.get("ts")) or 0.0


def _turn(run: dict) -> Turn | None:
    """One run as a Turn; None when it has no usable time."""
    completions: list[tuple[float, dict, dict]] = run["completions"]
    final = completions[-1] if completions else None
    asked = run["start"]          # 0.0 when the run carries no prompt.submitted event
    start = asked or (final[0] if final else 0.0)
    if start <= 0:
        return None
    data = final[2] if final else {}
    usage = data.get("usage") if isinstance(data.get("usage"), dict) else {}
    provider = str((final[1].get("provider") if final else "") or run["provider"] or "")
    model = str((final[1].get("modelId") if final else "") or run["model"] or "")
    cost = _cost(provider, (usage.get("cost") or {}).get("total") if isinstance(usage.get("cost"), dict) else None)
    end = (final[0] or None) if final else None
    errors = [_attempt_error(attempt[2]) for attempt in completions]
    error = next((text for text in errors if text), "")
    calls = [TurnTool(ts=call["ts"], name=call["name"], ok=call["ok"], dur=call["dur"], args=call["args"])
             for call in run["calls"]]
    tools = Counter(call.name for call in calls if call.name)
    return Turn(
        run_id=run["id"], start=start, end=end, ask=_ask(data, run["prompt"]),
        model=model, provider=provider,
        tokens_in=_int(usage.get("input")), tokens_out=_int(usage.get("output")),
        tokens_cache=_int(usage.get("cacheRead")), cost=cost,
        latency=end - asked if end is not None and asked and end >= asked else None,
        tools=dict(tools.most_common()), calls=calls[-CALLS_MAX:],
        attempts=len(completions) or 1, outcome=_outcome(data), error=error)


def _load_turns(conn: sqlite3.Connection, session_key: str) -> list[Turn]:
    """Every turn of a session key over all of its windows; [] when it has none."""
    try:
        ids = [row[0] for row in conn.execute(
            "SELECT session_id FROM session_windows WHERE session_key = ?", (session_key,)) if row[0]]
        current = conn.execute("SELECT current_session_id FROM session_nodes WHERE session_key = ?",
                               (session_key,)).fetchone()
    except sqlite3.Error:
        return []
    if current and current[0] and current[0] not in ids:
        ids.append(current[0])
    if not ids:
        return []
    marks = ",".join("?" * len(ids))
    kinds = ",".join("?" * len(_EVENT_TYPES))
    try:
        rows = conn.execute(
            f"SELECT session_id, seq, run_id, created_at, event_json FROM trajectory_runtime_events "
            f"WHERE session_id IN ({marks}) AND json_extract(event_json,'$.type') IN ({kinds}) "
            f"ORDER BY created_at, seq", (*ids, *_EVENT_TYPES)).fetchall()
    except sqlite3.Error:
        return []
    runs: dict[str, dict] = {}
    order: list[str] = []
    for session_id, seq, run_id, created_at, event_json in rows:
        try:
            event = json.loads(event_json)
        except (TypeError, ValueError):
            continue
        if not isinstance(event, dict):
            continue
        kind = event.get("type")
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        key = run_id if isinstance(run_id, str) and run_id else f"{session_id}:{seq}"
        run = runs.get(key)
        if run is None:
            run = runs[key] = {"id": key, "start": 0.0, "prompt": "", "model": "", "provider": "",
                               "completions": [], "calls": []}
            order.append(key)
        created = _seconds(created_at)
        if kind == "prompt.submitted":
            run["start"] = created or _seconds(event.get("ts")) or run["start"]
            run["prompt"] = data.get("prompt") if isinstance(data.get("prompt"), str) else run["prompt"]
            run["model"] = str(event.get("modelId") or run["model"] or "")
            run["provider"] = str(event.get("provider") or run["provider"] or "")
        elif kind == "model.completed":
            stamp = created or _seconds(event.get("ts")) or 0.0
            run["completions"].append((stamp, event, data))
        elif kind == "tool.call":
            name = str(data.get("name") or "")
            run["calls"].append({"ts": _call_ts(event, created), "name": name, "id": str(data.get("toolCallId") or ""),
                                 "args": _gist(data.get("args") if data.get("args") is not None
                                               else data.get("arguments")),
                                 "ok": None, "dur": None})
        elif kind == "tool.result":
            call_id = str(data.get("toolCallId") or "")
            for call in reversed(run["calls"]):
                if call["id"] == call_id and call["ok"] is None:
                    call["ok"] = _ok(data.get("success"))
                    result = _call_ts(event, created)
                    call["dur"] = result - call["ts"] if result >= call["ts"] else None
                    break
    turns: list[Turn] = []
    for key in order:
        run = runs[key]
        run["completions"].sort(key=lambda attempt: attempt[0])
        run["calls"].sort(key=lambda call: call["ts"])
        found = _turn(run)
        if found is not None:
            turns.append(found)
    turns.sort(key=lambda turn: turn.start)
    return turns[-TURNS_MAX:]


def _load_vitals(conn: sqlite3.Connection, session_key: str) -> Vitals | None:
    """The vitals strip of one session from its ``session_nodes`` row; None when there is no usable row."""
    try:
        row = conn.execute("SELECT entry_json, status FROM session_nodes WHERE session_key = ?",
                           (session_key,)).fetchone()
    except sqlite3.Error:
        return None
    if not row or not row[0]:
        return None
    try:
        entry = json.loads(row[0])
    except (TypeError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    budget = entry.get("contextBudgetStatus") if isinstance(entry.get("contextBudgetStatus"), dict) else {}
    provider = str(entry.get("modelProvider") or "")
    status = str(entry.get("status") or row[1] or "").strip().lower()
    return Vitals(
        model=str(entry.get("model") or ""), provider=provider,
        ctx_used=_int(budget.get("estimatedPromptTokens")), ctx_budget=_int(entry.get("contextTokens")),
        compactions=max(0, _int(entry.get("compactionCount")) or 0),
        cost=_cost(provider, entry.get("estimatedCostUsd")), runtime=_seconds_runtime(entry.get("runtimeMs")),
        status=_VITALS_STATUS.get(status, ""),
        last_error=_line(entry.get("lastRunError"), _ERROR_MAX))


def _seconds_runtime(value: object) -> float | None:
    """runtimeMs as seconds; None when absent."""
    found = _float(value)
    return found / 1000.0 if found is not None and found >= 0 else None


@dataclass
class _Data:
    """One generation of a database read, kept while the database and its WAL keep their stamp."""
    stamp: tuple = ()
    turns: dict[str, list[Turn]] = field(default_factory=dict)
    vitals: dict[str, Vitals | None] = field(default_factory=dict)


_cache_lock = threading.Lock()
_cache: dict[str, tuple[tuple, _Data]] = {}
_CACHE_MAX = 4          # agent databases remembered at once


def _data(db_path: str) -> _Data:
    """The cached read for this database, or a fresh empty generation when it changed."""
    stamp = _db_stamp(db_path) or ()
    if not stamp:
        return _Data()
    with _cache_lock:
        cached = _cache.get(db_path)
        if cached is not None and cached[0] == stamp:
            return cached[1]
    fresh = _Data(stamp)
    with _cache_lock:
        _cache[db_path] = (stamp, fresh)
        while len(_cache) > _CACHE_MAX:
            _cache.pop(next(iter(_cache)))
    return fresh


def clear_cache() -> None:
    """Forget every cached read (tests and a database that was replaced in place)."""
    with _cache_lock:
        _cache.clear()


class Reader:
    """One read-only connection for one snapshot; turns and vitals are cached per database stamp."""

    def __init__(self, db_path: str) -> None:
        self.db_path = os.path.expanduser(db_path)
        self._conn: sqlite3.Connection | None = None
        self._data = _data(self.db_path)

    def _connect(self) -> sqlite3.Connection | None:
        if self._conn is None:
            try:
                self._conn = sqlite3.connect("file:" + self.db_path + "?mode=ro", uri=True, timeout=1.0)
            except (OSError, sqlite3.Error):
                return None
        return self._conn

    def turns(self, session_key: str, since: float = 0.0, limit: int = TURNS_MAX) -> list[Turn]:
        """Turns of one session key, oldest first: at most ``limit`` newest ones, started at ``since`` or later."""
        if session_key not in self._data.turns:
            conn = self._connect()
            self._data.turns[session_key] = _load_turns(conn, session_key) if conn is not None else []
        turns = self._data.turns[session_key]
        if since > 0:
            turns = [turn for turn in turns if turn.start >= since]
        return turns[-limit:] if limit > 0 else []

    def vitals(self, session_key: str) -> Vitals | None:
        """The vitals strip of one session key; None when its row is missing or unreadable."""
        if session_key not in self._data.vitals:
            conn = self._connect()
            self._data.vitals[session_key] = _load_vitals(conn, session_key) if conn is not None else None
        return self._data.vitals[session_key]

    def close(self) -> None:
        conn, self._conn = self._conn, None
        if conn is not None:
            try:
                conn.close()
            except sqlite3.Error:
                pass

    def __enter__(self) -> Self:
        return self

    def __exit__(self, *_exc: object) -> None:
        self.close()


def read_turns(db_path: str, session_key: str, since: float = 0.0, limit: int = TURNS_MAX) -> list[Turn]:
    """Turns of one openclaw session; one read-only connection, closed before returning."""
    with Reader(db_path) as reader:
        return reader.turns(session_key, since, limit)


def read_vitals(db_path: str, session_key: str) -> Vitals | None:
    """The vitals of one openclaw session; one read-only connection, closed before returning."""
    with Reader(db_path) as reader:
        return reader.vitals(session_key)


def tool_pulses(turns: list[Turn], now: float) -> list[tuple[float, int]]:
    """(epoch second, calls) for the turns' tool calls inside the last ``TOOL_RING_S``, oldest first."""
    cutoff = now - TOOL_RING_S
    per_second: Counter[float] = Counter(float(int(call.ts)) for turn in turns for call in turn.calls
                                         if call.ts >= cutoff)
    return sorted(per_second.items())



# ──────────────────── codexread ────────────────────
"""Control center: Codex rollout reader. Reads one `rollout-*.jsonl` incrementally (offset cache like native.py) for what the
metrics reader does not give: the real first prompt, a readable name, tool calls with duration and errors, the system
prompt and the resume command. Imports model (and native helpers) only; collect calls it, never the reverse."""



# first user messages codex injects before the real prompt; skipped when looking for it (matched on the stripped start)
INJECTED_PREFIXES = ("# AGENTS.md instructions", "<environment_context>", "<user_instructions>", "<permissions instructions>")


@dataclass
class CodexSession:
    session_id: str = ""                 # session_meta payload.id
    path: str = ""
    name: str = ""                       # brief "Name:" line, else the first prompt line cut to 40 chars; never the UUID
    prompt: list[str] = field(default_factory=list)          # the real first user message, one entry per line
    system_prompt: list[str] = field(default_factory=list)   # session_meta base_instructions.text, one entry per line
    model: str = ""
    effort: str = ""
    cwd: str = ""
    started: float = 0.0                 # epoch seconds
    last_ts: float = 0.0                 # newest item time
    calls: list[CCCall] = field(default_factory=list)        # newest LAST, at most 200
    tokens_in: int | None = None
    tokens_out: int | None = None
    tokens_cache: int | None = None
    ctx_tokens: int | None = None
    ctx_window: int | None = None
    resume_cmd: str = ""                 # "codex resume <session_id>"; "" when the id is unknown


_CX_KEEP = 64                     # cached files per reader; the oldest is dropped past this
_CX_LINE_MAX = 16 * 1024 * 1024   # a rollout line longer than this is skipped, never parsed as a partial object
_CX_CALL_MAX = 200                # newest tool calls kept
_CX_PENDING_MAX = 500             # calls still waiting for their output
_CX_LINES_MAX = 400               # prompt and system-prompt lines kept
_CX_NAME_MAX = 40                 # a derived name is cut to this many chars
_CX_ARG_MAX = 80                  # the arguments gist is cut to this
_CX_ERR_MAX = 200                 # a failure's first line is cut to this
_CX_CALLS = frozenset({"function_call", "custom_tool_call", "local_shell_call"})
_CX_OUTPUTS = frozenset({"function_call_output", "custom_tool_call_output"})
# json keys that hold the thing a tool worked on, in the order a gist should prefer them
_CX_ARG_KEYS = ("cmd", "command", "cmdline", "path", "file_path", "file", "query", "message",
                "prompt", "target", "task_name", "name")
_CX_EXIT_RE = re.compile(r"(?im)^[ \t]*(?:exit code:[ \t]*|process exited with code[ \t]*)(-?\d+)")
_CX_FAIL_RE = re.compile(r"(?i)^(?:(?:script|command) failed\b|(?:failed|error|traceback|fatal|exception)\b[ \t]*:)")
_CX_HEADER_RE = re.compile(r"(?i)^(?:script (?:completed|failed)|wall time\b|exit code:|process exited with code|output:?$)")
# codex exec tools take javascript, e.g. `await tools.exec_command({cmd:"ls -la"})`; the cmd/path key comes out
_CX_KV_RE = re.compile(r"""(?i)\b(?:cmd|command|path|file_path)\b["']?[ \t]*[:=][ \t]*(?:"([^"\n]*)"|'([^'\n]*)'|`([^`\n]*)`)""")
_CX_NAME_RE = re.compile(r"(?i)^[ \t]*name:[ \t]*(\S.*?)[ \t]*$")
_CX_UUID_RE = re.compile(r"(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
_CX_HEADING_RE = re.compile(r"^#{1,6}[ \t]*")

_crd_cache: dict[str, dict] = {}   # path -> {"offset", "ino", "size", "mtime", "sess", "first", "valid", ...}


def read_codex_session(path: str, now: float | None = None) -> CodexSession | None:
    """Parse the rollout at `path` (incrementally on repeat calls). None when the file is missing or not a rollout."""
    # `now` belongs to the reader signature; this parse depends on the file's bytes only.
    key = str(path)
    target = Path(key)
    state = _crd_cache.get(key)
    if state is None:
        state = _crd_state(key)
    result = _crd_read(state, target)
    if result == "reset":
        state = _crd_state(key)
        result = _crd_read(state, target)
    if result != "ok":
        return None
    _crd_remember(key, state)
    if not state["first"] and state["valid"]:
        sess: CodexSession = state["sess"]
        # a copy: the cached parse must survive anything a caller does to what it was handed
        return replace(sess, prompt=list(sess.prompt), system_prompt=list(sess.system_prompt),
                       calls=[replace(call) for call in sess.calls])
    return None


def _crd_state(path: str) -> dict:
    """A fresh incremental parse of one rollout file."""
    return {"offset": 0, "ino": 0, "size": 0, "mtime": 0, "sess": CodexSession(path=path),
            "first": True, "valid": True, "prompt_seen": False, "pending": {}}


def _crd_remember(key: str, state: dict) -> None:
    """Cache one parse, dropping the file cached longest ago past _CX_KEEP (native.py read_codex_metrics does the same)."""
    _crd_cache[key] = state
    while len(_crd_cache) > _CX_KEEP:
        _crd_cache.pop(next(iter(_crd_cache)))


def _crd_read(state: dict, target: Path) -> str:
    """Read the new bytes of ``target`` into ``state``: "ok", "reset" (rewritten or shortened) or "gone"."""
    try:
        stat = target.stat()
    except OSError:
        return "gone"
    if state["size"] and (state["ino"] != stat.st_ino or stat.st_size < state["offset"]
                          or (stat.st_size == state["size"] and stat.st_mtime_ns != state["mtime"])):
        return "reset"
    try:
        with target.open("rb") as stream:
            stream.seek(state["offset"])
            for begin, raw, complete in _nv_lines(stream, _CX_LINE_MAX):
                if raw is None or not raw.strip():
                    continue
                try:
                    obj = json.loads(raw)
                except (ValueError, UnicodeError, RecursionError):
                    if complete:
                        continue            # malformed line: skip it, keep parsing
                    stream.seek(begin)      # still being appended: retry the whole line next read
                    break
                if not isinstance(obj, dict):
                    if complete:
                        continue
                    stream.seek(begin)
                    break
                _crd_item(state, obj)
                if not state["valid"]:      # not a rollout: no line after the first one can matter
                    stream.seek(stat.st_size)
                    break
            state["offset"] = stream.tell()
    except OSError:
        return "gone"
    state.update(ino=stat.st_ino, size=stat.st_size, mtime=stat.st_mtime_ns)
    return "ok"


def _crd_kind(value: object) -> str:
    """A record's `type` when it is a string: a malformed value (list, dict, number, null) never reaches a set lookup."""
    return value if isinstance(value, str) else ""


def _crd_content(value: object) -> object:
    """A message body with any part whose `type` is not a string dropped: _nv_text's set lookup needs hashable values."""
    if not isinstance(value, list):
        return value
    return [part for part in value if not isinstance(part, dict) or isinstance(part.get("type"), str)]


def _crd_item(state: dict, obj: dict) -> None:
    """One parsed rollout line into the partial state."""
    if not state["valid"]:
        return
    typ = _crd_kind(obj.get("type"))
    payload = obj.get("payload")
    payload = payload if isinstance(payload, dict) else {}
    sess: CodexSession = state["sess"]
    ts = _nv_time(obj.get("timestamp"))
    sess.last_ts = max(sess.last_ts, ts)
    if state["first"]:
        state["first"] = False
        if typ != "session_meta" or not isinstance(obj.get("payload"), dict):
            state["valid"] = False       # this file is not a rollout
            return
        _crd_meta(sess, payload, ts)
        return
    if typ == "turn_context":
        _crd_turn(sess, payload)
    elif typ == "response_item":
        _crd_response(state, payload, ts)
    elif typ == "event_msg":
        if _crd_kind(payload.get("type")) == "token_count":
            _crd_tokens(sess, payload)
    elif typ == "token_usage_record":     # the same counters, written by newer builds beside token_count
        counts = _nv_codex_counts(payload.get("thread_token_usage") or payload.get("usage"))
        if counts is not None:
            sess.tokens_in, sess.tokens_out, sess.tokens_cache = counts


def _crd_meta(sess: CodexSession, payload: dict, ts: float) -> None:
    """session_meta: the id, working directory, start time, system prompt and resume command."""
    sid = payload.get("id") or payload.get("session_id")
    sess.session_id = sid.strip() if isinstance(sid, str) else ""
    sess.name = _crd_fallback_name(sess.session_id)
    cwd = payload.get("cwd")
    sess.cwd = cwd.strip() if isinstance(cwd, str) else ""
    sess.started = _nv_time(payload.get("timestamp")) or ts
    base = payload.get("base_instructions")
    sess.system_prompt = _crd_lines(base.get("text") if isinstance(base, dict) else base)
    sess.resume_cmd = f"codex resume {sess.session_id}" if sess.session_id else ""


def _crd_lines(value: object) -> list[str]:
    """A text field as lines, at most _CX_LINES_MAX of them."""
    return value.splitlines()[:_CX_LINES_MAX] if isinstance(value, str) else []


def _crd_turn(sess: CodexSession, payload: dict) -> None:
    """turn_context: the model and its reasoning effort (older builds keep the effort under collaboration_mode)."""
    model = payload.get("model")
    if isinstance(model, str) and model.strip():
        sess.model = model.strip()
    effort = payload.get("effort", payload.get("reasoning_effort"))
    if not (isinstance(effort, str) and effort.strip()):
        mode = payload.get("collaboration_mode")
        settings = mode.get("settings") if isinstance(mode, dict) else None
        effort = settings.get("reasoning_effort") if isinstance(settings, dict) else None
    if isinstance(effort, str) and effort.strip():
        sess.effort = effort.strip()


def _crd_tokens(sess: CodexSession, payload: dict) -> None:
    """event_msg token_count: the cumulative thread counters, the context in use and the model's window."""
    info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
    counts = _nv_codex_counts(info.get("total_token_usage"))
    if counts is not None:
        sess.tokens_in, sess.tokens_out, sess.tokens_cache = counts
    last = _nv_codex_counts(info.get("last_token_usage"))
    if last is not None and last[0] > 0:
        sess.ctx_tokens = last[0]
    window = _nv_codex_window(payload)
    if window is not None:
        sess.ctx_window = window


def _crd_response(state: dict, payload: dict, ts: float) -> None:
    """One response_item: a user message, a tool call or the output that closes a call."""
    ptype = _crd_kind(payload.get("type"))
    if ptype == "message":
        _crd_prompt(state, payload)
    elif ptype in _CX_CALLS:
        _crd_call(state, payload, ts)
    elif ptype in _CX_OUTPUTS:
        _crd_output(state, payload, ts)


def _crd_prompt(state: dict, payload: dict) -> None:
    """Keep the first user message that is not an injected instruction block: the session's real prompt."""
    sess: CodexSession = state["sess"]
    if state["prompt_seen"] or payload.get("role") != "user":
        return
    text = _nv_text(_crd_content(payload.get("content")))
    stripped = text.strip()
    if not stripped or stripped.startswith(INJECTED_PREFIXES):
        return
    sess.prompt = _crd_lines(text)
    sess.name = _crd_name(sess.prompt, sess.session_id)
    state["prompt_seen"] = True


def _crd_name(prompt: list[str], session_id: str) -> str:
    """The brief's ``Name:`` line, else the first prompt line without heading marks; the id is never the name."""
    for line in prompt:
        match = _CX_NAME_RE.match(line)
        if match is not None:
            value = " ".join(match.group(1).split())
            if value and not _CX_UUID_RE.match(value):
                return value[:_CX_NAME_MAX]
    first = next((line.strip() for line in prompt if line.strip()), "")
    if not first:
        return ""
    value = " ".join(_CX_HEADING_RE.sub("", first).split())[:_CX_NAME_MAX]
    return _crd_fallback_name(session_id) if not value or value == session_id or _CX_UUID_RE.match(value) else value


def _crd_fallback_name(session_id: str) -> str:
    """A Codex row's short, stable name until its real prompt is available."""
    return f"codex {session_id[:8]}" if session_id else "codex"


def _crd_call(state: dict, payload: dict, ts: float) -> None:
    """A tool call: its name, a one-line gist of the arguments, and a slot for the output to fill in."""
    sess: CodexSession = state["sess"]
    raw_tool = payload.get("name")
    tool = raw_tool.strip() if isinstance(raw_tool, str) and raw_tool.strip() else "shell"
    raw = payload.get("input")
    if not isinstance(raw, str):
        raw = payload.get("arguments")
    call = CCCall(ts=ts, tool=tool, arg=_crd_gist(raw if isinstance(raw, str) else ""))
    sess.calls.append(call)
    if len(sess.calls) > _CX_CALL_MAX:
        del sess.calls[:-_CX_CALL_MAX]
    call_id = payload.get("call_id")
    if isinstance(call_id, str) and call_id:
        pending = state["pending"]
        pending[call_id] = call
        while len(pending) > _CX_PENDING_MAX:
            pending.pop(next(iter(pending)))


def _crd_output(state: dict, payload: dict, ts: float) -> None:
    """The output of a call: pair it by call_id, then its duration, outcome and error line."""
    call_id = payload.get("call_id")
    if not isinstance(call_id, str) or not call_id:
        return
    call = state["pending"].pop(call_id, None)
    if call is None:
        return
    call.outcome, call.err = _crd_verdict(_nv_text(_crd_content(payload.get("output"))))
    if ts and call.ts and ts >= call.ts:
        call.dur = ts - call.ts


def _crd_verdict(text: str) -> tuple[str, str]:
    """(outcome, err) of one tool output: a non-zero exit code or an error marker fails it, ok otherwise."""
    stripped = text.strip()
    if not stripped:
        return "ok", ""
    data = _crd_json(stripped)
    if isinstance(data, dict):
        code = data.get("exit_code")
        if isinstance(code, int) and not isinstance(code, bool):
            if code != 0:
                return "failed", _crd_err(data.get("output", stripped))
            return "ok", ""
        if data.get("timed_out") is True or data.get("isError") is True:
            return "failed", _crd_err(data.get("output", stripped))
        return "ok", ""
    for value in _CX_EXIT_RE.findall(stripped):
        if int(value) != 0:
            return "failed", _crd_err(stripped)
    if _CX_FAIL_RE.match(stripped):
        return "failed", _crd_err(stripped)
    return "ok", ""


def _crd_err(value: object) -> str:
    """The first line of a failed call's own output, past the ``Script completed``/``Wall time``/``Output:`` header."""
    lines = [line.strip() for line in _nv_text(value).splitlines()]
    for index, line in enumerate(lines):
        if line.rstrip(":").strip().lower() == "output":
            lines = lines[index + 1:]
            break
    for line in lines:
        if line and not _CX_HEADER_RE.match(line):
            return line[:_CX_ERR_MAX]
    return ""


def _crd_gist(raw: str) -> str:
    """One line for the tools table: the shell command or path when the arguments name one, else their head."""
    text = raw.strip()
    if not text:
        return ""
    return " ".join((_crd_arg_value(text) or text).split())[:_CX_ARG_MAX]


def _crd_arg_value(text: str) -> str:
    """The command or path inside a call's arguments (json or codex's javascript), "" when they name none."""
    data = _crd_json(text)
    if isinstance(data, dict):
        for key in _CX_ARG_KEYS:
            value = data.get(key)
            if isinstance(value, (list, tuple)):
                value = " ".join(str(part) for part in value)
            if isinstance(value, str) and value.strip():
                return value
        return ""
    match = _CX_KV_RE.search(text)
    if match is None:
        return ""
    return next((part for part in match.groups() if part is not None), "")


def _crd_json(text: str) -> object:
    """A tool payload that is one json object; None for text, javascript or a malformed body."""
    if not text.startswith("{"):
        return None
    try:
        return json.loads(text)
    except (ValueError, RecursionError):
        return None



# ──────────────────── events ────────────────────
"""Control center: the event model. Builds `CCEvent` lines from data already in the model (steps, calls, turns, doing),
at event time, newest LAST. Reads files only in `log_tail`. Imports model only."""



ROW_LIMIT = 200      # events kept per row
FLEET_LIMIT = 500    # events kept in the merged tail

_CX_TAIL_BYTES = 256 * 1024   # log_tail reads at most this much of the file's end
_CX_DUP_S = 2.0               # a step and a call this close are the same event
_STEP_KINDS = {"tool": "tool", "text": "msg", "error": "err"}
_CX_ANSI_RE = re.compile(
    r"\x1b\[[0-9;?]*[ -/]*[@-~]"              # CSI, e.g. colours
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"     # OSC, e.g. window titles
    r"|\x1b[@-Z\\-_]"                         # other two-byte escapes
)


def row_key(stage: Stage, worker: Worker | None = None) -> str:
    """The key an event carries: "<stage path>|<worker name>"; the lead row's worker part is empty."""
    return f"{stage.path}|{worker.name if worker is not None else ''}"


def row_events(stage: Stage, worker: Worker | None = None, limit: int = ROW_LIMIT) -> list[CCEvent]:
    """Events of one row, oldest first, at most `limit` (the newest ones). A worker row reads worker.log.steps and
    worker.calls; the lead row reads stage.calls, stage.doing and stage.turns."""
    events = _cev_lead_events(stage) if worker is None else _cev_worker_events(stage, worker)
    return _cev_cap(events, limit)


def fleet_events(gs: GlobalSnapshot, limit: int = FLEET_LIMIT) -> list[CCEvent]:
    """The merged tail over every stage and worker in `gs`, oldest first, at most `limit` (the newest ones)."""
    out: list[CCEvent] = []
    for stage in gs.stages:
        out.extend(row_events(stage))
        for worker in stage.snap.workers:
            out.extend(row_events(stage, worker))
    return _cev_cap(out, limit)


def log_tail(path: str, n: int = ROW_LIMIT) -> list[str]:
    """The last `n` lines of the file at `path`, ANSI stripped, long lines kept whole; [] when unreadable. Reads only the file's tail."""
    if n <= 0:
        return []
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            start = max(0, size - _CX_TAIL_BYTES)
            handle.seek(start)
            data = handle.read()
    except (OSError, ValueError):
        return []
    if not data:
        return []
    text = data.decode("utf-8", "replace")
    if start > 0:
        cut = text.find("\n")
        if cut < 0:              # the tail holds no complete line
            return []
        text = text[cut + 1:]    # the first line may be a fragment: drop it
    return [_CX_ANSI_RE.sub("", line) for line in text.splitlines()][-n:]


def _cev_one_line(text: str) -> str:
    """``text`` with every run of whitespace (newlines included) folded to one space."""
    return " ".join(text.split())


def _cev_cap(events: list[CCEvent], limit: int) -> list[CCEvent]:
    """``events`` sorted by time (stable), cut to the newest ``limit``."""
    if limit <= 0:
        return []
    events.sort(key=lambda ev: ev.ts)
    return events[-limit:]


def _cev_step_event(step: Step, key: str) -> CCEvent:
    """One log step: a tool call, a text line or an error. Tool lines carry their tool name in front."""
    kind = _STEP_KINDS.get(step.kind, "msg")
    text = f"{step.tool} {step.text}" if kind == "tool" else step.text
    return CCEvent(step.ts, key, kind, _cev_one_line(text))


def _cev_call_event(call: CCCall, key: str) -> CCEvent:
    """One transcript call: "tool <arg>"; a failed call is an err line carrying its error."""
    text = _cev_one_line(f"{call.tool} {call.arg}")
    if call.outcome == "failed":
        return CCEvent(call.ts, key, "err", _cev_one_line(call.err) or text)
    return CCEvent(call.ts, key, "tool", text)


def _cev_step_in_call(step: Step, call: CCCall) -> bool:
    """True when ``step`` and ``call`` report the same tool call (same tool, at most 2 s apart)."""
    return (step.kind == "tool" and abs(step.ts - call.ts) <= _CX_DUP_S
            and _cev_one_line(step.tool).lower() == _cev_one_line(call.tool).lower())


def _cev_worker_events(stage: Stage, worker: Worker) -> list[CCEvent]:
    """A worker row: its log steps and calls, then a state line when it has ended."""
    key = row_key(stage, worker)
    calls = list(worker.calls)
    timed = [step for step in worker.log.steps if step.ts]
    untimed = [step for step in worker.log.steps if not step.ts]
    out: list[CCEvent] = []
    used: set[int] = set()
    for step in timed:
        match = next((i for i, call in enumerate(calls) if i not in used and _cev_step_in_call(step, call)), None)
        if match is not None:
            used.add(match)      # the call says the same thing: keep the call only
            continue
        out.append(_cev_step_event(step, key))
    out.extend(_cev_call_event(call, key) for call in calls)
    if worker.end is not None:
        text = worker.state.upper()
        if worker.failure:
            text = f"{text} · {worker.failure}"
        out.append(CCEvent(worker.end, key, "state", _cev_one_line(text)))
    if untimed and not timed and not any(call.ts for call in calls):
        out = [_cev_step_event(step, key) for step in untimed] + out   # a log with no times at all: show them first
    return out


def _cev_turn_event(turn: Turn, key: str) -> list[CCEvent]:
    """A turn's msg line (ask and model) and, when it failed, its err line."""
    when = turn.end if turn.end is not None else turn.start
    ask = _cev_one_line(turn.ask)
    text = " · ".join(part for part in (ask, turn.model.strip()) if part) or "turn"
    out = [CCEvent(when, key, "msg", _cev_one_line(text))]
    if turn.outcome in ("error", "aborted"):
        out.append(CCEvent(when, key, "err", _cev_one_line(turn.error) or turn.outcome))
    return out


def _cev_doing_is_call(ts: float, text: str, calls: list[CCCall]) -> bool:
    """True when a doing entry repeats a call within 2 s with the same last word ("Edit render.py" / "edit render.py")."""
    words = _cev_one_line(text).split()
    if not words:
        return False
    tail = words[-1].lower()
    for call in calls:
        if abs(call.ts - ts) <= _CX_DUP_S and _cev_one_line(f"{call.tool} {call.arg}").lower().split()[-1:] == [tail]:
            return True
    return False


def _cev_lead_events(stage: Stage) -> list[CCEvent]:
    """The lead row: its calls, its latest doing actions and its turns."""
    key = row_key(stage)
    out = [_cev_call_event(call, key) for call in stage.calls]
    for ts, text in stage.doing:
        if not _cev_doing_is_call(ts, text, stage.calls):
            out.append(CCEvent(ts, key, "tool", _cev_one_line(text)))
    for turn in stage.turns:
        out.extend(_cev_turn_event(turn, key))
    return out



